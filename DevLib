local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end

local function bind(list, signal, fn)
	local c = signal:Connect(fn)
	table.insert(list, c)
	return c
end

local function tween(obj, duration, props, style)
	local speed = math.max(Library.Settings.AnimSpeed, 0.05)
	local info = TweenInfo.new(duration / speed, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function new(className, props)
	local obj = Instance.new(className)
	if obj:IsA("GuiObject") then
		obj.BorderSizePixel = 0
	end
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function corner(obj, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = obj })
end

local function stroke(obj, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		Parent = obj,
	})
end

local function iconOf(name)
	if name == nil then
		return ""
	end
	return Icons[name] or ""
end

local function iconImage(parent, name, props)
	local data = {
		BackgroundTransparency = 1,
		Image = iconOf(name),
		ImageColor3 = GOLD,
		Size = UDim2.fromOffset(16, 16),
		Parent = parent,
	}
	for k, v in pairs(props or {}) do
		data[k] = v
	end
	return new("ImageLabel", data)
end

local function hoverTween(conns, button, normal, over)
	bind(conns, button.MouseEnter, function()
		tween(button, FAST, { BackgroundColor3 = over })
	end)
	bind(conns, button.MouseLeave, function()
		tween(button, FAST, { BackgroundColor3 = normal })
	end)
end

local function invoke(name, callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[GodLib] " .. name .. " callback error: " .. tostring(err))
	end
end

local function colorAt(t)
	if t < 0.5 then
		return FIRE_YELLOW:Lerp(FIRE_ORANGE, t * 2)
	end
	return FIRE_ORANGE:Lerp(FIRE_RED, (t - 0.5) * 2)
end

local function glowBorder(parent, radius, thickness, zIndex)
	local frame = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = zIndex or 1,
		Parent = parent,
	})
	corner(frame, radius)
	local s = stroke(frame, GOLD, thickness, 0)
	local g = new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, GOLD),
			ColorSequenceKeypoint.new(0.25, CREAM),
			ColorSequenceKeypoint.new(0.5, ORANGE),
			ColorSequenceKeypoint.new(0.75, CREAM),
			ColorSequenceKeypoint.new(1, GOLD),
		}),
		Parent = s,
	})
	TweenService:Create(g, TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
	TweenService:Create(s, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.5,
		Thickness = thickness + 0.8,
	}):Play()
	return frame
end

local function makeDraggable(handle, target, scale, onTap, conns)
	local dragging, moved = false, false
	local dragStart, startPos
	bind(conns, handle.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = target.Position
		end
	end)
	bind(conns, UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 4 then
				moved = true
			end
			local s = scale and scale.Scale or 1
			delta = delta / s
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	bind(conns, UserInputService.InputEnded, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			if not moved and onTap then
				onTap()
			end
		end
	end)
end

local function getGuiParent()
	if typeof(gethui) == "function" then
		local ok, result = pcall(gethui)
		if ok and result then
			return result
		end
	end
	local ok, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok and core then
		return core
	end
	return PlayerGui
end

local function ensureGui()
	if Library.Gui and Library.Gui.Parent then
		return Library.Gui
	end
	for _, container in ipairs({ getGuiParent(), PlayerGui }) do
		local old = container:FindFirstChild("GodLib")
		if old then
			old:Destroy()
		end
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "GodLib"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 1000
	local ok = pcall(function()
		gui.Parent = getGuiParent()
	end)
	if not ok or not gui.Parent then
		gui.Parent = PlayerGui
	end
	Library.Gui = gui
	Library.Overlay = new("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	return gui
end

local function raiseLayers()
	if Library.Overlay then
		Library.Overlay.Parent = nil
		Library.Overlay.Parent = Library.Gui
	end
	if Library.NotifyHolder then
		Library.NotifyHolder.Parent = nil
		Library.NotifyHolder.Parent = Library.Gui
	end
end

