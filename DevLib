function Window:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	for _, c in ipairs(self.Conns) do
		c:Disconnect()
	end
	table.clear(self.Conns)
	for _, o in ipairs(table.clone(self.Components)) do
		o:Destroy()
	end
	table.clear(self.Components)
	if self.Frame then
		self.Frame:Destroy()
	end
	if self.FloatButton then
		self.FloatButton:Destroy()
	end
	for i, w in ipairs(Library.Windows) do
		if w == self then
			table.remove(Library.Windows, i)
			break
		end
	end
	if #Library.Windows == 0 then
		Library:Destroy()
	end
end

local function setBackdrop(index)
	Library.BgIndex = index
	for node in pairs(Library.BgNodes) do
		if not node.Parent then
			Library.BgNodes[node] = nil
		end
	end
	for node in pairs(Library.BgNodes) do
		tween(node, 0.5, { ImageTransparency = 1 })
	end
	task.delay(0.5 / math.max(Library.Settings.AnimSpeed, 0.05), function()
		for node, alpha in pairs(Library.BgNodes) do
			if node.Parent then
				node.Image = BACKGROUNDS[index]
				tween(node, 0.5, { ImageTransparency = alpha })
			end
		end
	end)
end

local function spawnParticle(layer, x, y, ember)
	local w = ember and math.random(2, 3) or math.random(4, 6)
	local h = ember and w or math.random(7, 11)
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = FIRE_YELLOW,
		Parent = layer,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = frame })
	table.insert(Library.Particles, {
		frame = frame,
		x = x,
		y = y,
		w = w,
		h = h,
		age = 0,
		life = ember and math.random(80, 130) / 100 or math.random(50, 95) / 100,
		rise = ember and math.random(34, 52) or math.random(14, 26),
		amp = ember and math.random(3, 6) or math.random(1, 3),
		freq = math.random(30, 60) / 10,
		phase = math.random() * math.pi * 2,
	})
end

local function updateParticles(dt)
	local list = Library.Particles
	for i = #list, 1, -1 do
		local p = list[i]
		p.age += dt
		local t = p.age / p.life
		if t >= 1 or not p.frame.Parent then
			p.frame:Destroy()
			table.remove(list, i)
		else
			local ease = 1 - (1 - t) ^ 2
			local sway = math.sin(p.age * p.freq + p.phase) * p.amp * t
			local flick = 1 + 0.1 * math.sin(p.age * 20 + p.phase)
			p.frame.Position = UDim2.fromOffset(p.x + sway, p.y - p.rise * ease)
			p.frame.Size = UDim2.fromOffset(
				math.max(1, math.floor(p.w * (1 - 0.5 * t) * flick + 0.5)),
				math.max(1, math.floor(p.h * (1 - 0.3 * t) + 0.5))
			)
			p.frame.BackgroundColor3 = colorAt(t)
			p.frame.BackgroundTransparency = math.clamp(t * t, 0, 1)
		end
	end
end

local loopsStarted = false
local function startLoops()
	if loopsStarted then
		return
	end
	loopsStarted = true
	connect(RunService.Heartbeat, updateParticles)
	task.spawn(function()
		while not Library.Destroyed do
			task.wait(BG_INTERVAL)
			if Library.Destroyed then
				break
			end
			setBackdrop(Library.BgIndex % #BACKGROUNDS + 1)
		end
	end)
end

