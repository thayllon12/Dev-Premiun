function Section:AddMultiDropdown(opts)
	opts = opts or {}
	local options = opts.Options or {}
	local row = makeRow(self, opts)
	local obj = makeComponent(self, row, opts.Flag)
	local selected = {}
	if type(opts.Default) == "table" then
		for _, v in ipairs(opts.Default) do
			selected[v] = true
		end
	end
	local function listOf()
		local out = {}
		for _, o in ipairs(options) do
			if selected[o] then
				table.insert(out, o)
			end
		end
		return out
	end
	local function summary()
		local list = listOf()
		if #list == 0 then
			return "None"
		end
		return table.concat(list, ", ")
	end
	local button = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(114, 26),
		BackgroundColor3 = INNER,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	corner(button, 6)
	stroke(button, GOLD, 1, 0.45)
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -34, 1, 0),
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = CREAM,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = summary(),
		Parent = button,
	})
	local chevron = iconImage(button, "chevron-down", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(10, 10),
	})
	hoverTween(obj.Conns, button, INNER, HOVER)

	local function commit()
		local before = label.Text
		label.Text = summary()
		setFlag(obj, listOf())
		if label.Text ~= before then
			invoke("MultiDropdown", opts.Callback, listOf())
		end
	end

	bind(obj.Conns, button.MouseButton1Click, function()
		local api = openMenu(obj.Window, button, 140, #options, function(scroll, menuApi)
			new("UIListLayout", {
				Padding = UDim.new(0, menuApi.px(2)),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = scroll,
			})
			new("UIPadding", {
				PaddingTop = UDim.new(0, menuApi.px(5)),
				PaddingBottom = UDim.new(0, menuApi.px(5)),
				PaddingLeft = UDim.new(0, menuApi.px(5)),
				PaddingRight = UDim.new(0, menuApi.px(5)),
				Parent = scroll,
			})
			for i, opt in ipairs(options) do
				local item = new("TextButton", {
					LayoutOrder = i,
					Size = UDim2.new(1, 0, 0, menuApi.itemH),
					BackgroundColor3 = GOLD,
					BackgroundTransparency = selected[opt] and 0.8 or 1,
					AutoButtonColor = false,
					Font = Enum.Font.GothamMedium,
					TextSize = menuApi.px(12),
					TextColor3 = selected[opt] and GOLD or CREAM,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Text = tostring(opt),
					Parent = scroll,
				})
				corner(item, menuApi.px(5))
				new("UIPadding", {
					PaddingLeft = UDim.new(0, menuApi.px(9)),
					PaddingRight = UDim.new(0, menuApi.px(22)),
					Parent = item,
				})
				local check = iconImage(item, "check", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -menuApi.px(7), 0.5, 0),
					Size = UDim2.fromOffset(menuApi.px(11), menuApi.px(11)),
					Visible = selected[opt] == true,
				})
				item.MouseEnter:Connect(function()
					tween(item, FAST, { BackgroundTransparency = selected[opt] and 0.65 or 0.85 })
				end)
				item.MouseLeave:Connect(function()
					tween(item, FAST, { BackgroundTransparency = selected[opt] and 0.8 or 1 })
				end)
				item.MouseButton1Click:Connect(function()
					if selected[opt] then
						selected[opt] = nil
					else
						selected[opt] = true
					end
					local on = selected[opt] == true
					tween(item, FAST, { BackgroundTransparency = on and 0.8 or 1 })
					item.TextColor3 = on and GOLD or CREAM
					check.Visible = on
					commit()
				end)
			end
		end)
		tween(chevron, FAST, { Rotation = 180 })
		api.OnClose = function()
			tween(chevron, FAST, { Rotation = 0 })
		end
	end)

	function obj:SetValue(list, silent)
		local before = summary()
		selected = {}
		for _, v in ipairs(list or {}) do
			selected[v] = true
		end
		label.Text = summary()
		setFlag(obj, listOf())
		if not silent and label.Text ~= before then
			invoke("MultiDropdown", opts.Callback, listOf())
		end
	end
	function obj:GetValue()
		return listOf()
	end
	setFlag(obj, listOf())
	return obj
end

