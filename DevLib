	win:Fit(false)
	table.insert(Library.Windows, win)
	raiseLayers()
	return win
end

function Library:Destroy()
	if Library.Destroyed then
		return
	end
	Library.Destroyed = true
	Library.ClosePopup()
	for _, w in ipairs(table.clone(Library.Windows)) do
		w:Destroy()
	end
	for _, c in ipairs(Library.Connections) do
		c:Disconnect()
	end
	table.clear(Library.Connections)
	for _, p in ipairs(Library.Particles) do
		if p.frame then
			p.frame:Destroy()
		end
	end
	table.clear(Library.Particles)
	table.clear(Library.BgNodes)
	table.clear(Library.Flags)
	table.clear(Library.Windows)
	if Library.Gui then
		Library.Gui:Destroy()
	end
	Library.Gui = nil
	Library.Overlay = nil
	Library.NotifyHolder = nil
	notifyHolder = nil
	loopsStarted = false
	cameraConnected = false
end

return Library
