local function openMenu(win, anchor, width, itemCount, build)
	Library.ClosePopup()
	local k = win.Scale.Scale
	local function px(n)
		return math.max(1, math.floor(n * k + 0.5))
	end
	local overlay = Library.Overlay
	local origin = overlay.AbsolutePosition
	local bp = anchor.AbsolutePosition
	local bs = anchor.AbsoluteSize
	local itemH = px(26)
	local menuW = px(width)
	local menuH = math.min(itemCount * (itemH + px(2)) + px(10), px(220))
	local x = bp.X - origin.X + bs.X - menuW
	local y = bp.Y - origin.Y + bs.Y + px(6)
	if y + menuH > overlay.AbsoluteSize.Y - px(8) then
		y = bp.Y - origin.Y - menuH - px(6)
	end
	x = math.clamp(x, px(8), math.max(px(8), overlay.AbsoluteSize.X - menuW - px(8)))

	local catcher = new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = overlay,
	})
	local menu = new("CanvasGroup", {
		Position = UDim2.fromOffset(x, y - px(6)),
		Size = UDim2.fromOffset(menuW, menuH),
		BackgroundColor3 = MENU_BG,
		GroupTransparency = 1,
		ClipsDescendants = true,
		Parent = overlay,
	})
	corner(menu, px(7))
	stroke(menu, BORDER, 1, 0.2)
	local scroll = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = GOLD,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = menu,
	})

	local api = { itemH = itemH, px = px, Scroll = scroll }
	local closed = false
	function api.Close()
		if closed then
			return
		end
		closed = true
		catcher:Destroy()
		tween(menu, 0.15, { GroupTransparency = 1 })
		task.delay(0.16, function()
			menu:Destroy()
		end)
		if api.OnClose then
			api.OnClose()
		end
	end

	build(scroll, api)

	Library.ActivePopup = api
	catcher.MouseButton1Click:Connect(function()
		if Library.ActivePopup == api then
			Library.ActivePopup = nil
		end
		api.Close()
	end)
	tween(menu, 0.15, { GroupTransparency = 0 })
	tween(menu, 0.15, { Position = UDim2.fromOffset(x, y) })
	return api
end

local function makeComponent(section, row, flag)
	local win = section.Window
	local obj = { Row = row, Flag = flag, Conns = {}, Destroyed = false }
	function obj:Destroy()
		if self.Destroyed then
			return
		end
		self.Destroyed = true
		for _, c in ipairs(self.Conns) do
			c:Disconnect()
		end
		table.clear(self.Conns)
		if self.Flag then
			Library.Flags[self.Flag] = nil
		end
		if self.Row then
			self.Row:Destroy()
		end
		for i, o in ipairs(win.Components) do
			if o == self then
				table.remove(win.Components, i)
				break
			end
		end
	end
	table.insert(win.Components, obj)
	return obj
end

