function Window:Fit(animated)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(self.BaseW + 16, self.BaseH + 16)
	local fit = math.min((vp.X - 16) / self.BaseW, (vp.Y - 16) / self.BaseH, 1)
	local target = math.max(0.45, math.min(Library.Settings.Scale, fit))
	if animated then
		tween(self.Scale, 0.3, { Scale = target }, Enum.EasingStyle.Quint)
	else
		self.Scale.Scale = target
	end
end

