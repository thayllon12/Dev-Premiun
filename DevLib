function Section:AddInput(opts)
	opts = opts or {}
	local row = makeRow(self, opts)
	local obj = makeComponent(self, row, opts.Flag)
	local numeric = opts.Numeric == true
	local current = opts.Default ~= nil and tostring(opts.Default) or ""
	local box = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(114, 26),
		BackgroundColor3 = INNER,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = CREAM,
		PlaceholderText = tostring(opts.Placeholder or "Enter text"),
		PlaceholderColor3 = MUTED,
		Text = current,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})
	corner(box, 6)
	local s = stroke(box, GOLD, 1, 0.45)

	local function apply(text, silent)
		if numeric then
			local n = tonumber(text)
			if n == nil then
				return false
			end
			text = tostring(n)
		end
		box.Text = text
		if text == current then
			return true
		end
		current = text
		setFlag(obj, numeric and tonumber(current) or current)
		if not silent then
			invoke("Input", opts.Callback, numeric and tonumber(current) or current)
		end
		return true
	end

	bind(obj.Conns, box.Focused, function()
		tween(s, FAST, { Transparency = 0 })
	end)
	bind(obj.Conns, box.FocusLost, function()
		tween(s, FAST, { Transparency = 0.45 })
		if not apply(box.Text) then
			box.Text = current
		end
	end)

	setFlag(obj, numeric and tonumber(current) or current)
	function obj:SetValue(v, silent)
		if not apply(tostring(v), silent) then
			box.Text = current
		end
	end
	function obj:GetValue()
		return numeric and tonumber(current) or current
	end
	return obj
end

function Section:AddKeybind(opts)
	opts = opts or {}
	local row = makeRow(self, opts)
	local obj = makeComponent(self, row, opts.Flag)
	local key = resolveKey(opts.Default)
	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(114, 26),
		BackgroundColor3 = INNER,
		AutoButtonColor = false,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = GOLD,
		Text = keyName(key),
		Parent = row,
	})
	corner(btn, 6)
	local s = stroke(btn, GOLD, 1, 0.45)
	hoverTween(obj.Conns, btn, INNER, HOVER)
	local listening = false

	local function setKey(k, silent)
		if k == key then
			return
		end
		key = k
		setFlag(obj, key)
		if not silent then
			invoke("Keybind", opts.ChangedCallback, key)
		end
	end
	local function finish()
		listening = false
		btn.Text = keyName(key)
		tween(s, FAST, { Transparency = 0.45 })
	end

	bind(obj.Conns, btn.MouseButton1Click, function()
		listening = true
		btn.Text = "Press a key"
		tween(s, FAST, { Transparency = 0 })
	end)
	bind(obj.Conns, UserInputService.InputBegan, function(input, processed)
		if listening then
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			if input.KeyCode ~= Enum.KeyCode.Escape then
				setKey(input.KeyCode)
			end
			finish()
			return
		end
		if processed then
			return
		end
		if key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
			invoke("Keybind", opts.Callback, key)
		end
	end)

	setFlag(obj, key)
	function obj:SetValue(k, silent)
		setKey(resolveKey(k), silent)
		if not listening then
			btn.Text = keyName(key)
		end
	end
	function obj:GetValue()
		return key
	end
	return obj
end

