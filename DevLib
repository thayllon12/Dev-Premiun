local function resolveKey(value)
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) == "string" then
		local ok, k = pcall(function()
			return Enum.KeyCode[value]
		end)
		if ok and k then
			return k
		end
	end
	return Enum.KeyCode.Unknown
end

local function keyName(key)
	if key == nil or key == Enum.KeyCode.Unknown then
		return "None"
	end
	return key.Name
end

function Section:AddToggle(opts)
	opts = opts or {}
	local row = makeRow(self, opts)
	local obj = makeComponent(self, row, opts.Flag)
	local state
	local track = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(36, 18),
		BackgroundColor3 = OFF,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	corner(track, 9)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 9, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = CREAM,
		Parent = track,
	})
	corner(knob, 7)
	local function render(instant)
		local d = instant and 0 or 0.18
		tween(track, d, { BackgroundColor3 = state and GOLD or OFF })
		tween(knob, d, {
			Position = state and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0),
		}, Enum.EasingStyle.Quint)
	end
	local function set(v, silent, instant)
		v = v == true
		if v == state then
			return
		end
		state = v
		render(instant)
		setFlag(obj, state)
		if not silent then
			invoke("Toggle", opts.Callback, state)
		end
	end
	bind(obj.Conns, track.MouseButton1Click, function()
		set(not state)
	end)
	set(opts.Default == true, true, true)
	function obj:SetValue(v, silent)
		set(v, silent)
	end
	function obj:GetValue()
		return state
	end
	return obj
end

function Section:AddSlider(opts)
	opts = opts or {}
	local row = makeRow(self, opts)
	local obj = makeComponent(self, row, opts.Flag)
	local min = tonumber(opts.Min) or 0
	local max = tonumber(opts.Max) or 100
	if max <= min then
		max = min + 1
	end
	local inc = tonumber(opts.Increment) or 1
	if inc <= 0 then
		inc = 1
	end
	local value
	local track = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -54, 0.5, 0),
		Size = UDim2.fromOffset(66, 6),
		BackgroundColor3 = OFF,
		Parent = row,
	})
	corner(track, 3)
	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = GOLD,
		Parent = track,
	})
	corner(fill, 3)
	new("UIGradient", { Color = ColorSequence.new(GOLD, ORANGE), Parent = fill })
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = CREAM,
		Parent = track,
	})
	corner(knob, 6)
	local readout = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(36, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = CREAM,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
	local hit = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -54, 0.5, 0),
		Size = UDim2.fromOffset(66, 22),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})

	local function render(instant)
		local p = (value - min) / (max - min)
		local d = instant and 0 or 0.12
		tween(fill, d, { Size = UDim2.new(p, 0, 1, 0) })
		tween(knob, d, { Position = UDim2.new(p, 0, 0.5, 0) })
	end
	local function set(v, silent, instant)
		local snapped = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
		if snapped == value then
			return
		end
		value = snapped
		readout.Text = tostring(value)
		render(instant)
		setFlag(obj, value)
		if not silent then
			invoke("Slider", opts.Callback, value)
		end
	end

	local dragging = false
	local function fromX(x)
		local p = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		set(min + p * (max - min))
	end
	bind(obj.Conns, hit.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	bind(obj.Conns, UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	bind(obj.Conns, UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	set(math.clamp(tonumber(opts.Default) or min, min, max), true, true)
	function obj:SetValue(v, silent)
		set(tonumber(v) or value, silent)
	end
	function obj:GetValue()
		return value
	end
	return obj
end

function Section:AddDropdown(opts)
	opts = opts or {}
