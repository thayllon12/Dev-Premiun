function GetPart(object)
    if not object then return nil end
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChild("HumanoidRootPart", true)
            or object:FindFirstChild("Head", true)
            or object:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

function GetHead(model)
    local head = model and model:FindFirstChild("Head", true)
    if head and head:IsA("BasePart") then return head end
    return GetPart(model)
end

function PartOf(m)
    return GetPart(m)
end

function IsAliveModel(m)
    local h = m and m:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

function StripName(n)
    return (string.lower(n):gsub("[%s%p_]+", ""))
end

function IsSnowman(m)
    return string.find(StripName(m.Name), "pumpkinsnowman", 1, true) ~= nil
end

function IsJack(m)
    local low = StripName(m.Name)
    return string.find(low, "jackolantern", 1, true) ~= nil or string.find(low, "lantern", 1, true) ~= nil
end

function IsFarmNPC(m)
    local n = StripName(m.Name)
    if string.find(n, "dapper", 1, true) then return false end
    return string.find(n, "pumpkin", 1, true) ~= nil
        or string.find(n, "lantern", 1, true) ~= nil
        or string.find(n, "jack", 1, true) ~= nil
end

function IsDapperJack(m)
    return StripName(m.Name) == "dapperjack"
end

function IsHellfireGas(m)
    return string.find(StripName(m.Name), "hellfiregas", 1, true) ~= nil
end

function BossActive(inst)
    return inst ~= nil and inst:GetAttribute("BOSS_ACTIVE_SERVER") == true
end

function PumpkinAlive(obj)
    if not obj or not obj.Parent then return false end
    if obj:IsA("BasePart") then return obj.Transparency == 0 end
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("BasePart") and v.Transparency == 0 then return true end
    end
    return false
end

function AnyVisible(obj)
    return PumpkinAlive(obj)
end

function HasM1Tag(i)
    local ok, t = pcall(function() return CollectionService:HasTag(i, "M1HitRegistry") end)
    return ok and t == true
end

function EventKind(ev)
    if type(ev) ~= "string" then return "game" end
    local low = string.lower(ev)
    if ev == "Boss Fight" or string.find(low, "hell", 1, true) then return "boss" end
    return "game"
end

function ToolMatches(t)
    if not t or not t:IsA("Tool") then return false end
    return t.ToolTip == SelectedToolType
        or t.Name:lower():find(SelectedToolType:lower(), 1, true) ~= nil
end

function EnsureTool()
    if os.clock() - LastEquip < 1 then return end
    LastEquip = os.clock()
    local char = Player.Character
    local _, hum = GetParts()
    if not char or not hum then return end
    if ToolMatches(char:FindFirstChildOfClass("Tool")) then return end
    local bp = Player:FindFirstChild("Backpack")
    if not bp then return end
    for _, item in ipairs(bp:GetChildren()) do
        if ToolMatches(item) then
            hum:EquipTool(item)
            return
        end
    end
end

function WaterFloor(pos)
    if pos.Y < -1000 then return nil end
    local map = Workspace:FindFirstChild("Map")
    local p = map and map:FindFirstChild("WaterBase-Plane")
    if not (p and p:IsA("BasePart")) then return nil end
    local lp = p.CFrame:PointToObjectSpace(pos)
    local sz = p.Size
    if math.abs(lp.X) > sz.X / 2 or math.abs(lp.Z) > sz.Z / 2 then return nil end
    return p.Position.Y + math.max(sz.Y / 2, 56) + CFG.WaterClearance
end

function SafePos(pos)
    local floor = WaterFloor(pos)
    if floor and pos.Y < floor then
        return Vector3.new(pos.X, floor, pos.Z)
    end
    return pos
end

function EnforceWater(root)
    local sp = SafePos(root.Position)
    if (sp - root.Position).Magnitude > 0.05 then
        root.CFrame = CFrame.new(sp) * (root.CFrame - root.CFrame.Position)
        root.AssemblyLinearVelocity = Vector3.zero
    end
end

function DestroyPhysics()
    if LV and LV.Parent then LV.VectorVelocity = Vector3.zero end
    if PhysFolder then pcall(function() PhysFolder:Destroy() end) end
    if PhysAttach then pcall(function() PhysAttach:Destroy() end) end
    PhysFolder = nil
    PhysAttach = nil
    LV = nil
    AO = nil
end

function EnsurePhysics()
    local root = GetRoot()
    if not root then return false end
    NoclipOn = true
    if PhysFolder and PhysFolder.Parent == root and LV and LV.Parent then return true end
    DestroyPhysics()
    PhysFolder = Instance.new("Folder")
    PhysFolder.Name = "DFPhysics"
    PhysFolder.Parent = root
    PhysAttach = Instance.new("Attachment")
    PhysAttach.Name = "DFAttach"
    PhysAttach.Parent = root
    LV = Instance.new("LinearVelocity")
    LV.Attachment0 = PhysAttach
    LV.RelativeTo = Enum.ActuatorRelativeTo.World
    LV.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    LV.ForceLimitsEnabled = false
    LV.MaxForce = math.huge
    LV.VectorVelocity = Vector3.zero
    LV.Parent = PhysFolder
    AO = Instance.new("AlignOrientation")
    AO.Attachment0 = PhysAttach
    AO.Mode = Enum.OrientationAlignmentMode.OneAttachment
    AO.RigidityEnabled = true
    AO.MaxTorque = math.huge
    AO.MaxAngularVelocity = math.huge
    AO.Responsiveness = 200
    AO.CFrame = root.CFrame
    AO.Parent = PhysFolder
    local _, hum = GetParts()
    if hum then hum.AutoRotate = false end
    return true
end

function SetVelocity(v)
    if LV and LV.Parent then LV.VectorVelocity = v end
end

function Halt()
    SetVelocity(Vector3.zero)
end

function SetOrientation(pos, look)
    if not AO or not AO.Parent then return end
    local dir = look - pos
    if dir.Magnitude > 0.001 then
        AO.CFrame = CFrame.lookAt(pos, pos + dir.Unit)
    end
end

function FlyTo(dest)
    if not EnsurePhysics() then return math.huge end
    local root = GetRoot()
    if not root then return math.huge end
    dest = SafePos(dest)
    local offset = dest - root.Position
    local d = offset.Magnitude
    if d <= CFG.ArrivalDistance then
        Halt()
        return d
    end
    local speed = d > CFG.FarmNearDist and CFG.FarmSpeedFar or CFG.FarmSpeedNear
    SetVelocity(offset.Unit * speed)
    SetOrientation(root.Position, dest)
    return d
end

function Release()
    NoclipOn = false
    Halt()
    DestroyPhysics()
    for part, was in pairs(SavedCollide) do
        if part.Parent then pcall(function() part.CanCollide = was end) end
    end
    SavedCollide = {}
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.AutoRotate = true end) end
end

function IsGateLocked(g)
    local u = LockedGates[g.Id]
    return u ~= nil and os.clock() < u
end

function LockGate(g)
    LockedGates[g.Id] = os.clock() + CFG.GateLockTime
end

function BestGate(dest)
    local root = GetRoot()
    if not root then return nil end
    local direct = (dest - root.Position).Magnitude
    if direct <= CFG.GateMinimumGain then return nil end
    local best, bestCost = nil, math.huge
    for _, g in ipairs(ActiveEntrances()) do
        if g.RequestPosition and not IsGateLocked(g) then
            local route = (g.GatePosition.Position - root.Position).Magnitude
                + (g.DestinationPosition.Position - dest).Magnitude
            local gain = direct - route
            if gain >= CFG.GateMinimumGain and gain / math.max(direct, 1) >= CFG.GateMinimumRatio and route < bestCost then
                best, bestCost = g, route
            end
        end
    end
    return best
end

function RequestGate(g)
    local comm = CommFRemote()
    if not comm then return false end
    return pcall(function()
        comm:InvokeServer(g.RequestName or "requestEntrance", g.RequestPosition)
    end)
end

function RouteGate(g, dest)
    HS.mode = "GATE " .. g.Name
    local t0 = os.clock()
    while not Destroyed and os.clock() - t0 < 12 do
        local root = GetRoot()
        if not root then return false end
        if (g.GatePosition.Position - root.Position).Magnitude <= CFG.GateExactDistance then break end
        FlyTo(g.GatePosition.Position)
        RunService.Heartbeat:Wait()
    end
    Halt()
    task.wait(CFG.GateStableTime)
    local root = GetRoot()
    if not root then return false end
    local start = root.Position
    local lastReq = -math.huge
    local t1 = os.clock()
    while not Destroyed and os.clock() - t1 < CFG.GateTeleportTimeout + 2 do
        if os.clock() - lastReq >= CFG.GateRetryDelay then
            lastReq = os.clock()
            RequestGate(g)
        end
        root = GetRoot()
        if not root then return false end
        if (root.Position - start).Magnitude >= CFG.GateTeleportDistance then
            LockGate(g)
            return true
        end
        task.wait(0.05)
    end
    LockGate(g)
    return false
end

function TravelFar(dest)
    local root = GetRoot()
    if not root then return false end
    if (dest - root.Position).Magnitude < CFG.GateFarDist then return false end
    if IsInDimensionPos(root.Position) then return false end
    local g = BestGate(dest)
    if not g then return false end
    local ok = RouteGate(g, dest)
    if ok then task.wait(CFG.GateWait) end
    return ok
end

function Go(dest, stop, timeout, abort)
    stop = stop or 3
    timeout = timeout or 25
    local t0 = os.clock()
    TravelFar(dest)
    if not EnsurePhysics() then return false end
    while not Destroyed do
        local root = GetRoot()
        if not root then
            Halt()
            return false
        end
        if (dest - root.Position).Magnitude <= stop then
            Halt()
            return true
        end
        if os.clock() - t0 > timeout then
            Halt()
            return false
        end
        if abort and abort() then
            Halt()
            return false
        end
        FlyTo(dest)
        RunService.Heartbeat:Wait()
    end
    Halt()
    return false
end

function GoAuto(pos, stop, abort)
    return Go(pos, stop, nil, abort)
end

function GetPortalEye()
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local dim = wo and wo:FindFirstChild("VArenaDimension")
    local p = dim and dim:FindFirstChild("PortalEye")
    if not p then return nil end
    if p:IsA("BasePart") then return p end
    if p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end

function BuildDimensionBounds()
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local dim = wo and wo:FindFirstChild("VArenaDimension")
    if not dim then return nil end
    local portal = dim:FindFirstChild("PortalEye")
    local minV = Vector3.new(math.huge, math.huge, math.huge)
    local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
    local found = false
    for _, obj in ipairs(dim:GetDescendants()) do
        if obj:IsA("BasePart") and not (portal and obj:IsDescendantOf(portal)) then
            local cf = obj.CFrame
            local half = obj.Size * 0.5
            for _, sx in ipairs({ -1, 1 }) do
                for _, sy in ipairs({ -1, 1 }) do
                    for _, sz in ipairs({ -1, 1 }) do
                        local p = cf:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
                        minV = Vector3.new(math.min(minV.X, p.X), math.min(minV.Y, p.Y), math.min(minV.Z, p.Z))
                        maxV = Vector3.new(math.max(maxV.X, p.X), math.max(maxV.Y, p.Y), math.max(maxV.Z, p.Z))
                        found = true
                    end
                end
            end
        end
    end
    if not found then return nil end
    local m = CFG.DimensionMargin
    return { Min = minV - Vector3.new(m, m, m), Max = maxV + Vector3.new(m, m, m) }
end

function IsInDimensionPos(pos)
    local now = os.clock()
    if DimBounds == nil or now - DimBoundsAt > CFG.DimensionRefresh then
        DimBounds = BuildDimensionBounds()
        DimBoundsAt = now
    end
    local b = DimBounds
    if not b then return false end
    return pos.X >= b.Min.X and pos.X <= b.Max.X
        and pos.Y >= b.Min.Y and pos.Y <= b.Max.Y
        and pos.Z >= b.Min.Z and pos.Z <= b.Max.Z
end

function EscapeStep()
    if HS.domain then return false end
    local root = GetRoot()
    if not root or not IsInDimensionPos(root.Position) then return false end
    local portal = GetPortalEye()
    if not portal then return false end
    HS.mode = "ESCAPE V"
    local d = FlyTo(portal.Position)
    if d <= 5 then
        Halt()
        root.CFrame = CFrame.new(portal.Position)
    end
    return true
end

function OrbitOffset()
    local now = os.clock()
    local r = CFG.OrbitRadius
    if OrbitMode == 1 then
        local a = now * CFG.OrbitSpeed
        return Vector3.new(math.cos(a) * r, CFG.OrbitHeight, math.sin(a) * r)
    elseif OrbitMode == 2 then
        local i = math.floor(now / CFG.DivineChangeTime) % 5
        if i == 0 then return Vector3.new(r, 0, 0) end
        if i == 1 then return Vector3.new(-r, 0, 0) end
        if i == 2 then return Vector3.new(0, 0, r) end
        if i == 3 then return Vector3.new(0, 0, -r) end
        return Vector3.new(0, r, 0)
    elseif OrbitMode == 3 then
        local k = math.floor(now / CFG.StarChangeTime)
        if StarKey ~= k or not StarPos then
            StarKey = k
            local theta = math.random() * math.pi * 2
            local phi = math.acos(2 * math.random() - 1)
            StarPos = Vector3.new(math.sin(phi) * math.cos(theta) * r, math.cos(phi) * r, math.sin(phi) * math.sin(theta) * r)
        end
        return StarPos
    end
    return Vector3.new(0, CFG.TopHeight, 0)
end

function FarmAttack(target, hitPart)
    local now = os.clock()
    local delay = FastAttack and CFG.FastAttackDelay or CFG.AttackDelay
    if now - LastAttack < delay then return end
    LastAttack = now
    EnsureTool()
    local ra = NetRemote("RegisterAttack")
    local rh = NetRemote("RegisterHit")
    if ra and rh then
        pcall(function()
            ra:FireServer(0)
            rh:FireServer(hitPart, { { target, hitPart } })
        end)
    end
end

function FightOrbit(m)
    local hum = m:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    HS.target = m
    HS.lastFight = os.clock()
    local t0 = os.clock()
    while not Destroyed and m.Parent and hum.Health > 0 and AnyVisible(m) do
        if os.clock() - t0 > CFG.EnemyTimeout then
            HS.ignored[m] = os.clock() + CFG.EnemyIgnoreTime
            break
        end
        local root = GetRoot()
        local tp = GetPart(m)
        if not root or not tp then break end
        EnsurePhysics()
        HS.lastFight = os.clock()
        HS.mode = "COMBATE"
        HS.note = m.Name
        local pred = tp.Position + tp.AssemblyLinearVelocity * CFG.PredictionTime
        FlyTo(SafePos(pred + OrbitOffset()))
        local root2 = GetRoot()
        if root2 and (pred - root2.Position).Magnitude <= CFG.AttackRadius then
            FarmAttack(m, m:FindFirstChild("HumanoidRootPart") or tp)
        end
        RunService.Heartbeat:Wait()
    end
    HS.target = nil
    Halt()
end

function NPCValid(npc)
    return npc and npc.Parent ~= nil and IsAliveModel(npc) and GetHead(npc) ~= nil
end

function GetNearestFarmNPC()
    local folder = Workspace:FindFirstChild("Enemies")
    local root = GetRoot()
    if not folder or not root then return nil end
    local nearest, shortest = nil, math.huge
    for _, enemy in ipairs(folder:GetDescendants()) do
        if enemy:IsA("Model") and not DeadNPCs[enemy] and IsFarmNPC(enemy) and IsAliveModel(enemy) then
            local part = GetHead(enemy)
            if part then
                local d = (part.Position - root.Position).Magnitude
                if d < shortest then
                    shortest = d
                    nearest = enemy
                end
            end
        end
    end
    return nearest
end

function GetNearestFarmPumpkin()
    local folder = Workspace:FindFirstChild("PumpkinHunt")
    local root = GetRoot()
    if not folder or not root then return nil end
    local nearest, shortest = nil, math.huge
    for _, obj in ipairs(folder:GetChildren()) do
        local cracked = obj:GetAttribute("PumpkinCrackedBy")
        local others = SkipOthersPumpkins and cracked ~= nil and cracked ~= Player.UserId
        if obj.Name == "Pumpkin" and not HiddenPumpkins[obj] and not others and PumpkinAlive(obj) then
            local part = GetPart(obj)
            if part then
                local d = (part.Position - root.Position).Magnitude
                if d < shortest then
                    shortest = d
                    nearest = { root = obj, part = part }
                end
            end
        end
    end
    return nearest
end

function FarmNpcStep(root, npc)
    local head = GetHead(npc)
    if not head then return end
    local dest = head.Position + Vector3.new(0, CFG.NPCHeight, 0)
    TravelFar(dest)
    root = GetRoot()
    if not root then return end
    FlyTo(dest)
    HS.mode = "NPC " .. npc.Name
    if (head.Position - root.Position).Magnitude <= CFG.AttackRadius then
        FarmAttack(npc, head)
    end
end

function FarmPumpkinStep(root, p)
    local part = p.part
    if not part or not part.Parent or not PumpkinAlive(p.root) then
        HiddenPumpkins[p.root] = true
        return
    end
    local dest = part.Position
    TravelFar(dest)
    root = GetRoot()
    if not root then return end
    local dist = (dest - root.Position).Magnitude
    if dist > CFG.PumpkinDistance then
        FlyTo(dest)
    else
        Halt()
    end
    HS.mode = "ABÓBORA"
    if dist <= CFG.AttackRadius then
        FarmAttack(p.root, part)
    end
end

function FarmTick()
    local root = GetRoot()
    if not root then return end
    local now = os.clock()
    if FarmNPC and not NPCValid(FarmNPC) then
        DeadNPCs[FarmNPC] = true
        FarmNPC = nil
    end
    if FarmPumpkin and not PumpkinAlive(FarmPumpkin.root) then
        HiddenPumpkins[FarmPumpkin.root] = true
        FarmPumpkin = nil
    end
    if now - FarmScanAt >= CFG.ScanInterval or (not FarmNPC and not FarmPumpkin) then
        FarmScanAt = now
        local npc = GetNearestFarmNPC()
        if npc then
            FarmNPC = npc
            FarmPumpkin = nil
        elseif not FarmNPC and not FarmPumpkin then
            FarmPumpkin = GetNearestFarmPumpkin()
        end
    end
    if FarmNPC then
        FarmNpcStep(root, FarmNPC)
    elseif FarmPumpkin then
        FarmPumpkinStep(root, FarmPumpkin)
    else
        Halt()
    end
end

function NearestFocusTarget()
    local folder = Workspace:FindFirstChild("Enemies")
    local root = GetRoot()
    if not folder or not root then return nil end
    local ev = EventOn()
    local inDomain = HS.domain ~= nil
    local best, bd = nil, math.huge
    local now = os.clock()
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and (HS.ignored[m] or 0) < now and IsAliveModel(m) and AnyVisible(m) then
            local p = GetPart(m)
            if p then
                local ok = inDomain
                    or (IsDapperJack(m) and DapperJackAuto)
                    or (ev and IsHellfireGas(m))
                if ok then
                    local d = (p.Position - root.Position).Magnitude
                    if d < bd and (inDomain and d <= CFG.DomainSearch or d <= CFG.TargetSearch) then
                        best, bd = m, d
                    end
                end
            end
        end
    end
    return best
end

DoorAddedConn = Workspace.DescendantAdded:Connect(function(d)
    if d.Name == "HalloweenDoor" then HS.doorSet[d] = true end
end)
table.insert(CONNS, DoorAddedConn)

function ScanDoors()
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d.Name == "HalloweenDoor" then HS.doorSet[d] = true end
    end
end

function DoorList()
    local out = {}
    for d in pairs(HS.doorSet) do
        if d.Parent and d:IsDescendantOf(Workspace) then
            local pr = d:FindFirstChildWhichIsA("ProximityPrompt", true)
            local part
            if d:IsA("BasePart") then
                part = d
            elseif pr and pr.Parent and pr.Parent:IsA("BasePart") then
                part = pr.Parent
            else
                part = d:FindFirstChildWhichIsA("BasePart", true)
            end
            if part then
                table.insert(out, {
                    inst = d,
                    part = part,
                    pos = part.Position,
                    prompt = pr,
                    open = d:GetAttribute("DoorOpen") == true,
                    cool = tonumber(d:GetAttribute("CooldownUntil")) or 0,
                    skip = HS.doorSkip[d] or 0,
                })
            end
        else
            HS.doorSet[d] = nil
        end
    end
    return out
end

function PickDoor(list, from)
    local now = os.clock()
    local serverNow = ServerNow()
    local best, bd = nil, math.huge
    for _, d in ipairs(list) do
        if not d.open and d.cool <= serverNow and d.skip <= now then
            local dist = (d.pos - from).Magnitude
            if dist < bd then best, bd = d, dist end
        end
    end
    return best
end

function KnockDoor(d)
    HS.halloweenAt = os.clock()
    local root = GetRoot()
    if not root then return end
    local stand = (d.part.CFrame * CFrame.new(0, 0, CFG.KnockStand)).Position
    HS.mode = "INDO PARA PORTA"
    if (root.Position - stand).Magnitude > 4 then
        if not GoAuto(stand, 1.5, function() return not HalloweenDoors or not EventOn() end) then
            HS.doorSkip[d.inst] = os.clock() + CFG.DoorSkip
            return
        end
    end
    root = GetRoot()
    if root then
        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(d.part.Position.X, root.Position.Y, d.part.Position.Z))
    end
    HS.door = nil
    HS.mode = "BATENDO"
    if d.prompt and d.prompt.Enabled and fireproximityprompt then
        pcall(fireproximityprompt, d.prompt)
    end
    local t0 = os.clock()
    while os.clock() - t0 < 0.8 and not HS.door and HalloweenDoors and EventOn() do
        CloseDialogue()
        task.wait(0.05)
    end
    if not HS.door then
        local _, fn = HalloweenRemotes()
        if fn then task.spawn(function() pcall(function() fn:InvokeServer(d.inst) end) end) end
        t0 = os.clock()
        while os.clock() - t0 < 2 and not HS.door and HalloweenDoors and EventOn() do
            CloseDialogue()
            task.wait(0.05)
        end
    end
    CloseDialogue()
    if HS.door then
        HS.tally.doors += 1
    else
        HS.doorSkip[d.inst] = os.clock() + CFG.DoorSkip
        HS.note = "porta sem resposta"
    end
end

function PortalPos()
    local now = os.clock()
    if HS.portalCache and HS.portalCache.Parent and now - HS.portalCacheAt < 1 then
        return HS.portalCache
    end
    HS.portalCacheAt = now
    local best = nil
    local root = GetRoot()
    if not root then return nil end
    local bd = math.huge
    for _, c in ipairs(Workspace:GetDescendants()) do
        if c.Name == "comm" and c:IsA("BasePart") then
            local d = (c.Position - root.Position).Magnitude
            if d < bd then best, bd = c, d end
        end
    end
    HS.portalCache = best
    return best
end

function EnterPortal(part)
    local root = GetRoot()
    if not root or not part then return end
    HS.mode = "INDO AO PORTAL"
    local t0 = os.clock()
    while os.clock() - t0 < CFG.PortalWait and not HS.domain and HalloweenDoors and HellfirePortal and part.Parent do
        local r = GetRoot()
        if not r then break end
        Go(part.Position + Vector3.new(0, 2, 0), 3, 6, function() return not HalloweenDoors end)
        r = GetRoot()
        if r and firetouchinterest then
            pcall(firetouchinterest, r, part, 0)
            pcall(firetouchinterest, r, part, 1)
        end
        HS.mode = "PORTAL HELLFIRE"
        task.wait(0.1)
    end
    Halt()
end

function ListenHalloween()
    if HS.listening then return end
    local ev = HalloweenRemotes()
    if not ev then return end
    HS.listening = true
    local id = RUN_ID
    local conn = ev.OnClientEvent:Connect(function(kind, inst, who, data)
        if RUN_ID ~= id or Destroyed then return end
        HS.halloweenAt = os.clock()
        if kind == "DoorOpened" then
            local evName = type(data) == "table" and data.Event or nil
            local isBoss = (type(data) == "table" and data.Boss == true) or EventKind(evName) == "boss"
            if who == Player then
                HS.door = { inst = inst, event = evName, boss = isBoss, at = os.clock(), accepted = false, done = false }
                if isBoss then HS.tally.bosses += 1 end
            end
            if isBoss then
                HS.portalDoor = inst
                HS.portalAt = os.clock()
            end
        elseif kind == "HellfireBossDeath" then
            HS.tally.bossKills += 1
        elseif kind == "HellfireBossExit" then
            HS.domain = nil
            HS.door = nil
        elseif kind == "BossTeleportSound" then
            if os.clock() - HS.portalAt < 90 then
                HS.domain = { at = os.clock() }
                HS.lastFight = os.clock()
                if HS.door and HS.door.boss then HS.door.done = true end
            end
        elseif kind == "PromptEventTeleport" then
            if AcceptTeleport then
                task.delay(1, function() FireEvent("AcceptEventTeleport") end)
            end
        elseif kind == "PromptEventReturn" then
            task.delay(1, function() FireEvent("AcceptTeleportReturn") end)
        elseif kind == "DapperJackCard" then
            if CollectCards and typeof(inst) == "Vector3" then
                table.insert(HS.cardList, { pos = inst, at = os.clock() })
            end
        elseif kind == "EventFinished" then
            if HS.door and HS.door.inst == inst then HS.door.done = true end
        end
    end)
    table.insert(CONNS, conn)
end

function DapperJackRun(boss)
    local root = GetRoot()
    local bp = GetPart(boss)
    if not root or not bp then return false end
    if (bp.Position - root.Position).Magnitude <= CFG.TargetSearch then return false end
    local gw
    local bd = math.huge
    for _, p in ipairs(CollectionService:GetTagged("DapperJackGateway")) do
        if p:IsA("BasePart") and p:IsDescendantOf(Workspace) then
            local d = (p.Position - root.Position).Magnitude
            if d < bd then gw, bd = p, d end
        end
    end
    if not gw then return false end
    HS.mode = "PORTAL DAPPER JACK"
    if GoAuto(gw.Position + Vector3.new(0, 3, 0), 4) then
        local pr = gw:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pr and fireproximityprompt then pcall(fireproximityprompt, pr) end
        local r = GetRoot()
        if r and firetouchinterest then
            pcall(firetouchinterest, r, gw, 0)
            pcall(firetouchinterest, r, gw, 1)
        end
        task.wait(1)
    end
    return true
end

function FindCandy(root)
    local best, bd = nil, CFG.CandyRange
    local now = os.clock()
    for _, obj in ipairs(Workspace:GetChildren()) do
        local n = string.lower(obj.Name)
        if string.find(n, "candy", 1, true) and not string.find(n, "fx", 1, true) and not string.find(n, "spill", 1, true) and (HS.skip[obj] or 0) < now then
            local h = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if h then
                local d = (h.Position - root.Position).Magnitude
                if d < bd then best, bd = { model = obj, handle = h }, d end
            end
        end
    end
    return best
end

function CollectCandy()
    local root = GetRoot()
    if not root then return false end
    local c = FindCandy(root)
    if not c then return false end
    HS.mode = "CANDY"
    HS.note = "coletando " .. c.model.Name
    if not GoAuto(c.handle.Position, 2) then
        HS.skip[c.model] = os.clock() + 20
        return true
    end
    local pr = c.model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pr and fireproximityprompt then pcall(fireproximityprompt, pr) end
    local r = GetRoot()
    if r and firetouchinterest then
        pcall(firetouchinterest, r, c.handle, 0)
        pcall(firetouchinterest, r, c.handle, 1)
    end
    task.wait(0.25)
    if c.handle:IsDescendantOf(Workspace) then
        HS.skip[c.model] = os.clock() + 10
    else
        HS.tally.candy += 1
    end
    return true
end

function CollectCard()
    local root = GetRoot()
    if not root then return false end
    local now = os.clock()
    local keep = {}
    for _, c in ipairs(HS.cardList) do
        if now - c.at <= 90 then table.insert(keep, c) end
    end
    HS.cardList = keep
    local best, bd = nil, math.huge
    for _, c in ipairs(keep) do
        local d = (c.pos - root.Position).Magnitude
        if d < bd then best, bd = c, d end
    end
    if not best then return false end
    HS.mode = "CARD DAPPER JACK"
    best.at = 0
    if not GoAuto(best.pos + Vector3.new(0, 2, 0), 3) then return true end
    FireEvent("DapperJackCardClaim")
    HS.tally.cards += 1
    task.wait(0.4)
    return true
end

function BringFruits()
    local root = GetRoot()
    if not root then return false end
    local now = os.clock()
    local did = false
    for _, obj in ipairs(Workspace:GetChildren()) do
        if string.find(string.lower(obj.Name), "fruit", 1, true) and (HS.skip[obj] or 0) < now then
            local h = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
            if h and h:IsA("BasePart") and (h.Position - root.Position).Magnitude <= CFG.FruitRange then
                h.CanCollide = false
                h.CFrame = root.CFrame * CFrame.new(0, -4, 0)
                if firetouchinterest then
                    pcall(firetouchinterest, root, h, 0)
                    pcall(firetouchinterest, root, h, 1)
                end
                HS.skip[obj] = now + 3
                task.delay(0.6, function()
                    if not h:IsDescendantOf(Workspace) then HS.tally.fruits += 1 end
                end)
                did = true
            end
        end
    end
    HS.mode = did and "BRING FRUTAS" or HS.mode
    return did
end

function UpdStFruit()
    local backpack = Player:FindFirstChild("Backpack")
    if not backpack then return end
    local commF = CommFRemote()
    for _, item in ipairs(backpack:GetChildren()) do
        if Destroyed then break end
        local eatRemote = item:FindFirstChild("EatRemote", true)
        if eatRemote then
            local parent = eatRemote.Parent
            local originalName = parent and parent:GetAttribute("OriginalName")
            local fruitTool = backpack:FindFirstChild(item.Name)
            if originalName and fruitTool and commF then
                pcall(function() commF:InvokeServer("StoreFruit", originalName, fruitTool) end)
            end
        end
    end
end

function MainStep()
    CloseDialogue()
    local root = GetRoot()
    if not root then
        HS.mode = "SEM PERSONAGEM"
        return
    end
    EnforceWater(root)

    if EscapeStep() then return end

    local now = os.clock()
    if HS.domain and now - math.max(HS.domain.at, HS.lastFight) > CFG.DomainTimeout then
        HS.domain = nil
    end

    local focus = NearestFocusTarget()
    if focus then
        FightOrbit(focus)
        return
    end

    local d = HS.door
    if d and not d.done then
        if now - d.at > CFG.DoorMax or not (d.inst and d.inst.Parent) then
            HS.door = nil
        elseif d.boss then
            local pt = (HalloweenDoors and HellfirePortal) and PortalPos() or nil
            if pt then
                EnterPortal(pt)
                return
            end
            if not (HalloweenDoors and HellfirePortal) or now - d.at > 15 then
                d.done = true
            else
                HS.mode = "ESPERANDO PORTAL"
                Halt()
                return
            end
        else
            if not d.accepted and now - d.at > 1 then
                d.accepted = true
                FireEvent(AcceptRewards and "AcceptReward" or "DeclineReward")
                d.done = true
            end
            CloseDialogue()
        end
    end

    if HS.domain then
        HS.mode = "DOMÍNIO"
        Halt()
        return
    end

    local boss = nil
    local folder = Workspace:FindFirstChild("Enemies")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") and IsDapperJack(m) and IsAliveModel(m) then
                boss = m
                break
            end
        end
    end
    if boss then
        HS.bossSeen = true
        if DapperJackAuto and DapperJackRun(boss) then return end
    elseif HS.bossSeen then
        HS.bossSeen = false
        HS.candyUntil = now + CFG.CandyWindow
    end

    if CandyCollect and now < HS.candyUntil and CollectCandy() then
        return
    end

    if CollectCards and CollectCard() then
        return
    end

    if HalloweenDoors and EventOn() then
        local spot = SeaSpot()
        if spot and (root.Position - spot).Magnitude > 80 then
            HS.mode = "INDO PARA AS PORTAS"
            if GoAuto(spot, 10, function() return not HalloweenDoors or not EventOn() end) then
                return
            end
        end
        local list = DoorList()
        local door = PickDoor(list, spot or root.Position)
        if door then
            KnockDoor(door)
            return
        end
        if #list == 0 and AcceptTeleport then
            local hour = os.date("!%Y%m%d%H")
            if HS.tpHour ~= hour then
                HS.tpHour = hour
                HS.mode = "TELETRANSPORTE"
                Halt()
                FireEvent("AcceptEventTeleport")
                task.wait(6)
                return
            end
        end
    end

    if GodFarm then
        FarmTick()
        if FarmNPC or FarmPumpkin then return end
    end

    if AutoBringFruits and BringFruits() then
        return
    end

    HS.mode = "ESPERANDO"
    Halt()
end

function BringEnemy()
    local root = GetRoot()
    local enemies = Workspace:FindFirstChild("Enemies")
    if not root or not enemies then return end
    pcall(function()
        if sethiddenproperty then sethiddenproperty(Player, "SimulationRadius", math.huge) end
    end)
    local target = root.Position - Vector3.new(0, CFG.NPCHeight, 0)
    local range = math.clamp(CFG.BringRange, 1, 300)
    local count = 0
    for _, mob in ipairs(enemies:GetChildren()) do
        if Destroyed or count >= CFG.MaxBringMobs then break end
        if mob:IsA("Model") and (IsSnowman(mob) or IsJack(mob)) and IsAliveModel(mob) and AnyVisible(mob) then
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
            if mobRoot and not mobRoot:GetAttribute("Tweening") then
                local d = (mobRoot.Position - target).Magnitude
                if d <= range then
                    count += 1
                    mobRoot:SetAttribute("Tweening", true)
                    if BringTweens[mobRoot] then pcall(function() BringTweens[mobRoot]:Cancel() end) end
                    local tw = TweenService:Create(mobRoot, TweenInfoBring, { CFrame = CFrame.new(target) })
                    BringTweens[mobRoot] = tw
                    tw.Completed:Once(function()
                        if mobRoot and mobRoot.Parent then mobRoot:SetAttribute("Tweening", false) end
                        BringTweens[mobRoot] = nil
                    end)
                    tw:Play()
                end
            end
        end
    end
end

function CreateBillboard(part)
    local gui = Instance.new("BillboardGui")
    gui.Name = "PumpkinESP"
    gui.Adornee = part
    gui.Size = UDim2.fromScale(5, 1.2)
    gui.StudsOffset = Vector3.new(0, 3, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 3000
    gui.Parent = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Text = ""
    label.Parent = gui
    return { gui = gui, label = label }
end

function ClearESP()
    for _, data in pairs(ESPBillboards) do
        pcall(function() data.gui:Destroy() end)
    end
    ESPBillboards = {}
end

function ESPUpdate()
    local root = GetRoot()
    if not ShowESP or not root then
        ClearESP()
        return
    end
    local want = {}
    local pf = Workspace:FindFirstChild("PumpkinHunt")
    if pf then
        for _, obj in ipairs(pf:GetChildren()) do
            if obj.Name == "Pumpkin" and PumpkinAlive(obj) then
                local p = GetPart(obj)
                if p then
                    want[obj] = { part = p, text = "Abóbora " .. math.floor((p.Position - root.Position).Magnitude), color = Color3.fromRGB(255, 170, 0) }
                end
            end
        end
    end
    local ef = Workspace:FindFirstChild("Enemies")
    if ef then
        for _, m in ipairs(ef:GetChildren()) do
            if m:IsA("Model") and (IsFarmNPC(m) or IsHellfireGas(m)) and IsAliveModel(m) then
                local p = GetHead(m)
                local h = m:FindFirstChildOfClass("Humanoid")
                if p and h then
                    want[m] = { part = p, text = m.Name .. " " .. math.floor(h.Health) .. " HP", color = Color3.fromRGB(255, 60, 60) }
                end
            end
        end
    end
    for key, data in pairs(ESPBillboards) do
        if not want[key] or not data.gui.Parent then
            pcall(function() data.gui:Destroy() end)
            ESPBillboards[key] = nil
        end
    end
    for key, info in pairs(want) do
        local data = ESPBillboards[key]
        if not data or not data.gui.Parent then
            data = CreateBillboard(info.part)
            ESPBillboards[key] = data
        end
        data.gui.Adornee = info.part
        data.gui.Parent = info.part
        data.label.Text = info.text
        data.label.TextColor3 = info.color
    end
end

function CreateGodFPSOverlay()
    if GodFPSGui and GodFPSGui.Parent then return end
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "GodFPSOverlay"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 999999
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Active = false
    frame.Parent = screenGui
    screenGui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    GodFPSGui = screenGui
end

function ApplyGodFPS()
    CreateGodFPSOverlay()
    if GodFPSGui then
        local frame = GodFPSGui:FindFirstChildOfClass("Frame")
        if frame then frame.BackgroundTransparency = 0 end
    end
    GodFPSOriginals = {}
    local pumpkinFolder = Workspace:FindFirstChild("PumpkinHunt")
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if pumpkinFolder and obj:IsDescendantOf(pumpkinFolder) then
        elseif obj:IsA("BasePart") then
            GodFPSOriginals[obj] = { Transparency = obj.Transparency, LocalTransparencyModifier = obj.LocalTransparencyModifier }
            obj.Transparency = 1
            obj.LocalTransparencyModifier = 1
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            GodFPSOriginals[obj] = { Transparency = obj.Transparency }
            obj.Transparency = 1
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam")
            or obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        end
    end
    GodFPSOriginalLighting = {
        GlobalShadows = Lighting.GlobalShadows,
        Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        FogEnd = Lighting.FogEnd,
    }
    Lighting.GlobalShadows = false
    Lighting.Brightness = 0
    Lighting.Ambient = Color3.fromRGB(0, 0, 0)
    Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
    Lighting.FogEnd = 100000
end

function RestoreGodFPS()
    if GodFPSGui then
        local frame = GodFPSGui:FindFirstChildOfClass("Frame")
        if frame then frame.BackgroundTransparency = 1 end
    end
    for obj, data in pairs(GodFPSOriginals) do
        if obj and obj.Parent then
            pcall(function()
                if data.Transparency ~= nil then obj.Transparency = data.Transparency end
                if data.LocalTransparencyModifier ~= nil then obj.LocalTransparencyModifier = data.LocalTransparencyModifier end
                if data.Enabled ~= nil then obj.Enabled = data.Enabled end
            end)
        end
    end
    GodFPSOriginals = {}
    if GodFPSOriginalLighting.GlobalShadows ~= nil then
        Lighting.GlobalShadows = GodFPSOriginalLighting.GlobalShadows
        Lighting.Brightness = GodFPSOriginalLighting.Brightness
        Lighting.Ambient = GodFPSOriginalLighting.Ambient
        Lighting.OutdoorAmbient = GodFPSOriginalLighting.OutdoorAmbient
        Lighting.FogEnd = GodFPSOriginalLighting.FogEnd
    end
    GodFPSOriginalLighting = {}
end

