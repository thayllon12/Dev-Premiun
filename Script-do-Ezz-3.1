function GetSavePath()
    if writefile and isfolder then
        local folder = "PumpkinHunt"
        if not isfolder(folder) then pcall(makefolder, folder) end
        return folder .. "/" .. CFG.SaveFileName
    end
    return nil
end

function SaveStates()
    local path = GetSavePath()
    if not path or not writefile then return end
    local data = {
        GodFarm = GodFarm,
        ShowESP = ShowESP,
        GodFPS = GodFPS,
        AutoRollStore = AutoRollStore,
        AutoBringFruits = AutoBringFruits,
        SelectedToolType = SelectedToolType,
        FastAttack = FastAttack,
        OrbitMode = OrbitMode,
        HalloweenDoors = HalloweenDoors,
        AcceptRewards = AcceptRewards,
        AcceptTeleport = AcceptTeleport,
        HellfirePortal = HellfirePortal,
        DapperJackAuto = DapperJackAuto,
        CollectCards = CollectCards,
        CandyCollect = CandyCollect,
        HalloweenRareFirst = HalloweenRareFirst,
        SkipOthersPumpkins = SkipOthersPumpkins,
        Tune = {
            EnemyTimeout = CFG.EnemyTimeout,
            EventMinutes = CFG.EventMinutes,
        },
        GamePlaceId = game.PlaceId,
    }
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then pcall(writefile, path, encoded) end
end

function LoadStates()
    local path = GetSavePath()
    if not path or not readfile or not isfile then return nil end
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return nil end
    local ok2, content = pcall(readfile, path)
    if not ok2 or not content then return nil end
    local ok3, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok3 or type(decoded) ~= "table" then return nil end
    if decoded.GamePlaceId and decoded.GamePlaceId ~= game.PlaceId then return nil end
    return decoded
end

