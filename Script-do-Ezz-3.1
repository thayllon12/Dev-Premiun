-- MAIN LOOP

FlightConnection = RunService.Heartbeat:Connect(function(dt)
    if Destroyed then return end
    if not AutoFarm and not AutoAttack then return end

    UpdateCharacter()

    if not Root or not Root.Parent then return end

    if Humanoid and (Humanoid.Sit or Humanoid.SeatPart) then
        Humanoid.Sit = false
        pcall(function()
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end

    ScanTimer += dt

    if ScanTimer >= Config.ScanInterval then
        ScanTimer = 0

        local npc = GetNearestNPC()

        if npc then
            if TargetNPC ~= npc then
                TargetNPC = npc
                TargetPumpkin = nil
                CurrentTarget = npc
                CurrentMode = "NPC"
            end
        elseif TargetNPC then
            if not TargetNPC.Parent or not IsAlive(TargetNPC) then
                DeadNPCs[TargetNPC] = true
                TargetNPC = nil
                CurrentTarget = nil
                CurrentMode = "SEARCH"
            end
        end

        if not TargetNPC then
            if TargetPumpkin and (
                not TargetPumpkin.Parent
                or not IsVisible(TargetPumpkin)
            ) then
                HiddenPumpkins[TargetPumpkin] = true
                TargetPumpkin = nil
                CurrentTarget = nil
                CurrentMode = "SEARCH"
            end

            if not TargetPumpkin then
                SelectTarget()
            end
        end
    end

    local target
    local hitPart

    if CurrentMode == "NPC" and TargetNPC then
        local npc = TargetNPC
        local h = npc:FindFirstChildOfClass("Humanoid")
        local head = GetHead(npc)

        if not npc.Parent or not h or h.Health <= 0 or not head then
            DeadNPCs[npc] = true
            TargetNPC = nil
            CurrentTarget = nil
            CurrentMode = "SEARCH"
            return
        end

        target = npc
        hitPart = head

        local destination = head.Position + Vector3.new(0, Config.NPCHeight, 0)
        local difference = destination - Root.Position
        local distance = difference.Magnitude

        if AutoFarm and BodyVelocity and BodyGyro then
            if distance > 2 then
                BodyVelocity.Velocity = difference.Unit * Config.Speed
            else
                BodyVelocity.Velocity = Vector3.zero
            end

            local look = head.Position - Root.Position
            if look.Magnitude > 0.01 then
                BodyGyro.CFrame = CFrame.lookAt(
                    Root.Position,
                    Root.Position + look.Unit
                )
            end
        end

        if AutoAttack and distance <= Config.AttackRadius then
            AttackTarget(npc, head)
        end

        FooterText.Text = AutoFarm
            and "Indo até Jack o' Lantern"
            or "Alvo: Jack o' Lantern"

    elseif CurrentMode == "PUMPKIN" and TargetPumpkin then
        local pumpkin = TargetPumpkin

        if not pumpkin.Parent or not IsVisible(pumpkin) then
            HiddenPumpkins[pumpkin] = true
            TargetPumpkin = nil
            CurrentTarget = nil
            CurrentMode = "SEARCH"
            return
        end

        local part = GetPart(pumpkin)

        if not part then
            TargetPumpkin = nil
            CurrentTarget = nil
            CurrentMode = "SEARCH"
            return
        end

        target = pumpkin
        hitPart = part

        local difference = part.Position - Root.Position
        local distance = difference.Magnitude

        if AutoFarm and BodyVelocity and BodyGyro then
            if distance > Config.PumpkinDistance then
                BodyVelocity.Velocity = difference.Unit * Config.Speed

                BodyGyro.CFrame = CFrame.lookAt(
                    Root.Position,
                    Root.Position + difference.Unit
                )
            else
                BodyVelocity.Velocity = Vector3.zero
            end
        end

        if AutoAttack and distance <= Config.AttackRadius then
            AttackTarget(pumpkin, part)
        end

        FooterText.Text = AutoFarm
            and "Indo até Pumpkin"
            or "Alvo: Pumpkin"
    else
        if BodyVelocity then
            BodyVelocity.Velocity = Vector3.zero
        end

        FooterText.Text = "Procurando alvos..."
    end

    UpdateStatus()
end)

-- CHARACTER RESPAWN

CharacterConnection = Player.CharacterAdded:Connect(function()
    if AutoFarm then
        FarmSwitch.Set(false)
    end

    task.wait(0.5)
    UpdateCharacter()
end)

-- MINIMIZE

local Minimized = false

Minimize.MouseButton1Click:Connect(function()
    Minimized = not Minimized

    Tween(Main, 0.25, {
        Size = Minimized
            and UDim2.fromOffset(400, 59)
            or UDim2.fromOffset(400, 300)
    })

    Content.Visible = not Minimized
    Footer.Visible = not Minimized

    Minimize.Text = Minimized and "+" or "−"
end)

-- DRAG PC + MOBILE

local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        StartPosition = Main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if Dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = false
    end
end)

-- CLEANUP

local function Cleanup()
    if Destroyed then return end

    Destroyed = true
    AutoFarm = false
    AutoAttack = false
    AutoRollStore = false

    StopFlight()

    if AntiAFKConnection then
        AntiAFKConnection:Disconnect()
        AntiAFKConnection = nil
    end

    if FlightConnection then
        FlightConnection:Disconnect()
        FlightConnection = nil
    end

    if CharacterConnection then
        CharacterConnection:Disconnect()
        CharacterConnection = nil
    end

    if Gui and Gui.Parent then
        Gui:Destroy()
    end
end

Env.PumpkinHuntCleanup = Cleanup

Gui.Destroying:Connect(function()
    if not Destroyed then
        Cleanup()
    end
end)

Tween(Main, 0.4, {
    Position = UDim2.new(0.5, -200, 0.5, -150)
}, Enum.EasingStyle.Back)

print("[Pumpkin Hunt] Fluent interface carregada.")
print("[Pumpkin Hunt] Auto Farm / Auto Attack / Auto Roll + Store Fruit.")
print("[Pumpkin Hunt] Anti-AFK ativo.")
