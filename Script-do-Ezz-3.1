function ServerNow()
    local ok, t = pcall(function() return Workspace:GetServerTimeNow() end)
    return ok and t or os.time()
end

function EventOn()
    return workspace:GetAttribute("HalloweenEventActive") == true or os.date("!*t").min < CFG.EventMinutes
end

function SeaSpot()
    local sea = SEA_OF_PLACE[game.PlaceId]
    return sea and DOOR_SPOTS[sea] or nil
end

function Engaged()
    return not Destroyed and (GodFarm or AutoAttack or HalloweenDoors or AutoBringFruits)
end

function GetParts()
    local char = Player.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil, nil end
    return root, hum
end

function HealthPct()
    local _, hum = GetParts()
    if not hum or hum.MaxHealth <= 0 then return 1 end
    return hum.Health / hum.MaxHealth
end

function NetFolder()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    return modules and modules:FindFirstChild("Net")
end

function NetRemote(name)
    local net = NetFolder()
    return net and net:FindFirstChild("RE/" .. name)
end

function CommFRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild("CommF_")
end

function HalloweenRemotes()
    local f = ReplicatedStorage:FindFirstChild("Remotes")
    if not f then return nil, nil end
    return f:FindFirstChild("HalloweenEvent"), f:FindFirstChild("HalloweenFunction")
end

function FireEvent(name)
    local ev = HalloweenRemotes()
    if ev then pcall(function() ev:FireServer(name) end) end
end

function PartOf(m)
    if not m then return nil end
    if m:IsA("BasePart") then return m end
    if m:IsA("Model") then
        return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

function IsAliveModel(m)
    local h = m and m:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

function StripName(n)
    return (string.lower(n):gsub("[%s%p_]+", ""))
end

function IsSnowman(m)
    return string.find(StripName(m.Name), "pumpkinsnowman", 1, true) ~= nil
end

function IsJack(m)
    local low = StripName(m.Name)
    return string.find(low, "jackolantern", 1, true) ~= nil or string.find(low, "lantern", 1, true) ~= nil
end

function IsDapperJack(m)
    return FocusDapperJack and StripName(m.Name) == "dapperjack"
end

function BossActive(inst)
    return inst ~= nil and inst:GetAttribute("BOSS_ACTIVE_SERVER") == true
end

function IsHellfireGas(m)
    return string.find(StripName(m.Name), "hellfiregas", 1, true) ~= nil
end

function IsFocus(m)
    return IsSnowman(m) or IsJack(m) or IsHellfireGas(m) or IsDapperJack(m)
end

function HasM1Tag(i)
    local ok, t = pcall(function() return CollectionService:HasTag(i, "M1HitRegistry") end)
    return ok and t == true
end

function Visible(p)
    if not p or not p.Parent then return false end
    if GodFPS then return true end
    return p.Transparency < 0.98 and p.LocalTransparencyModifier < 0.98
end

function AnyVisible(obj)
    if obj:IsA("BasePart") then return Visible(obj) end
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("BasePart") and Visible(v) then return true end
    end
    return false
end

function EventKind(ev)
    if type(ev) ~= "string" then return "game" end
    local low = string.lower(ev)
    if ev == "Boss Fight" or string.find(low, "hell", 1, true) then return "boss" end
    return "game"
end

function ToolMatches(t)
    if not t or not t:IsA("Tool") then return false end
    return t.ToolTip == SelectedToolType
        or t.Name:lower():find(SelectedToolType:lower(), 1, true) ~= nil
end

function EnsureTool()
    if os.clock() - LastEquip < 1 then return end
    LastEquip = os.clock()
    local char = Player.Character
    local _, hum = GetParts()
    if not char or not hum then return end
    if ToolMatches(char:FindFirstChildOfClass("Tool")) then return end
    local bp = Player:FindFirstChild("Backpack")
    if not bp then return end
    for _, item in ipairs(bp:GetChildren()) do
        if ToolMatches(item) then
            hum:EquipTool(item)
            return
        end
    end
end

function FaceTo(target)
    if not LockCF then return end
    local pos = LockCF.Position
    local flat = Vector3.new(target.X, pos.Y, target.Z)
    if (flat - pos).Magnitude > 0.5 then
        LockCF = CFrame.lookAt(pos, flat)
    end
end

function WaterFloor(pos)
    if pos.Y < -1000 then return nil end
    local now = os.clock()
    if now - WaterSlabAt > 2 or not (WaterSlabRef and WaterSlabRef.Parent) then
        WaterSlabAt = now
        local map = Workspace:FindFirstChild("Map")
        local p = map and map:FindFirstChild("WaterBase-Plane")
        WaterSlabRef = (p and p:IsA("BasePart")) and p or nil
    end
    local slab = WaterSlabRef
    if not slab then return nil end
    local lp = slab.CFrame:PointToObjectSpace(pos)
    local sz = slab.Size
    if math.abs(lp.X) > sz.X / 2 or math.abs(lp.Z) > sz.Z / 2 then return nil end
    return slab.Position.Y + math.max(sz.Y / 2, 56) + CFG.WaterClearance
end

