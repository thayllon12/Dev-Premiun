local function GetPart(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChild("HumanoidRootPart", true)
            or object:FindFirstChild("Head", true)
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function GetHead(model)
    local Head = model and model:FindFirstChild("Head", true)

    if Head and Head:IsA("BasePart") then
        return Head
    end

    return GetPart(model)
end

local function IsAlive(model)
    local H = model and model:FindFirstChildOfClass("Humanoid")
    return H and H.Health > 0
end

local function IsTargetEnemy(enemy)
    if not enemy or not enemy:IsA("Model") then
        return false
    end

    local name = string.lower(enemy.Name):gsub("[%s%p_]+", "")

    return name:find("jack") ~= nil
        or name:find("pumpkin") ~= nil
        or name:find("lantern") ~= nil
end

local function IsJackEnemy(enemy)
    if not enemy or not enemy:IsA("Model") then
        return false
    end

    local name = string.lower(enemy.Name):gsub("[%s%p_]+", "")

    return name:find("jack") ~= nil
        or name:find("lantern") ~= nil
end

local function IsRaidMob(enemy)
    local name = string.lower(enemy.Name)
    return name:find("raid") ~= nil or name:find("boss") ~= nil
end

local function IsVisible(object)
    if not object or not object.Parent then return false end

    if object:IsA("BasePart") then
        return object.Transparency < 0.98
            and object.LocalTransparencyModifier < 0.98
    end

    for _, v in ipairs(object:GetDescendants()) do
        if v:IsA("BasePart")
            and v.Transparency < 0.98
            and v.LocalTransparencyModifier < 0.98 then
            return true
        end
    end

    return false
end

local function GetNearestNPC()
    local Folder = Workspace:FindFirstChild("Enemies")

    if not Folder or not Root then return nil end

    local Nearest
    local Shortest = math.huge

    for _, enemy in ipairs(Folder:GetDescendants()) do
        if enemy:IsA("Model")
            and enemy.Parent
            and IsTargetEnemy(enemy)
            and not DeadNPCs[enemy]
            and IsAlive(enemy) then

            local part = GetHead(enemy)

            if part then
                local distance = (part.Position - Root.Position).Magnitude

                if distance < Shortest then
                    Shortest = distance
                    Nearest = enemy
                end
            end
        end
    end

    return Nearest
end

local function GetNearestPumpkin()
    local Folder = Workspace:FindFirstChild("PumpkinHunt")

    if not Folder or not Root then return nil end

    local Nearest
    local Shortest = math.huge

    for _, object in ipairs(Folder:GetDescendants()) do
        if object.Name == "Pumpkin"
            and object.Parent
            and not HiddenPumpkins[object] then

            if GodFPS or IsVisible(object) then
                local part = GetPart(object)

                if part then
                    local distance = (part.Position - Root.Position).Magnitude

                    if distance < Shortest then
                        Shortest = distance
                        Nearest = object
                    end
                end
            end
        end
    end

    return Nearest
end

local function SelectTarget()
    local NPC = GetNearestNPC()

    if NPC then
        TargetNPC = NPC
        TargetPumpkin = nil
        CurrentMode = "NPC"
        return
    end

    TargetNPC = nil
    TargetPumpkin = GetNearestPumpkin()

    if TargetPumpkin then
        CurrentMode = "PUMPKIN"
    else
        CurrentMode = "SEARCH"
    end
end

