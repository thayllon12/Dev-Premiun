local TweenInfoBring = TweenInfo.new(
    0.35,
    Enum.EasingStyle.Linear,
    Enum.EasingDirection.Out
)

local function FarmAtivo()
    return AutoFarm and not Destroyed
end

local function GetBringPosition()
    if TargetNPC and TargetNPC.Parent then
        local targetRoot = GetPart(TargetNPC)

        if targetRoot then
            return targetRoot.Position
        end
    end

    return Root and Root.Position
end

local function BringEnemy()
    if not FarmAtivo() or not AutoBring or not Root then
        return
    end

    local Enemies = Workspace:FindFirstChild("Enemies")
    if not Enemies then return end

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(Player, "SimulationRadius", math.huge)
        end
    end)

    local TargetPosition = GetBringPosition()
    if not TargetPosition then return end

    local Range = math.clamp(tonumber(_G.BringRange) or 300, 1, 300)
    local MaxMobs = math.clamp(tonumber(_G.MaxBringMobs) or 10, 1, 50)
    local Count = 0

    for _, mob in ipairs(Enemies:GetChildren()) do
        if Destroyed or not AutoBring then break end
        if Count >= MaxMobs then break end

        if mob:IsA("Model") and IsJackEnemy(mob) then
            local Hum = mob:FindFirstChildOfClass("Humanoid")
            local MobRoot = mob:FindFirstChild("HumanoidRootPart")

            if Hum and MobRoot
                and Hum.Health > 0
                and not IsRaidMob(mob) then

                local Distance = (MobRoot.Position - TargetPosition).Magnitude

                if Distance <= Range
                    and not MobRoot:GetAttribute("Tweening") then

                    Count += 1
                    MobRoot:SetAttribute("Tweening", true)

                    local OldTween = BringTweens[MobRoot]

                    if OldTween then
                        pcall(function()
                            OldTween:Cancel()
                        end)
                    end

                    local Tween = TweenService:Create(
                        MobRoot,
                        TweenInfoBring,
                        { CFrame = CFrame.new(TargetPosition) }
                    )

                    BringTweens[MobRoot] = Tween

                    Tween.Completed:Once(function()
                        if MobRoot and MobRoot.Parent then
                            MobRoot:SetAttribute("Tweening", false)
                        end
                        BringTweens[MobRoot] = nil
                    end)

                    Tween:Play()
                end
            end
        end
    end
end

