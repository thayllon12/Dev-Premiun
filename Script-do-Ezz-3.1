task.spawn(function()
    local id = RUN_ID
    while RUN_ID == id and not Destroyed do
        FruitScan = ScanFruits()
        FPSNow = math.floor(FrameCount * 2)
        FrameCount = 0
        for _, row in ipairs(StatusRows) do
            local ok, txt = pcall(row.fn)
            row.label.Text = ok and txt or "erro ao ler"
        end
        task.wait(0.5)
    end
end)

