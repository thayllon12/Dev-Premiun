function FormatDur(sec)
    sec = math.max(0, math.floor(sec))
    return string.format("%02d:%02d:%02d", math.floor(sec / 3600), math.floor((sec % 3600) / 60), sec % 60)
end

function EventClock()
    local t = os.date("!*t")
    local secNow = t.min * 60 + t.sec
    local endAt = CFG.EventMinutes * 60
    if secNow < endAt then return true, endAt - secNow end
    return false, 3600 - secNow
end

function PingMs()
    local ok, p = pcall(function() return Player:GetNetworkPing() end)
    if ok and type(p) == "number" then return math.floor(p * 1000) end
    return -1
end

function ScanFruits()
    local root = GetRoot()
    local out = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if string.find(string.lower(obj.Name), "fruit", 1, true) then
            local h = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
            if h and h:IsA("BasePart") then
                local d = root and math.floor((h.Position - root.Position).Magnitude) or -1
                table.insert(out, { name = obj.Name, dist = d })
            end
        end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

function CountFarmTargets()
    local n = 0
    local folder = Workspace:FindFirstChild("Enemies")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") and IsFarmNPC(m) and IsAliveModel(m) then n += 1 end
        end
    end
    return n
end

function CountPumpkins()
    local n = 0
    local folder = Workspace:FindFirstChild("PumpkinHunt")
    if folder then
        for _, obj in ipairs(folder:GetChildren()) do
            if obj.Name == "Pumpkin" and PumpkinAlive(obj) then n += 1 end
        end
    end
    return n
end

function CountDoorsReady()
    local n = 0
    local now = os.clock()
    local serverNow = ServerNow()
    for _, d in ipairs(DoorList()) do
        if not d.open and d.cool <= serverNow and d.skip <= now then n += 1 end
    end
    return n
end

