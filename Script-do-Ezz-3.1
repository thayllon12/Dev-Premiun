local function GetSavePath()
    if writefile and isfolder then
        local folder = "PumpkinHunt"
        if not isfolder(folder) then
            pcall(makefolder, folder)
        end
        return folder .. "/" .. Config.SaveFileName
    end
    return nil
end

local function SaveStates()
    local path = GetSavePath()
    if not path or not writefile then return end

    local data = {
        AutoFarm = AutoFarm,
        AutoAttack = AutoAttack,
        AutoRollStore = AutoRollStore,
        AutoHaki = AutoHaki,
        AutoBring = AutoBring,
        AutoBringFruits = AutoBringFruits,
        WalkWater = WalkWater,
        ShowESP = ShowESP,
        SelectedToolType = SelectedToolType,
        GodFPS = GodFPS,
        GamePlaceId = game.PlaceId,
        Timestamp = os.time()
    }

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if ok then
        pcall(writefile, path, encoded)
    end
end

local function LoadStates()
    local path = GetSavePath()
    if not path or not readfile or not isfile then return nil end

    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return nil end

    local ok2, content = pcall(readfile, path)
    if not ok2 or not content then return nil end

    local ok3, decoded = pcall(function()
        return HttpService:JSONDecode(content)
    end)

    if not ok3 then return nil end

    if decoded.GamePlaceId and decoded.GamePlaceId ~= game.PlaceId then
        return nil
    end

    return decoded
end

