Halloween:AddButton("Probe", {
    Title = "Probe",
    Description = "Gera PumpkinHunt_probe.txt com o estado atual",
    Icon = "search",
    ButtonTitle = "Executar",
    Callback = function()
        pcall(function()
            local L = {}
            table.insert(L, "[Pumpkin Hunt] Probe · place " .. tostring(game.PlaceId))

            local pf = Workspace:FindFirstChild("PumpkinHunt")
            local total, rare, states = 0, 0, {}
            if pf then
                for _, m in ipairs(pf:GetChildren()) do
                    total += 1
                    local st = tostring(m:GetAttribute("PumpkinState") or "Idle")
                    states[st] = (states[st] or 0) + 1
                    if m:GetAttribute("PumpkinRare") == true then rare += 1 end
                end
            end
            local st = {}
            for k, v in pairs(states) do table.insert(st, k .. "=" .. v) end
            table.insert(L, "PumpkinHunt: " .. (pf and "found" or "not found")
                .. " total " .. total .. " rare " .. rare .. " states " .. table.concat(st, ", "))

            local decor = DecorFolder()
            table.insert(L, "HalloweenDecor: " .. (decor and ("found, " .. #decor:GetChildren() .. " filhos") or "not found"))
            if decor then
                for i, inst in ipairs(decor:GetChildren()) do
                    if i > 20 then break end
                    local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
                    table.insert(L, string.format("  [%d] %s  class=%s  prompt=%s  DoorOpen=%s  Cooldown=%s",
                        i, inst.Name, inst.ClassName, tostring(prompt ~= nil),
                        tostring(inst:GetAttribute("DoorOpen")), tostring(inst:GetAttribute("CooldownUntil"))))
                end
            end

            local doors = DoorList()
            table.insert(L, "Portas disponíveis agora: " .. #doors)

            local tagged = CollectionService:GetTagged("M1HitRegistry")
            table.insert(L, "M1HitRegistry tagged: " .. #tagged)
            table.insert(L, "Estado: " .. tostring(HS.mode))
            table.insert(L, "Nota: " .. tostring(HS.note))
            table.insert(L, "Porta atual: " .. (HS.door and (HS.door.inst.Name .. " boss=" .. tostring(HS.door.boss)) or "nenhuma"))
            table.insert(L, "Domínio: " .. tostring(HS.domain ~= nil))
            table.insert(L, "Último erro: " .. tostring(HS.lastError))

            if writefile then
                pcall(writefile, "PumpkinHunt_probe.txt", table.concat(L, "\n"))
            end
        end)
    end
})

Halloween:AddButton("DumpScripts", {
    Title = "Dump Scripts",
    Description = "Salva scripts do evento em PumpkinHuntDump/",
    Icon = "file-code",
    ButtonTitle = "Dump",
    Callback = function()
        pcall(function()
            if not (writefile and getscriptbytecode) then return end
            pcall(function()
                if makefolder and not (isfolder and isfolder(Config.HalloweenDumpFolder)) then
                    makefolder(Config.HalloweenDumpFolder)
                end
            end)

            local WORDS = { "pumpkin", "lantern", "hallow", "hellrider", "hell rider", "door", "treat", "harvest" }
            local n = 0
            local roots = {
                Player:FindFirstChild("PlayerScripts"), ReplicatedStorage,
                game:GetService("ReplicatedFirst"), Player:FindFirstChild("PlayerGui"),
            }
            for _, root in ipairs(roots) do
                if root then
                    for _, s in ipairs(root:GetDescendants()) do
                        if n >= 150 then break end
                        if s:IsA("LocalScript") or s:IsA("ModuleScript") then
                            local low = string.lower(FullName(s))
                            local hit = false
                            for _, w in ipairs(WORDS) do
                                if string.find(low, w, 1, true) then hit = true break end
                            end
                            if hit then
                                local okB, bc = pcall(getscriptbytecode, s)
                                if okB and type(bc) == "string" and #bc > 0 then
                                    local file = Config.HalloweenDumpFolder .. "/"
                                        .. string.sub((string.gsub(FullName(s), "[^%w%-%._]", "_")), 1, 150)
                                    pcall(writefile, file .. ".luac", bc)
                                    n += 1
                                end
                            end
                        end
                    end
                end
            end
            HS.note = "dump: " .. n .. " scripts"
        end)
    end
})

-- =========================================================
-- CLEANUP
-- =========================================================

local function Cleanup()
    if Destroyed then return end
    SaveStates()

    Destroyed = true
    Nav = nil

    GodFarm = false
    AutoAttack = false
    AutoRollStore = false
    AutoBring = false
    AutoBringFruits = false
    AutoHaki = false
    ShowESP = false
    HalloweenDoors = false
    HalloweenBoss = false

    if GodFPS then
        RestoreGodFPS()
        GodFPS = false
    end
    if GodFPSGui then
        pcall(function() GodFPSGui:Destroy() end)
        GodFPSGui = nil
    end

    HStopWatch()
    StopFlight()
    ClearESP()

    for root, tween in pairs(BringTweens) do
        pcall(function() tween:Cancel() end)
        if root and root.Parent then root:SetAttribute("Tweening", false) end
    end
    BringTweens = {}

    for _, conn in ipairs({
        AntiAFKConnection, FlightConnection, CharacterConnection, TeleportConnection,
    }) do
        pcall(function() conn:Disconnect() end)
    end

    print("[Pumpkin Hunt] Sistema encerrado.")
end

Env.PumpkinHuntCleanup = Cleanup

