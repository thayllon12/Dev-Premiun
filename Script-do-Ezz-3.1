local RemoteCache, RemoteCacheAt = nil, 0
local function Remote(name)
    if not RemoteCache or RemoteCache[name] == nil or os.clock() - RemoteCacheAt > 3 then
        RemoteCache = GetRemotes()
        RemoteCacheAt = os.clock()
    end
    local r = RemoteCache[name]
    if r and r.Parent then return r end
    return nil
end

local function HalloweenRemotes()
    local f = ReplicatedStorage:FindFirstChild("Remotes")
    if not f then return nil, nil end
    return f:FindFirstChild("HalloweenEvent"), f:FindFirstChild("HalloweenFunction")
end

