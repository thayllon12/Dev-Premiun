function DoorList()
    local out = {}
    for d in pairs(HS.doorSet) do
        if d.Parent and d:IsDescendantOf(Workspace) then
            local prox = d:FindFirstChild("Proximity")
            if prox and prox:IsA("BasePart") then
                local pr = prox:FindFirstChildOfClass("ProximityPrompt")
                table.insert(out, {
                    inst = d,
                    pos = prox.Position,
                    prompt = pr,
                    open = d:GetAttribute("DoorOpen") == true,
                    cool = tonumber(d:GetAttribute("CooldownUntil")) or 0,
                    enabled = pr and pr.Enabled,
                    skip = HS.doorSkip[d] or 0,
                })
            end
        else
            HS.doorSet[d] = nil
        end
    end
    return out
end

function PickDoor(list, from)
    local now = os.clock()
    local serverNow = ServerNow()
    local best, bd = nil, math.huge
    for _, d in ipairs(list) do
        if not d.open and d.cool <= serverNow and d.enabled ~= false and d.skip <= now then
            local dist = (d.pos - from).Magnitude
            if dist < bd then best, bd = d, dist end
        end
    end
    return best
end

function HoldPrompt(pr)
    if fireproximityprompt then
        pcall(fireproximityprompt, pr)
        return
    end
    local d = tonumber(pr.HoldDuration) or 0
    if not pcall(function() pr:InputHoldBegin() end) then return end
    task.wait(d + 0.25)
    pcall(function() pr:InputHoldEnd() end)
end

function KnockDoor(d)
    Holding = true
    local root = GetParts()
    if not root then return end
    local out = Vector3.new(root.Position.X - d.pos.X, 0, root.Position.Z - d.pos.Z)
    if out.Magnitude < 1 then out = Vector3.new(0, 0, 1) end
    local stand = d.pos + out.Unit * CFG.KnockStand + Vector3.new(0, 1, 0)
    if (root.Position - stand).Magnitude > 4 then
        HS.mode = "INDO PARA PORTA"
        if not GoAuto(stand, 2) then
            HS.doorSkip[d.inst] = os.clock() + CFG.DoorSkip
            return
        end
    end
    FaceTo(d.pos)
    HS.door = nil
    HS.mode = "BATENDO"
    task.wait(1.25)
    local _, fn = HalloweenRemotes()
    if fn then task.spawn(function() pcall(function() fn:InvokeServer(d.inst) end) end) end
    local t0 = os.clock()
    while os.clock() - t0 < 5 and not HS.door and Engaged() do task.wait(0.1) end
    if HS.door then
        HS.tally.doors += 1
    else
        HS.doorSkip[d.inst] = os.clock() + CFG.DoorSkip
        HS.note = "porta sem resposta"
    end
end

function PortalPos()
    local d = HS.portalDoor
    if not (d and d.Parent) or os.clock() - HS.portalAt > 90 or not BossActive(d) then return nil end
    local dp = d:FindFirstChild("Part") or d:FindFirstChild("Proximity")
    local near, best = nil, 60
    for _, c in ipairs(Workspace:GetChildren()) do
        if c.Name == "comm" and c:IsA("BasePart") and dp then
            local dist = (c.Position - dp.Position).Magnitude
            if dist < best then near, best = c.Position, dist end
        end
    end
    return near or (dp and dp:IsA("BasePart") and dp.Position) or nil
end

function EnterPortal(pt)
    Holding = true
    local root = GetParts()
    if not root then return end
    if (root.Position - pt).Magnitude > 8 then
        HS.mode = "INDO AO PORTAL"
        if not GoAuto(pt + Vector3.new(0, 2, 0), 2) then return end
    end
    local r2 = GetParts()
    local start = r2 and r2.Position or pt
    HS.mode = "PORTAL HELLFIRE"
    local t0 = os.clock()
    while os.clock() - t0 < CFG.PortalWait and not HS.domain and Engaged() do
        local r3 = GetParts()
        if r3 and (r3.Position - start).Magnitude > 1000 then
            HS.domain = { at = os.clock() }
            HS.lastFight = os.clock()
        end
        task.wait(0.1)
    end
end

function ListenHalloween()
    if HS.listening then return end
    local ev = HalloweenRemotes()
    if not ev then return end
    HS.listening = true
    local id = RUN_ID
    local conn = ev.OnClientEvent:Connect(function(kind, inst, who, data)
        if RUN_ID ~= id or Destroyed then return end
        if kind == "DoorOpened" then
            local evName = type(data) == "table" and data.Event or nil
            local isBoss = (type(data) == "table" and data.Boss == true) or EventKind(evName) == "boss"
            if who == Player then
                HS.door = { inst = inst, event = evName, boss = isBoss, at = os.clock(), accepted = false, done = false }
                if isBoss then HS.tally.bosses += 1 end
            end
            if isBoss then
                HS.portalDoor = inst
                HS.portalAt = os.clock()
            end
        elseif kind == "EventFinished" then
            if HS.door and HS.door.inst == inst then HS.door.done = true end
        elseif kind == "HellfireBossDeath" then
            HS.tally.bossKills += 1
        elseif kind == "HellfireBossExit" then
            HS.domain = nil
            HS.door = nil
        elseif kind == "BossTeleportSound" then
            if os.clock() - HS.portalAt < 90 then
                HS.domain = { at = os.clock() }
                HS.lastFight = os.clock()
                if HS.door and HS.door.boss then HS.door.done = true end
            end
        elseif kind == "PromptEventTeleport" then
            if AcceptTeleport then
                task.delay(1, function() FireEvent("AcceptEventTeleport") end)
            end
        elseif kind == "PromptEventReturn" then
            task.delay(1, function() FireEvent("AcceptTeleportReturn") end)
        end
    end)
    table.insert(CONNS, conn)
end

function PressM1()
