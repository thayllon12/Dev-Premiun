local function UpdateESP()
    if not ShowESP or not Root then
        for _, data in pairs(ESPBillboards) do
            pcall(function()
                data.gui:Destroy()
            end)
        end
        ESPBillboards = {}
        return
    end

    local activeKeys = {}

    local PumpkinFolder = Workspace:FindFirstChild("PumpkinHunt")
    if PumpkinFolder then
        for _, obj in ipairs(PumpkinFolder:GetDescendants()) do
            if obj.Name == "Pumpkin" and obj.Parent then
                local part = GetPart(obj)
                if part and (GodFPS or IsVisible(obj)) then
                    local key = obj
                    activeKeys[key] = true

                    local data = ESPBillboards[key]
                    if not data or not data.gui.Parent then
                        data = CreateBillboard(part, "")
                        ESPBillboards[key] = data
                    end

                    if data then
                        local dist = math.floor((part.Position - Root.Position).Magnitude)
                        data.gui.Adornee = part
                        data.gui.Enabled = true
                        data.label.TextColor3 = Color3.fromRGB(255, 170, 0)
                        data.label.Text = "Pumpkin [" .. dist .. "]"
                    end
                end
            end
        end
    end

    local EnemyFolder = Workspace:FindFirstChild("Enemies")
    if EnemyFolder then
        for _, enemy in ipairs(EnemyFolder:GetDescendants()) do
            if enemy:IsA("Model") and enemy.Parent and IsTargetEnemy(enemy) then
                local head = GetHead(enemy)
                local hum = enemy:FindFirstChildOfClass("Humanoid")

                if head and hum and hum.Health > 0 then
                    local key = enemy
                    activeKeys[key] = true

                    local data = ESPBillboards[key]
                    if not data or not data.gui.Parent then
                        data = CreateBillboard(head, "")
                        ESPBillboards[key] = data
                    end

                    if data then
                        local dist = math.floor((head.Position - Root.Position).Magnitude)
                        data.gui.Adornee = head
                        data.gui.Enabled = true
                        data.label.TextColor3 = Color3.fromRGB(255, 60, 60)
                        data.label.Text = "Jack [" .. dist .. "] HP " .. math.floor(hum.Health)
                    end
                end
            end
        end
    end

    for key, data in pairs(ESPBillboards) do
        if not activeKeys[key] or not data.gui.Parent or not data.adornee.Parent then
            pcall(function()
                data.gui:Destroy()
            end)
            ESPBillboards[key] = nil
        end
    end
end

