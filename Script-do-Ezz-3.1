local function CreateSwitch(name, description, y)
    local Row = New("Frame", {
        Position = UDim2.fromOffset(0, y),
        Size = UDim2.new(1, 0, 0, 47),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0
    }, Content)

    Corner(Row, 8)
    Stroke(Row, Theme.Border, 0.5)

    local Accent = New("Frame", {
        Position = UDim2.fromOffset(0, 9),
        Size = UDim2.fromOffset(2, 29),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, Row)

    Corner(Accent, 3)

    local Name = Label(
        Row,
        name,
        11,
        UDim2.fromOffset(12, 7),
        Theme.Text,
        Enum.Font.GothamSemibold
    )
    Name.Size = UDim2.fromOffset(235, 16)

    local Desc = Label(
        Row,
        description,
        8,
        UDim2.fromOffset(12, 24),
        Theme.Muted,
        Enum.Font.Gotham
    )
    Desc.Size = UDim2.fromOffset(250, 13)

    local Switch = New("TextButton", {
        Position = UDim2.new(1, -53, 0.5, -11),
        Size = UDim2.fromOffset(39, 22),
        BackgroundColor3 = Color3.fromRGB(57, 58, 65),
        Text = "",
        AutoButtonColor = false
    }, Row)

    Corner(Switch, 20)

    local Knob = New("Frame", {
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Color3.fromRGB(230, 230, 235),
        BorderSizePixel = 0
    }, Switch)

    Corner(Knob, 20)

    local Enabled = false
    local Changed = Instance.new("BindableEvent")

    local function Set(value)
        Enabled = value

        Tween(Switch, 0.2, {
            BackgroundColor3 = Enabled
                and Theme.Accent
                or Color3.fromRGB(57, 58, 65)
        })

        Tween(Knob, 0.2, {
            Position = Enabled
                and UDim2.fromOffset(20, 3)
                or UDim2.fromOffset(3, 3),
            BackgroundColor3 = Enabled
                and Color3.new(1, 1, 1)
                or Color3.fromRGB(230, 230, 235)
        })

        Tween(Accent, 0.2, {
            BackgroundTransparency = Enabled and 0 or 1
        })

        Tween(Row, 0.2, {
            BackgroundColor3 = Enabled
                and Color3.fromRGB(34, 30, 29)
                or Theme.Surface
        })

        Changed:Fire(Enabled)
    end

    Switch.MouseButton1Click:Connect(function()
        Set(not Enabled)
    end)

    Row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Set(not Enabled)
        end
    end)

    return {
        Set = Set,
        Get = function()
            return Enabled
        end,
        Changed = Changed
    }
end

