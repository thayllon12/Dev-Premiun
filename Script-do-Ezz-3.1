local ESPBillboards = {}

local function CreateBillboard(adornee)
    local gui = Instance.new("BillboardGui")
    gui.Name = "PumpkinESP"
    gui.Adornee = adornee
    gui.Size = UDim2.new(0, 200, 0, 50)
    gui.StudsOffset = Vector3.new(0, 3, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 2000
    gui.Parent = adornee

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Text = ""
    label.Parent = gui

    return { gui = gui, label = label, adornee = adornee }
end

local function ClearESP()
    for _, data in pairs(ESPBillboards) do
        pcall(function() data.gui:Destroy() end)
    end
    ESPBillboards = {}
end

local function UpdateESP()
    if not ShowESP or not Root then
        ClearESP()
        return
    end

    local active = {}

    local function show(key, part, text, color)
        active[key] = true
        local data = ESPBillboards[key]
        if not data or not data.gui.Parent then
            data = CreateBillboard(part)
            ESPBillboards[key] = data
        end
        data.gui.Adornee = part
        data.label.TextColor3 = color
        data.label.Text = text
    end

    local pf = Workspace:FindFirstChild("PumpkinHunt")
    if pf then
        for _, obj in ipairs(pf:GetChildren()) do
            local p = PartOf(obj)
            if p and (GodFPS or IsVisible(obj)) then
                local dist = math.floor((p.Position - Root.Position).Magnitude)
                show(obj, p, "Pumpkin [" .. dist .. "]", Color3.fromRGB(255, 170, 0))
            end
        end
    end

    local ef = Workspace:FindFirstChild("Enemies")
    if ef then
        for _, m in ipairs(ef:GetChildren()) do
            if m:IsA("Model") and IsAlive(m) then
                local p = PartOf(m)
                local h = m:FindFirstChildOfClass("Humanoid")
                if p and h then
                    local dist = math.floor((p.Position - Root.Position).Magnitude)
                    show(m, p, m.Name .. " [" .. dist .. "] HP " .. math.floor(h.Health), Color3.fromRGB(255, 60, 60))
                end
            end
        end
    end

    for key, data in pairs(ESPBillboards) do
        if not active[key] or not data.gui.Parent or not data.adornee.Parent then
            pcall(function() data.gui:Destroy() end)
            ESPBillboards[key] = nil
        end
    end
end

task.spawn(function()
    while not Destroyed do
        pcall(UpdateESP)
        task.wait(0.35)
    end
end)

-- =========================================================
-- GRAVADOR (debug)
-- =========================================================

local HWatch = { on = false, lines = {}, conns = {}, t0 = 0, n = 0 }

local function HLog(text)
    table.insert(HWatch.lines, string.format("%8.2f  %s", os.clock() - HWatch.t0, text))
    if #HWatch.lines > 4000 then table.remove(HWatch.lines, 1) end
    HWatch.n += 1
end

local function HFlush()
    if not writefile then return end
    local head = string.format("[Pumpkin Hunt] Halloween recorder  ·  started %s  ·  place %s",
        tostring(HWatch.started), tostring(game.PlaceId))
    pcall(writefile, "PumpkinHunt_halloween_watch.txt",
        table.concat({ head, "", table.concat(HWatch.lines, "\n") }, "\n"))
end

local function HStartWatch()
    if HWatch.on then return end
    HWatch.on = true
    HWatch.t0 = os.clock()
    HWatch.lines = {}
    HWatch.n = 0
    HWatch.started = os.date("!%Y-%m-%d %H:%M:%SZ")

    local ev = HalloweenRemotes()
    if ev then
        local conn
        conn = ev.OnClientEvent:Connect(function(...)
            if Destroyed or not HWatch.on then
                if conn then conn:Disconnect() end
                return
            end
            local ps = {}
            for i = 1, select("#", ...) do
                local x = select(i, ...)
                ps[i] = (typeof(x) == "Instance") and FullName(x) or tostring(x)
            end
            HLog("event: " .. table.concat(ps, " | "))
        end)
        table.insert(HWatch.conns, conn)
    end

    local function every3()
        if HWatch.on and not Destroyed then
            HFlush()
            task.delay(3, every3)
        end
    end
    task.delay(3, every3)
end

local function HStopWatch()
    if not HWatch.on then return end
    HWatch.on = false
    for _, c in ipairs(HWatch.conns) do pcall(function() c:Disconnect() end) end
    HWatch.conns = {}
    HLog("stop")
    HFlush()
end

