-- TARGET SYSTEM

local function GetPart(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChild("HumanoidRootPart", true)
            or object:FindFirstChild("Head", true)
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function GetHead(model)
    local head = model and model:FindFirstChild("Head", true)

    if head and head:IsA("BasePart") then
        return head
    end

    return GetPart(model)
end

local function IsAlive(model)
    local h = model and model:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function IsTargetEnemy(enemy)
    if not enemy or not enemy:IsA("Model") then
        return false
    end

    local name = string.lower(enemy.Name):gsub("[%s%p_]+", "")

    return name:find("jack") ~= nil
        or name:find("pumpkin") ~= nil
        or name:find("lantern") ~= nil
end

local function IsVisible(object)
    if not object or not object.Parent then
        return false
    end

    if object:IsA("BasePart") then
        return object.Transparency < 0.98
            and object.LocalTransparencyModifier < 0.98
    end

    for _, v in ipairs(object:GetDescendants()) do
        if v:IsA("BasePart")
        and v.Transparency < 0.98
        and v.LocalTransparencyModifier < 0.98 then
            return true
        end
    end

    return false
end

local function GetNearestNPC()
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder or not Root then return nil end

    local nearest
    local shortest = math.huge

    for _, enemy in ipairs(folder:GetDescendants()) do
        if enemy:IsA("Model")
        and enemy.Parent
        and IsTargetEnemy(enemy)
        and not DeadNPCs[enemy]
        and IsAlive(enemy) then

            local part = GetHead(enemy)

            if part then
                local distance = (part.Position - Root.Position).Magnitude

                if distance < shortest then
                    shortest = distance
                    nearest = enemy
                end
            end
        end
    end

    return nearest
end

local function GetNearestPumpkin()
    local folder = Workspace:FindFirstChild("PumpkinHunt")
    if not folder or not Root then return nil end

    local nearest
    local shortest = math.huge

    for _, object in ipairs(folder:GetDescendants()) do
        if object.Name == "Pumpkin"
        and object.Parent
        and not HiddenPumpkins[object]
        and IsVisible(object) then

            local part = GetPart(object)

            if part then
                local distance = (part.Position - Root.Position).Magnitude

                if distance < shortest then
                    shortest = distance
                    nearest = object
                end
            end
        end
    end

    return nearest
end

local function SelectTarget()
    local npc = GetNearestNPC()

    if npc then
        TargetNPC = npc
        TargetPumpkin = nil
        CurrentTarget = npc
        CurrentMode = "NPC"
        return
    end

    TargetNPC = nil
    TargetPumpkin = GetNearestPumpkin()

    if TargetPumpkin then
        CurrentTarget = TargetPumpkin
        CurrentMode = "PUMPKIN"
    else
        CurrentTarget = nil
        CurrentMode = "SEARCH"
    end
end

-- FLIGHT

local function StartFlight()
    UpdateCharacter()

    if not Root or not Humanoid or not Character then
        return false
    end

    if BodyVelocity and BodyVelocity.Parent then
        return true
    end

    OriginalAutoRotate = Humanoid.AutoRotate
    OriginalPlatformStand = Humanoid.PlatformStand
    OriginalSeatedState = Humanoid:GetStateEnabled(Enum.HumanoidStateType.Seated)

    Humanoid.AutoRotate = false
    Humanoid.PlatformStand = true

    pcall(function()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    end)

    BodyVelocity = New("BodyVelocity", {
        Name = "PumpkinBodyVelocity",
        MaxForce = Vector3.new(1e9, 1e9, 1e9),
        P = 50000,
        Velocity = Vector3.zero
    }, Root)

    BodyGyro = New("BodyGyro", {
        Name = "PumpkinBodyGyro",
        MaxTorque = Vector3.new(1e9, 1e9, 1e9),
        P = 50000,
        D = 1500,
        CFrame = Root.CFrame
    }, Root)

    OriginalCollisions = {}

    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            OriginalCollisions[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    NoclipConnection = RunService.Stepped:Connect(function()
        if not AutoFarm or not Character then return end

        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)

    return true
end

local function StopFlight()
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if BodyVelocity then
        BodyVelocity:Destroy()
        BodyVelocity = nil
    end

    if BodyGyro then
        BodyGyro:Destroy()
        BodyGyro = nil
    end

    for part, old in pairs(OriginalCollisions) do
        if part and part.Parent then
            part.CanCollide = old
        end
    end

    OriginalCollisions = {}

    UpdateCharacter()

    if Root then
        Root.AssemblyLinearVelocity = Vector3.zero
    end

    if Humanoid then
        Humanoid.PlatformStand = OriginalPlatformStand or false
        Humanoid.AutoRotate = OriginalAutoRotate == nil and true or OriginalAutoRotate

        pcall(function()
            Humanoid:SetStateEnabled(
                Enum.HumanoidStateType.Seated,
                OriginalSeatedState ~= false
            )
        end)

        Humanoid.Sit = false
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function AttackTarget(target, part)
    if not AttackRemotesReady then return false end
    if not target or not target.Parent or not part or not part.Parent then
        return false
    end

    local now = os.clock()
    if now - LastAttack < Config.AttackDelay then
        return false
    end

    LastAttack = now

    local success = pcall(function()
        RegisterAttack:FireServer(0)
        RegisterHit:FireServer(part, {
            {target, part}
        })
    end)

    if success then
        AttackCount += 1
        return true
    end

    return false
end

