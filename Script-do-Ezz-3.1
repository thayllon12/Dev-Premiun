local function Cleanup()
    if Destroyed then return end

    SaveStates()

    Destroyed = true

    AutoFarm = false
    AutoAttack = false
    AutoRollStore = false
    AutoBring = false
    AutoBringFruits = false
    AutoHaki = false
    ShowESP = false

    if GodFPS then
        RestoreGodFPS()
        GodFPS = false
    end

    if GodFPSGui then
        pcall(function()
            GodFPSGui:Destroy()
        end)
        GodFPSGui = nil
    end

    StopFlight()

    for _, data in pairs(ESPBillboards) do
        pcall(function()
            data.gui:Destroy()
        end)
    end
    ESPBillboards = {}

    for root, tween in pairs(BringTweens) do
        pcall(function()
            tween:Cancel()
        end)

        if root and root.Parent then
            root:SetAttribute("Tweening", false)
        end
    end

    table.clear(BringTweens)

    if AntiAFKConnection then
        AntiAFKConnection:Disconnect()
        AntiAFKConnection = nil
    end

    if FlightConnection then
        FlightConnection:Disconnect()
        FlightConnection = nil
    end

    if CharacterConnection then
        CharacterConnection:Disconnect()
        CharacterConnection = nil
    end

    if HakiConnection then
        HakiConnection:Disconnect()
        HakiConnection = nil
    end

    if WatchdogConnection then
        WatchdogConnection:Disconnect()
        WatchdogConnection = nil
    end

    if ToolConnection then
        ToolConnection:Disconnect()
        ToolConnection = nil
    end

    print("[Pumpkin Hunt] Sistema encerrado.")
end

Env.PumpkinHuntCleanup = Cleanup
