BodyHeartConn = RunService.Heartbeat:Connect(function(dt)
    if Destroyed or not Holding then return end
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    hum.AutoRotate = false
    if not LockCF then
        LockCF = root.CFrame
    elseif LastWritten and (root.Position - LastWritten).Magnitude > 50 then
        LockCF = root.CFrame
    end
    if Travel then
        local cur = LockCF.Position
        local diff = Travel - cur
        local d = diff.Magnitude
        if d <= 0.5 then
            Travel = nil
        else
            local np = cur + diff.Unit * math.min(d, CFG.Speed * dt)
            local flat = Vector3.new(diff.X, 0, diff.Z)
            if flat.Magnitude > 0.1 then
                LockCF = CFrame.lookAt(np, np + flat)
            else
                LockCF = CFrame.new(np)
            end
        end
    end
    local pos = LockCF.Position
    local fy = WaterFloor(pos)
    if fy and pos.Y < fy then
        LockCF = LockCF + Vector3.new(0, fy - pos.Y, 0)
    end
    root.CFrame = LockCF
    LastWritten = LockCF.Position
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end)
table.insert(CONNS, BodyHeartConn)

function Release()
    Holding = false
    Travel = nil
    LockCF = nil
    LastWritten = nil
    for part, was in pairs(SavedCollide) do
        if part.Parent then pcall(function() part.CanCollide = was end) end
    end
    SavedCollide = {}
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.AutoRotate = true end) end
end

function GoTo(pos, stop, timeout, abort)
    Holding = true
    stop = stop or 3
    timeout = timeout or 15
    local root = GetParts()
    if not root then return false end
    if not LockCF then LockCF = root.CFrame end
    local fy = WaterFloor(pos)
    if fy and pos.Y < fy then pos = Vector3.new(pos.X, fy, pos.Z) end
    local t0 = os.clock()
    while not Destroyed and Holding do
        if not LockCF then break end
        if (LockCF.Position - pos).Magnitude <= stop then break end
        if os.clock() - t0 > timeout then break end
        if abort and abort() then break end
        if not GetParts() then break end
        Travel = pos
        task.wait(0.05)
    end
    local ok = LockCF ~= nil and (LockCF.Position - pos).Magnitude <= stop + 2
    Travel = nil
    return ok
end

function GoAuto(pos, stop, abort)
    local root = GetParts()
    local d = root and (root.Position - pos).Magnitude or 0
    return GoTo(pos, stop, math.max(12, d / CFG.Speed + 6), abort)
end

function TryActivateHaki()
    local root, hum = GetParts()
    if not root or not hum then return end
    local char = Player.Character
    if not char or char:FindFirstChild("HasBuso") then return end
    local cf = CommFRemote()
    if cf then pcall(function() cf:InvokeServer("Buso") end) end
end

function NearestTarget(maxDist)
    local folder = Workspace:FindFirstChild("Enemies")
    local root = GetParts()
    if not folder or not root then return nil end
    local ev = EventOn()
    local inDomain = HS.domain ~= nil
    local bestF, bdF = nil, maxDist
    local bestO, bdO = nil, maxDist
    local now = os.clock()
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and (HS.ignored[m] or 0) < now and IsAliveModel(m) and AnyVisible(m) then
            local p = PartOf(m)
            if p then
                local d = (p.Position - root.Position).Magnitude
                if inDomain or IsFocus(m) then
                    if d < bdF then bestF, bdF = m, d end
                elseif ev and (not HellfireGasOnly or IsHellfireGas(m)) then
                    if d < bdO then bestO, bdO = m, d end
                end
            end
        end
    end
    if bestF then return bestF end
    return bestO
end

function HitMobs(m, root)
    local ra = NetRemote("RegisterAttack")
    local rh = NetRemote("RegisterHit")
    if not ra or not rh then return false end
    local head = m:FindFirstChild("Head") or root
    pcall(function() ra:FireServer(0) end)
    if HitVariant == "new" then
        pcall(function() rh:FireServer(head, { { m, root }, m }, nil, "078da341") end)
    else
        pcall(function() rh:FireServer(head, { { m, head } }) end)
    end
    return true
end

function FightEnemy(m)
    Holding = true
    local hum = m:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    HS.target = m
    HS.lastFight = os.clock()
    local t0 = os.clock()
    local hpSeen = hum.Health
    local swings, lands = 0, 0
    while not Destroyed and Engaged() and m.Parent and hum.Health > 0 and AnyVisible(m) do
        if os.clock() - t0 > CFG.EnemyTimeout then
            HS.ignored[m] = os.clock() + CFG.EnemyIgnoreTime
            break
        end
        local root = GetParts()
        local part = PartOf(m)
        if not root or not part then break end
        local hover = part.Position + Vector3.new(0, CFG.HoverHeight, 0)
        Travel = hover
        HS.lastFight = os.clock()
        if LockCF and (LockCF.Position - hover).Magnitude <= 4 then
            FaceTo(part.Position)
            if (LockCF.Position - part.Position).Magnitude <= CFG.HitRange then
                EnsureTool()
                HitMobs(m, m:FindFirstChild("HumanoidRootPart") or part)
                swings += 1
                if hum.Health < hpSeen then
                    lands += 1
                    hpSeen = hum.Health
                elseif hum.Health > hpSeen then
                    hpSeen = hum.Health
                end
                if swings >= 10 then
                    if lands == 0 and AutoHitVariant then
                        HitVariant = (HitVariant == "new") and "old" or "new"
                        HS.note = "trocando formato do hit para " .. HitVariant
                    end
                    swings, lands = 0, 0
                end
            end
        end
        task.wait(CFG.AttackDelay)
    end
    if hum.Health <= 0 or not m.Parent then
        HS.tally.kills += 1
    end
    HS.target = nil
    Travel = nil
end

