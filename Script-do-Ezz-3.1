local function UpdStFruit()
    local Backpack = Player:FindFirstChild("Backpack")
    if not Backpack then return end

    Remotes = GetRemotes()

    for _, item in ipairs(Backpack:GetChildren()) do
        if Destroyed then break end

        local EatRemote = item:FindFirstChild("EatRemote", true)

        if EatRemote then
            local parent = EatRemote.Parent
            local OriginalName = parent and parent:GetAttribute("OriginalName")
            local FruitTool = Backpack:FindFirstChild(item.Name)

            if OriginalName and FruitTool and Remotes.CommF then
                pcall(function()
                    Remotes.CommF:InvokeServer(
                        "StoreFruit",
                        OriginalName,
                        FruitTool
                    )
                end)
            end
        end
    end
end

