    kinds = {},
    skip = setmetatable({}, { __mode = "k" }),
    tally = { pumpkins = 0, doors = 0, bosses = 0, rare = 0 },
    tpTried = {},
    way = nil,
    mode = "OFF",
    note = "",
    lastError = nil,
}

local HalloweenSaved = {}
pcall(function()
    if isfile and isfile(Config.HalloweenSaveFile) then
        local t = HttpService:JSONDecode(readfile(Config.HalloweenSaveFile))
        if type(t) == "table" then HalloweenSaved = t end
    end
end)
if type(HalloweenSaved.way) == "string" then HS.way = HalloweenSaved.way end

local function SaveHalloween()
    pcall(function()
        if writefile then writefile(Config.HalloweenSaveFile, HttpService:JSONEncode(HalloweenSaved)) end
    end)
end

local function CollectPumpkins()
    local folder = Workspace:FindFirstChild("PumpkinHunt")
    local out = {}
    if not folder then return out end

    local now = os.clock()

    for _, m in ipairs(folder:GetChildren()) do
        local state = m:GetAttribute("PumpkinState")
        local isPumpkin = m.Name == "Pumpkin" or PumpkinName(m.Name) or state ~= nil

        if isPumpkin and (m:IsA("Model") or m:IsA("BasePart"))
            and IdleState(state) and now >= (HS.skip[m] or 0) then

            local hits, body, bv, prompt, detector = {}, nil, -1, nil, nil
            local scan = m:IsA("BasePart") and { m } or m:GetDescendants()

            for _, d in ipairs(scan) do
                if d:IsA("BasePart") and (GodFPS or d.Transparency < 0.99) then
                    if HasM1Tag(d) then table.insert(hits, d) end
                    local v = d.Size.X * d.Size.Y * d.Size.Z
                    if v > bv then body, bv = d, v end
                elseif not prompt and d:IsA("ProximityPrompt") and d.Enabled then
                    prompt = d
                elseif not detector and d:IsA("ClickDetector") then
                    detector = d
                end
            end

            if body and body.Position.Y > -50 and (GodFPS or IsVisible(body)) then
                local kind = VariantName((hits[1] or body).Name)
                local k = HS.kinds[kind]
                local dropped = k ~= nil and k.tries >= 2 and k.broke == 0
                if not dropped then
                    table.insert(out, {
                        root = m,
                        part = hits[1] or body,
                        hits = hits,
                        kind = kind,
                        pos = body.Position,
                        prompt = prompt,
                        detector = detector,
                        tagged = #hits > 0,
                        rare = m:GetAttribute("PumpkinRare") == true,
                    })
                end
            end
        end
    end

    return out
end

local function PickPumpkin(list, from, within, rareFirst)
    local best, bd, br = nil, math.huge, false
    for _, c in ipairs(list) do
        local d = (c.pos - from).Magnitude
        local rare = rareFirst and c.rare == true
        if rare or not within or d <= within then
            if (rare and not br) or (rare == br and d < bd) then
                best, bd, br = c, d, rare
            end
        end
    end
    return best
end

local function HalloweenAlive(c)
    local m = c.root
    if not m.Parent or not m:IsDescendantOf(Workspace) then return false end
    if not c.rare and not IdleState(m:GetAttribute("PumpkinState")) then return false end

    if c.tagged then
        for _, p in ipairs(c.hits) do
            if p.Parent and HasM1Tag(p) and (GodFPS or p.Transparency < 0.99) then return true end
        end
        return false
    end

    return c.part.Parent ~= nil and (GodFPS or c.part.Transparency < 0.99)
end

local function HSnap(c)
    local t = {}
    pcall(function()
        for key, v in pairs(c.root:GetAttributes()) do t["r." .. key] = v end
        if c.part ~= c.root then
            for key, v in pairs(c.part:GetAttributes()) do t["p." .. key] = v end
        end
    end)
    return t
end

local function HChanged(a, b)
    for key, v in pairs(a) do if b[key] ~= v then return true end end
    for key in pairs(b) do if a[key] == nil then return true end end
    return false
end

local function WayOrder(c, learned)
    local out, seen = {}, {}
    local function add(w)
        if not seen[w] then
            seen[w] = true
            table.insert(out, w)
        end
    end
    if c.prompt then add("prompt") end
    if c.detector then add("detector") end
    if learned then add(learned) end
    if #c.hits > 0 then add("remote") end
    add("click")
    add("remote")
    return out
end

local function HoldPrompt(pr)
    if fireproximityprompt then
        pcall(fireproximityprompt, pr)
        return
    end
    local d = tonumber(pr.HoldDuration) or 0
    if not pcall(function() pr:InputHoldBegin() end) then return end
    task.wait(d + 0.25)
    pcall(function() pr:InputHoldEnd() end)
end

local function FireWay(way, c)
    if way == "prompt" and c.prompt then
        HoldPrompt(c.prompt)
    elseif way == "detector" and c.detector then
        if fireclickdetector then pcall(fireclickdetector, c.detector) end
    elseif way == "remote" then
        local hits = (#c.hits > 0) and c.hits or { c.part }
        for _, p in ipairs(hits) do
            if p and p.Parent then AttackTarget(c.root, p) end
        end
    else
        EnsureTool()
    end
end

-- Interrompe movimento/loops quando o combate precisa ter prioridade
local function Interrupted()
    if not Engaged() then return true end
    return NearestEnemy(250) ~= nil
end

local function SmashPumpkin(c)
    UpdateCharacter()
    if not Root then return end

    local away = Vector3.new(Root.Position.X - c.pos.X, 0, Root.Position.Z - c.pos.Z)
    if away.Magnitude < 1 then away = Vector3.new(1, 0, 0) end
    local stand = c.pos + away.Unit * 4 + Vector3.new(0, 1.5, 0)

    if (Root.Position - stand).Magnitude > 6 then
        HS.mode = "INDO ABÓBORA"
        if not GoTo(stand, 3, 12, Interrupted) then return end
    end

    if Interrupted() or not HalloweenAlive(c) then return end

    HS.mode = "ABÓBORA"
    EnsureTool()

    local k = HS.kinds[c.kind] or { tries = 0, broke = 0 }
    HS.kinds[c.kind] = k
    local base = HSnap(c)

    for _, way in ipairs(WayOrder(c, HS.way)) do
        local budget, n = Config.HalloweenPerWay, 0

        while n < budget do
            n += 1
            if Interrupted() then return end

            if not HalloweenAlive(c) then
                local t0 = os.clock()
                while os.clock() - t0 < 2 and not HalloweenAlive(c) do task.wait(0.1) end

                if not HalloweenAlive(c) then
                    k.broke += 1
                    HS.tally.pumpkins += 1
                    if c.rare then HS.tally.rare += 1 end
                    HS.skip[c.root] = os.clock() + 20
                    if HS.way ~= way then
                        HS.way = way
                        HalloweenSaved.way = way
                        SaveHalloween()
                    end
                    return
                end
            end

            FireWay(way, c)
            task.wait(Config.HalloweenSwing)

            if budget == Config.HalloweenPerWay and HChanged(base, HSnap(c)) then
                budget = Config.HalloweenPerWay * 6
            end
        end
    end

    k.tries += 1
    HS.skip[c.root] = os.clock() + 180
end

-- =========================================================
-- HALLOWEEN: PORTAS
-- =========================================================

local function PivotPos(inst)
    if not inst then return nil end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    if inst:IsA("BasePart") then return inst.Position end
    return nil
end

local function DecorFolder()
    local map = Workspace:FindFirstChild("Map")
    local town = map and map:FindFirstChild("Town")
    return town and town:FindFirstChild("HalloweenDecor")
end

-- Lista as portas disponíveis agora.
-- Prioriza filhos com atributos/prompt de porta; se nada for encontrado,
-- usa os filhos de HalloweenDecor (é de onde vêm as portas nos seus logs).
local function DoorList()
    local decor = DecorFolder()
    if not decor then return {} end

    local now = os.clock()
    local serverNow = ServerNow()
    local list, fallback = {}, {}

    for _, inst in ipairs(decor:GetChildren()) do
        local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        local pos = nil
        if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
            pos = prompt.Parent.Position
        else
            pos = PivotPos(inst)
        end

        if pos and (HS.doorFail[inst] or 0) <= now then
            local isOpen = inst:GetAttribute("DoorOpen") == true
            local cool = tonumber(inst:GetAttribute("CooldownUntil")) or 0
            local hasDoorAttr = inst:GetAttribute("DoorOpen") ~= nil or cool > 0

            if hasDoorAttr or prompt then
                if not isOpen and cool <= serverNow and (not prompt or prompt.Enabled) then
                    table.insert(list, { inst = inst, pos = pos, prompt = prompt })
                end
            else
                table.insert(fallback, { inst = inst, pos = pos, prompt = nil })
            end
        end
    end

    if #list == 0 then
        return fallback
    end
    return list
end

local function PickNearest(list, from)
    local best, bd = nil, math.huge
    for _, d in ipairs(list) do
        local dist = (d.pos - from).Magnitude
        if dist < bd then best, bd = d, dist end
    end
    return best
end

local function KnockDoor(d)
    UpdateCharacter()
    if not Root then return end

    local away = Vector3.new(Root.Position.X - d.pos.X, 0, Root.Position.Z - d.pos.Z)
    if away.Magnitude < 1 then away = Vector3.new(0, 0, 1) end
    local stand = d.pos + away.Unit * 4 + Vector3.new(0, 2, 0)

    if (Root.Position - stand).Magnitude > 4 then
        HS.mode = "INDO PARA PORTA"
        if not GoTo(stand, 2, 15, Interrupted) then return end
    end
    if Interrupted() then return end

    HS.mode = "BATENDO"
    HS.door = nil

    local _, fn = HalloweenRemotes()
    if fn then
        task.spawn(function()
            pcall(function() fn:InvokeServer(d.inst) end)
        end)
    elseif d.prompt and fireproximityprompt then
        pcall(fireproximityprompt, d.prompt)
    end

    local t0 = os.clock()
    while not Destroyed and not HS.door and os.clock() - t0 < Config.DoorWait do
        task.wait(0.1)
    end

    if not HS.door then
        HS.doorFail[d.inst] = os.clock() + Config.DoorFailTime
        HS.note = "porta sem resposta: " .. d.inst.Name
    end
end

-- =========================================================
-- HALLOWEEN: PORTAL DO BOSS
-- =========================================================

local function EnterPortal(dr)
    if not dr.entered then
        local pos = PivotPos(dr.inst)
        if not pos then
            dr.done = true
            return
        end

        dr.tries = (dr.tries or 0) + 1
        if dr.tries > 4 then
            dr.done = true
            HS.note = "portal: não consegui entrar"
            return
        end

        if not GoTo(pos + Vector3.new(0, 2, 0), 2, 15, Interrupted) then return end

        local prompt = dr.inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and fireproximityprompt then pcall(fireproximityprompt, prompt) end

        dr.entered = true
        dr.enterAt = os.clock()
        return
    end

    if HS.domain then
        HS.mode = "DOMÍNIO"
        task.wait(0.25)
        return
    end

    if os.clock() - dr.enterAt > Config.PortalWait then
        dr.entered = false
        dr.tries = (dr.tries or 0)
    end
    task.wait(0.25)
end

-- =========================================================
-- HALLOWEEN: EVENTOS (DoorOpened, EventFinished, Domínio)
-- =========================================================

local function EventKind(ev)
    if type(ev) ~= "string" then return "game" end
    local low = string.lower(ev)
    if ev == "Boss Fight" or string.find(low, "hell", 1, true) then return "boss" end
    if string.find(low, "treat", 1, true) then return "treat" end
    if string.find(low, "attack", 1, true) or string.find(low, "fight", 1, true) then return "fight" end
    return "game"
end

local HalloweenListening = false

local function ListenHalloween()
    if HalloweenListening then return end
    local ev = HalloweenRemotes()
    if not ev then return end
    HalloweenListening = true

    ev.OnClientEvent:Connect(function(kind, inst, who, data)
        if Destroyed then return end

        if kind == "DoorOpened" then
            local evName = type(data) == "table" and data.Event or nil
            local isBoss = (type(data) == "table" and data.Boss == true) or EventKind(evName) == "boss"

            if who == Player then
                HS.door = {
                    inst = inst,
                    event = evName,
                    boss = isBoss,
                    at = os.clock(),
                    accepted = false,
                    done = false,
                }
                if isBoss then
                    HS.tally.bosses += 1
                else
                    HS.tally.doors += 1
                end
            end

        elseif kind == "EventFinished" then
            if HS.door and HS.door.inst == inst then
                HS.door.done = true
            end

        elseif kind == "BossTeleportSound" then
            HS.domain = { at = os.clock() }
            HS.lastFight = os.clock()
            if HS.door and HS.door.boss then HS.door.done = true end

        elseif kind == "PromptEventTeleport" then
            if HalloweenOn() then
                task.delay(1, function() FireEvent("AcceptEventTeleport") end)
            end

        elseif kind == "PromptEventReturn" then
            task.delay(1, function() FireEvent("AcceptTeleportReturn") end)
        end
    end)
end

-- =========================================================
-- MÁQUINA PRINCIPAL
-- =========================================================

local function Step()
    UpdateCharacter()

    if not Engaged() then
        HS.mode = "OFF"
        if Flight.body then StopFlight() end
        task.wait(0.5)
        return
    end

    ListenHalloween()

    if not Root or not Humanoid or Humanoid.Health <= 0 then
        HS.mode = "SEM PERSONAGEM"
        Nav = nil
        task.wait(0.5)
        return
    end

    -- 0) Domínio do boss expirou sem combate?
    if HS.domain and os.clock() - math.max(HS.domain.at, HS.lastFight) > Config.DomainTimeout then
        HS.domain = nil
    end

    -- 1) COMBATE: qualquer inimigo vivo perto tem prioridade
    local maxDist = Config.EnemySearch
    if HS.domain then maxDist = 2000 end
    if not FlyMode() then maxDist = Config.AttackRadius end

    local enemy = NearestEnemy(maxDist)
    if enemy then
        HS.mode = "COMBATE"
        HS.lastFight = os.clock()
        FightEnemy(enemy)
        return
    end

    -- 2) EVENTO DE PORTA EM ANDAMENTO
    local dr = HS.door
    if dr and not dr.done then
        if os.clock() - dr.at > Config.DoorMaxEvent then
            dr.done = true
        elseif dr.boss then
            if HalloweenBoss then
                HS.mode = "PORTAL"
                EnterPortal(dr)
                return
            end
            dr.done = true
        else
            HS.mode = "EVENTO"
            if not dr.accepted and os.clock() - dr.at > 1.5 then
                dr.accepted = true
                FireEvent("AcceptReward")
            end
            task.wait(0.25)
            return
        end
    end

    -- 3) DOMÍNIO ATIVO: espera os inimigos aparecerem
    if HS.domain then
        HS.mode = "DOMÍNIO"
        task.wait(0.25)
        return
    end

    -- 4) PORTAS (quando existirem e estiverem disponíveis)
    if HalloweenDoors then
        local list = DoorList()
        local d = PickNearest(list, Root.Position)
        if d then
            KnockDoor(d)
            return
        end
    end

    -- 5) GOD FARM: abóboras (inclui Jack e abóboras raras)
    if GodFarm then
        local c = PickPumpkin(CollectPumpkins(), Root.Position, Config.PumpkinSearch, HalloweenRareFirst)
        if c then
            SmashPumpkin(c)
            return
        end
    end

    -- 6) NADA A FAZER: fica parado, sem voo, sem travar o personagem
    HS.mode = "ESPERANDO"
    if Flight.body and not Nav then StopFlight() end
    task.wait(Config.IdleWait)
end

task.spawn(function()
    while not Destroyed do
        local ok, err = pcall(Step)
        if not ok then
            HS.lastError = tostring(err)
            warn("[Pumpkin Hunt] " .. HS.lastError)
            task.wait(0.5)
        end
        task.wait(Config.LoopInterval)
    end
end)

