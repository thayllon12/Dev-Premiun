task.spawn(function()
    local id = RUN_ID
    while RUN_ID == id and not Destroyed do
        if not GodFPS then
            pcall(function()
                local map = Workspace:FindFirstChild("Map")
                local water = map and map:FindFirstChild("WaterBase-Plane")
                if water and water:IsA("BasePart") then
                    water.Size = WalkWater and Vector3.new(1000, 112, 1000) or Vector3.new(1000, 80, 1000)
                end
            end)
        end
        task.wait(1)
    end
end)

task.spawn(function()
    local id = RUN_ID
    while RUN_ID == id and not Destroyed do
        pcall(UpdateESP)
        task.wait(0.35)
    end
end)

