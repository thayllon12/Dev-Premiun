local function ApplyGodFPS()
    CreateGodFPSOverlay()

    if GodFPSGui then
        local frame = GodFPSGui:FindFirstChildOfClass("Frame")
        if frame then
            frame.BackgroundTransparency = 0
        end
    end

    GodFPSOriginals = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            GodFPSOriginals[obj] = {
                Transparency = obj.Transparency,
                LocalTransparencyModifier = obj.LocalTransparencyModifier
            }
            obj.Transparency = 1
            obj.LocalTransparencyModifier = 1
        elseif obj:IsA("Decal") then
            GodFPSOriginals[obj] = { Transparency = obj.Transparency }
            obj.Transparency = 1
        elseif obj:IsA("Texture") then
            GodFPSOriginals[obj] = { Transparency = obj.Transparency }
            obj.Transparency = 1
        elseif obj:IsA("ParticleEmitter") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        elseif obj:IsA("Trail") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        elseif obj:IsA("Smoke") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        elseif obj:IsA("Fire") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        elseif obj:IsA("Sparkles") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        elseif obj:IsA("Beam") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        elseif obj:IsA("BillboardGui") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        elseif obj:IsA("SurfaceGui") then
            GodFPSOriginals[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        end
    end

    GodFPSOriginalLighting = {
        GlobalShadows = Lighting.GlobalShadows,
        Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        FogEnd = Lighting.FogEnd
    }

    Lighting.GlobalShadows = false
    Lighting.Brightness = 0
    Lighting.Ambient = Color3.fromRGB(0, 0, 0)
    Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
    Lighting.FogEnd = 100000
end

local function RestoreGodFPS()
    if GodFPSGui then
        local frame = GodFPSGui:FindFirstChildOfClass("Frame")
        if frame then
            frame.BackgroundTransparency = 1
        end
    end

    for obj, data in pairs(GodFPSOriginals) do
        if obj and obj.Parent then
            pcall(function()
                if data.Transparency ~= nil then
                    obj.Transparency = data.Transparency
                end
                if data.LocalTransparencyModifier ~= nil then
                    obj.LocalTransparencyModifier = data.LocalTransparencyModifier
                end
                if data.Enabled ~= nil then
                    obj.Enabled = data.Enabled
                end
            end)
        end
    end

    GodFPSOriginals = {}

    if GodFPSOriginalLighting.GlobalShadows ~= nil then
        Lighting.GlobalShadows = GodFPSOriginalLighting.GlobalShadows
        Lighting.Brightness = GodFPSOriginalLighting.Brightness
        Lighting.Ambient = GodFPSOriginalLighting.Ambient
        Lighting.OutdoorAmbient = GodFPSOriginalLighting.OutdoorAmbient
        Lighting.FogEnd = GodFPSOriginalLighting.FogEnd
    end

    GodFPSOriginalLighting = {}
end

