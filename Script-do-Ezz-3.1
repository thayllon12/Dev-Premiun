local function StartFlight()
    UpdateCharacter()

    if not Root or not Humanoid or not Character then
        return false
    end
    if Humanoid.Health <= 0 then
        return false
    end

    if BodyVelocity and BodyVelocity.Parent then
        return true
    end

    OriginalAutoRotate = Humanoid.AutoRotate
    OriginalPlatformStand = Humanoid.PlatformStand
    OriginalSeatedState = Humanoid:GetStateEnabled(
        Enum.HumanoidStateType.Seated
    )

    Humanoid.AutoRotate = false
    Humanoid.PlatformStand = true

    pcall(function()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    end)

    FlightVelocity = Vector3.zero

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.Name = "PumpkinStableVelocity"
    BodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    BodyVelocity.P = 18000
    BodyVelocity.Velocity = Vector3.zero
    BodyVelocity.Parent = Root

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.Name = "PumpkinStableGyro"
    BodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    BodyGyro.P = 18000
    BodyGyro.D = 1200
    BodyGyro.CFrame = Root.CFrame
    BodyGyro.Parent = Root

    OriginalCollisions = {}

    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            OriginalCollisions[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    if NoclipConnection then
        NoclipConnection:Disconnect()
    end

    NoclipConnection = RunService.Stepped:Connect(function()
        if not AutoFarm or not Character then return end

        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)

    return true
end

local function StopFlight()
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if BodyVelocity then
        BodyVelocity:Destroy()
        BodyVelocity = nil
    end

    if BodyGyro then
        BodyGyro:Destroy()
        BodyGyro = nil
    end

    for part, old in pairs(OriginalCollisions) do
        if part and part.Parent then
            part.CanCollide = old
        end
    end

    OriginalCollisions = {}
    FlightVelocity = Vector3.zero

    UpdateCharacter()

    if Root then
        Root.AssemblyLinearVelocity = Vector3.zero
    end

    if Humanoid then
        Humanoid.PlatformStand = OriginalPlatformStand or false
        Humanoid.AutoRotate = OriginalAutoRotate == nil and true or OriginalAutoRotate

        pcall(function()
            Humanoid:SetStateEnabled(
                Enum.HumanoidStateType.Seated,
                OriginalSeatedState ~= false
            )
        end)

        Humanoid.Sit = false
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function TeleportTo(TargetPosition)
    if not Root or not BodyVelocity or not BodyGyro then return end

    Root.CFrame = CFrame.new(TargetPosition)
    FlightVelocity = Vector3.zero
    BodyVelocity.Velocity = Vector3.zero
    BodyGyro.CFrame = CFrame.new(TargetPosition)
end

local function MoveFlight(Destination, StopDistance, dt)
    if not BodyVelocity or not BodyGyro or not Root then
        return
    end

    local Difference = Destination - Root.Position
    local Distance = Difference.Magnitude

    if Distance <= Config.TeleportRange and Distance > StopDistance then
        TeleportTo(Destination)
        return
    end

    local DesiredVelocity = Vector3.zero

    if Distance > StopDistance then
        local Direction = Difference.Unit
        local BrakingDistance = math.max(CurrentSpeed * 0.15, 10)

        local SpeedMultiplier = math.clamp(
            (Distance - StopDistance) / BrakingDistance,
            0,
            1
        )

        local TargetSpeed = CurrentSpeed * SpeedMultiplier
        DesiredVelocity = Direction * TargetSpeed

        local LookCFrame = CFrame.lookAt(
            Root.Position,
            Root.Position + Direction
        )

        BodyGyro.CFrame = BodyGyro.CFrame:Lerp(
            LookCFrame,
            math.clamp(dt * 8, 0, 1)
        )
    end

    local Alpha = math.clamp(dt * 12, 0, 1)
    FlightVelocity = FlightVelocity:Lerp(DesiredVelocity, Alpha)
    BodyVelocity.Velocity = FlightVelocity
end

local function AttackTarget(Target, Part)
    Remotes = GetRemotes()

    local RegisterAttack = Remotes.RegisterAttack
    local RegisterHit = Remotes.RegisterHit

    if not RegisterAttack
        or not RegisterHit
        or not RegisterAttack:IsA("RemoteEvent")
        or not RegisterHit:IsA("RemoteEvent") then
        return false
    end

    if not Target or not Target.Parent
        or not Part or not Part.Parent then
        return false
    end

    local Now = os.clock()

    if Now - LastAttack < Config.AttackDelay then
        return false
    end

    LastAttack = Now

    local Success = pcall(function()
        RegisterAttack:FireServer(0)
        RegisterHit:FireServer(Part, {{Target, Part}})
    end)

    if Success then
        AttackCount += 1
        return true
    end

    return false
end

task.spawn(function()
    while not Destroyed do
        if AutoFarm or AutoAttack then
            if RollbackTime > 0 then
                local Elapsed = os.clock() - RollbackTime

                if Elapsed >= Config.RecoverTime2 then
                    CurrentSpeed = Config.RecoverSpeed2
                    RecoverStage = 2
                    RollbackTime = 0
                elseif Elapsed >= Config.RecoverTime1 then
                    CurrentSpeed = Config.RecoverSpeed1
                    RecoverStage = 1
                end
            end
        end
        task.wait(1)
    end
end)

local function ResetTargets()
    TargetNPC = nil
    TargetPumpkin = nil
    CurrentMode = "SEARCH"
    NoTargetTime = 0
end

FlightConnection = RunService.Heartbeat:Connect(function(dt)
    if Destroyed then return end
    if not AutoFarm and not AutoAttack then return end

    UpdateCharacter()

    if not Root or not Root.Parent or not Humanoid or Humanoid.Health <= 0 then
        if AutoFarm and BodyVelocity then
            FlightVelocity = Vector3.zero
        end
        return
    end

    if Humanoid.Sit or Humanoid.SeatPart then
        Humanoid.Sit = false
        pcall(function()
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end

    if AutoFarm and not (BodyVelocity and BodyVelocity.Parent) then
        if not StartFlight() then
            return
        end
    end

    LastSpeedCheck += dt

    if LastSpeedCheck >= 1.5 then
        LastSpeedCheck = 0

        if BodyVelocity and BodyVelocity.Parent then
            local Velocity = BodyVelocity.Velocity.Magnitude

            if Velocity < 50 and CurrentSpeed >= Config.Speed and AutoFarm then
                CurrentSpeed = Config.FallbackSpeed
                RollbackTime = os.clock()
                RecoverStage = 0
            end
        end
    end

    StuckTime += dt

    if StuckTime >= 2 then
        if Root.Position.Magnitude > 0 then
            local moved = (Root.Position - LastPosition).Magnitude

            if moved < 2 and AutoFarm and CurrentMode ~= "SEARCH" then
                if BodyVelocity then
                    BodyVelocity.Velocity = BodyVelocity.Velocity + Vector3.new(0, 30, 0)
                end
            end
        end

        LastPosition = Root.Position
        StuckTime = 0
    end

    ScanTimer += dt

    if ScanTimer >= Config.ScanInterval then
        ScanTimer = 0

        if not TargetNPC or not TargetNPC.Parent or not IsAlive(TargetNPC) then
            if TargetNPC then
                DeadNPCs[TargetNPC] = true
            end
            TargetNPC = nil
        end

        if not TargetPumpkin or not TargetPumpkin.Parent then
            if TargetPumpkin then
                HiddenPumpkins[TargetPumpkin] = true
            end
            TargetPumpkin = nil
        end

        SelectTarget()

        if CurrentMode == "SEARCH" then
            NoTargetTime += Config.ScanInterval
        else
            NoTargetTime = 0
        end
    end

    if NoTargetTime >= Config.MaxNoTargetTime then
        NoTargetTime = 0
        DeadNPCs = {}
        HiddenPumpkins = {}
        ResetTargets()
    end

    if CurrentMode == "NPC" and TargetNPC then
        local NPC = TargetNPC
        local H = NPC:FindFirstChildOfClass("Humanoid")
        local Head = GetHead(NPC)

        if not NPC.Parent or not H or H.Health <= 0 or not Head then
            DeadNPCs[NPC] = true
            TargetNPC = nil
            CurrentMode = "SEARCH"
            return
        end

        local Destination = Head.Position + Vector3.new(
            0,
            Config.NPCHeight,
            0
        )

        local Distance = (Destination - Root.Position).Magnitude

        if AutoFarm then
            MoveFlight(Destination, 2, dt)
        end

        if AutoAttack and Distance <= Config.AttackRadius then
            AttackTarget(NPC, Head)
        end

    elseif CurrentMode == "PUMPKIN" and TargetPumpkin then
        local Pumpkin = TargetPumpkin

        if not Pumpkin.Parent then
            HiddenPumpkins[Pumpkin] = true
            TargetPumpkin = nil
            CurrentMode = "SEARCH"
            return
        end

        local Part = GetPart(Pumpkin)

        if not Part then
            TargetPumpkin = nil
            CurrentMode = "SEARCH"
            return
        end

        local Destination = Part.Position + Vector3.new(
            0,
            Config.PumpkinHeight,
            0
        )

        local Distance = (Part.Position - Root.Position).Magnitude

        if AutoFarm then
            MoveFlight(Destination, Config.PumpkinDistance, dt)
        end

        if AutoAttack and Distance <= Config.AttackRadius then
            AttackTarget(Pumpkin, Part)
        end

    else
        if BodyVelocity then
            FlightVelocity = Vector3.zero
            BodyVelocity.Velocity = Vector3.zero
        end
    end
end)

WatchdogConnection = RunService.Heartbeat:Connect(function()
    if Destroyed then return end
    if not AutoFarm then return end

    if not Player.Character then return end
    if not Player.Character:FindFirstChild("HumanoidRootPart") then return end

    UpdateCharacter()

    if not Humanoid or Humanoid.Health <= 0 then return end

    if not BodyVelocity or not BodyVelocity.Parent then
        StartFlight()
    end
end)

CharacterConnection = Player.CharacterAdded:Connect(function(NewCharacter)
    Character = NewCharacter

    BodyVelocity = nil
    BodyGyro = nil
    FlightVelocity = Vector3.zero
    ResetTargets()
    DeadNPCs = {}
    HiddenPumpkins = {}

    task.wait(2)

    if Destroyed then return end

    UpdateCharacter()

    if AutoFarm then
        StartFlight()
        EquipSelectedTool()
        TryActivateHaki()
    end

    if AutoAttack then
        EquipSelectedTool()
        TryActivateHaki()
    end
end)

Player.OnTeleport:Connect(function(State)
    if Destroyed then return end
