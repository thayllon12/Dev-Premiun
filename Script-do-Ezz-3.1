-- STORE FRUIT

local function UpdStFruit()
    local Backpack = Player:FindFirstChild("Backpack")
    if not Backpack then return end

    local children = Backpack:GetChildren()

    for _, item in ipairs(children) do
        if Destroyed then break end

        local EatRemote = item:FindFirstChild("EatRemote", true)

        if EatRemote then
            local parent = EatRemote.Parent
            local OriginalName = parent and parent:GetAttribute("OriginalName")
            local FruitTool = Backpack:FindFirstChild(item.Name)

            if OriginalName and FruitTool and CommF then
                pcall(function()
                    CommF:InvokeServer(
                        "StoreFruit",
                        OriginalName,
                        FruitTool
                    )
                end)
            end
        end
    end
end

-- AUTO ROLL LOOP

task.spawn(function()
    while not Destroyed do
        if AutoRollStore then
            if not GachaRemote then
                local modules = ReplicatedStorage:FindFirstChild("Modules")
                local net = modules and modules:FindFirstChild("Net")
                GachaRemote = net and net:FindFirstChild("RF/GachaNetworkRF")
            end

            if GachaRemote and GachaRemote:IsA("RemoteFunction") then
                local success, err = pcall(function()
                    return GachaRemote:InvokeServer({
                        Context = "Purchase",
                        BoxName = "Halloween26Gacha"
                    })
                end)

                if not success then
                    warn("[Pumpkin Hunt] Gacha:", err)
                end
            end

            UpdStFruit()
        end

        task.wait(Config.AutomationInterval)
    end
end)

