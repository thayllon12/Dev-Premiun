function Cleanup()
    if Destroyed then return end
    SaveStates()
    Destroyed = true
    GodFarm = false
    HalloweenDoors = false
    DapperJackAuto = false
    CandyCollect = false
    if GodFPS then
        RestoreGodFPS()
        GodFPS = false
    end
    if GodFPSGui then
        pcall(function() GodFPSGui:Destroy() end)
        GodFPSGui = nil
    end
    Release()
    ClearESP()
    for root, tween in pairs(BringTweens) do
        pcall(function() tween:Cancel() end)
        if root and root.Parent then root:SetAttribute("Tweening", false) end
    end
    BringTweens = {}
    for _, conn in ipairs(CONNS) do
        pcall(function() conn:Disconnect() end)
    end
    CONNS = {}
    print("[Pumpkin Hunt] Sistema encerrado.")
end

Env.PumpkinHuntCleanup = Cleanup

