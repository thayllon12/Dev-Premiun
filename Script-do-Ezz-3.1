    task.wait(0.05)
    pcall(function() VIM:SendMouseButtonEvent(vs.X / 2, vs.Y / 2, 0, false, game, 0) end)
end

function ListPumpkins()
    local out = {}
    local folder = Workspace:FindFirstChild("PumpkinHunt")
    if not folder then return out end
    local now = os.clock()
    for _, m in ipairs(folder:GetChildren()) do
        local cracked = m:GetAttribute("PumpkinCrackedBy")
        local others = SkipOthersPumpkins and cracked ~= nil and cracked ~= Player.UserId
        if (m:IsA("Model") or m:IsA("BasePart")) and now >= (HS.skip[m] or 0) and not others then
            local hits, body, bv, prompt, detector = {}, nil, -1, nil, nil
            local scan = m:IsA("BasePart") and { m } or m:GetDescendants()
            for _, d in ipairs(scan) do
                if d:IsA("BasePart") and d.Transparency == 0 then
                    if HasM1Tag(d) then table.insert(hits, d) end
                    local v = d.Size.X * d.Size.Y * d.Size.Z
                    if v > bv then body, bv = d, v end
                elseif not prompt and d:IsA("ProximityPrompt") and d.Enabled then
                    prompt = d
                elseif not detector and d:IsA("ClickDetector") then
                    detector = d
                end
            end
            if body then
                table.insert(out, {
                    root = m,
                    part = hits[1] or body,
                    hits = hits,
                    pos = body.Position,
                    prompt = prompt,
                    detector = detector,
                    tagged = #hits > 0,
                    rare = m:GetAttribute("PumpkinRare") == true,
                })
            end
        end
    end
    return out
end

function PickPumpkin(list, from, rareFirst)
    local best, bd, br = nil, math.huge, false
    for _, c in ipairs(list) do
        local d = (c.pos - from).Magnitude
        local rare = rareFirst and c.rare == true
        if (rare and not br) or (rare == br and d < bd) then
            best, bd, br = c, d, rare
        end
    end
    return best
end

function WayOrder(c, learned)
    local out, seen = {}, {}
    local function add(w)
        if not seen[w] then
            seen[w] = true
            table.insert(out, w)
        end
    end
    if c.prompt then add("prompt") end
    if c.detector then add("detector") end
    if learned then add(learned) end
    if #c.hits > 0 then add("remote") end
    add("click")
    add("remote")
    return out
end

function FireWay(way, c)
    if way == "prompt" and c.prompt then
        HoldPrompt(c.prompt)
    elseif way == "detector" and c.detector then
        if fireclickdetector then pcall(fireclickdetector, c.detector) end
    elseif way == "remote" then
        local ra = NetRemote("RegisterAttack")
        local rh = NetRemote("RegisterHit")
        if ra then pcall(function() ra:FireServer(0) end) end
        if rh then
            local hits = (#c.hits > 0) and c.hits or { c.part }
            for _, p in ipairs(hits) do
                if p.Parent then pcall(function() rh:FireServer(p) end) end
            end
        end
    else
        PressM1()
    end
end

function PumpkinAlive(c)
    local m = c.root
    if not m.Parent or not m:IsDescendantOf(Workspace) then return false end
    if m:IsA("BasePart") and m.Transparency ~= 0 then return false end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency == 0 then return true end
    end
    return m:IsA("BasePart") and m.Transparency == 0
end

function SmashPumpkin(c)
    Holding = true
    local root = GetParts()
    if not root then return end
    local away = Vector3.new(root.Position.X - c.pos.X, 0, root.Position.Z - c.pos.Z)
    if away.Magnitude < 1 then away = Vector3.new(1, 0, 0) end
    local stand = c.pos + away.Unit * 4 + Vector3.new(0, 1.5, 0)
    if (root.Position - stand).Magnitude > 6 then
        HS.mode = "INDO ABÓBORA"
        if not GoAuto(stand, 3) then
            HS.skip[c.root] = os.clock() + CFG.PumpkinSkip
            HS.note = "sem caminho até " .. c.root.Name
            return
        end
    end
    if not PumpkinAlive(c) then return end
    HS.mode = "ABÓBORA"
    FaceTo(c.pos)
    EnsureTool()
    for _, way in ipairs(WayOrder(c, HS.way)) do
        local n = 0
        while n < CFG.PerWay do
            n += 1
            if not PumpkinAlive(c) then
                HS.tally.pumpkins += 1
                if c.rare then HS.tally.rare += 1 end
                if HS.way ~= way then
                    HS.way = way
                    SaveStates()
                end
                return
            end
            FireWay(way, c)
            task.wait(CFG.Swing)
        end
    end
    HS.skip[c.root] = os.clock() + CFG.PumpkinSkip
end

function NearestFruit()
    local root = GetParts()
    if not root then return nil end
    local best, bd = nil, math.huge
    local now = os.clock()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if string.find(string.lower(obj.Name), "fruit", 1, true) and (HS.fruitSkip[obj] or 0) < now then
            local h = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
            if h and h:IsA("BasePart") then
                local d = (h.Position - root.Position).Magnitude
                if d < bd then best, bd = { model = obj, handle = h }, d end
            end
        end
    end
    return best
end

function GrabFruit(f)
    Holding = true
    local h = f.handle
    HS.mode = "FRUTA"
    HS.note = "pegando " .. f.model.Name
    if not GoAuto(h.Position, 2) then
        HS.fruitSkip[f.model] = os.clock() + 30
        return
    end
    local t0 = os.clock()
    while os.clock() - t0 < 6 and h:IsDescendantOf(Workspace) do
        local root = GetParts()
        if root and firetouchinterest then
            pcall(firetouchinterest, root, h, 0)
            pcall(firetouchinterest, root, h, 1)
        end
        task.wait(0.15)
    end
    if h:IsDescendantOf(Workspace) then
        HS.fruitSkip[f.model] = os.clock() + CFG.FruitSkip
    else
        HS.tally.fruits += 1
    end
end

function UpdStFruit()
    local backpack = Player:FindFirstChild("Backpack")
    if not backpack then return end
    local commF = CommFRemote()
    for _, item in ipairs(backpack:GetChildren()) do
        if Destroyed then break end
        local eatRemote = item:FindFirstChild("EatRemote", true)
        if eatRemote then
            local parent = eatRemote.Parent
            local originalName = parent and parent:GetAttribute("OriginalName")
            local fruitTool = backpack:FindFirstChild(item.Name)
            if originalName and fruitTool and commF then
                pcall(function() commF:InvokeServer("StoreFruit", originalName, fruitTool) end)
            end
        end
    end
end

function MainStep()
    if not Engaged() then
        Release()
        task.wait(0.5)
        return
    end
    ListenHalloween()
    local root = GetParts()
    if not root then
        HS.mode = "SEM PERSONAGEM"
        task.wait(0.5)
        return
    end

    local now = os.clock()
    if HS.domain and now - math.max(HS.domain.at, HS.lastFight) > CFG.DomainTimeout then
        HS.domain = nil
    end

    if AutoAttack then
        local m = NearestTarget(HS.domain and CFG.DomainSearch or CFG.TargetSearch)
        if m then
            HS.mode = "COMBATE"
            HS.note = (IsFocus(m) and "foco: " or "evento: ") .. m.Name
            FightEnemy(m)
            return
        end
    end

    local d = HS.door
    if d and not d.done then
        if now - d.at > CFG.DoorMax or not (d.inst and d.inst.Parent) then
            HS.door = nil
        elseif d.boss then
            local pt = (HalloweenDoors and HellfirePortal) and PortalPos() or nil
            if pt then
                EnterPortal(pt)
                return
            end
            if not (HalloweenDoors and HellfirePortal) or now - d.at > 15 then
                d.done = true
            else
                HS.mode = "ESPERANDO PORTAL"
                Release()
                task.wait(0.25)
                return
            end
        else
            HS.mode = "EVENTO"
            Release()
            if not d.accepted and now - d.at > 2 then
                d.accepted = true
                FireEvent(AcceptRewards and "AcceptReward" or "DeclineReward")
            end
            task.wait(0.25)
            return
        end
    end

    if HS.domain then
        HS.mode = "DOMÍNIO"
        Release()
        task.wait(0.25)
        return
    end

    if HalloweenDoors and EventOn() then
        local list = DoorList()
        local spot = SeaSpot()
        local door = PickDoor(list, (GoDoorSpot and spot) or root.Position)
        if door then
            KnockDoor(door)
            return
        end
        if GoDoorSpot and spot and (root.Position - spot).Magnitude > 80 then
            HS.mode = "INDO PARA AS PORTAS"
            GoAuto(spot, 10)
            return
        end
        if #list == 0 and AcceptTeleport then
            local hour = os.date("!%Y%m%d%H")
            if HS.tpHour ~= hour then
                HS.tpHour = hour
                HS.mode = "TELETRANSPORTE"
                local tr = GetParts()
                if tr then
                    Holding = true
                    LockCF = tr.CFrame
                    Travel = nil
                end
                FireEvent("AcceptEventTeleport")
                task.wait(6)
                Release()
                return
            end
        end
    end

    if GodFarm then
        local c = PickPumpkin(ListPumpkins(), root.Position, HalloweenRareFirst)
        if c then
            SmashPumpkin(c)
            return
        end
    end

    if AutoBringFruits then
        local f = NearestFruit()
        if f then
            GrabFruit(f)
            return
        end
    end

    HS.mode = "ESPERANDO"
    Release()
    task.wait(CFG.IdleWait)
end

function BringEnemy()
    if not AutoBring or not Engaged() then return end
    local root = GetParts()
    local enemies = Workspace:FindFirstChild("Enemies")
    if not root or not enemies then return end
    pcall(function()
        if sethiddenproperty then sethiddenproperty(Player, "SimulationRadius", math.huge) end
    end)
    local lockPos = LockCF and LockCF.Position or root.Position
    local target = lockPos - Vector3.new(0, CFG.HoverHeight, 0)
    local range = math.clamp(CFG.BringRange, 1, 300)
    local count = 0
    for _, mob in ipairs(enemies:GetChildren()) do
        if Destroyed or not AutoBring or count >= CFG.MaxBringMobs then break end
        if mob:IsA("Model") and (IsSnowman(mob) or IsJack(mob)) and IsAliveModel(mob) and AnyVisible(mob) then
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
            if mobRoot and not mobRoot:GetAttribute("Tweening") then
                local d = (mobRoot.Position - target).Magnitude
                if d <= range then
                    count += 1
                    mobRoot:SetAttribute("Tweening", true)
                    if BringTweens[mobRoot] then pcall(function() BringTweens[mobRoot]:Cancel() end) end
                    local tw = TweenService:Create(mobRoot, TweenInfoBring, { CFrame = CFrame.new(target) })
                    BringTweens[mobRoot] = tw
                    tw.Completed:Once(function()
                        if mobRoot and mobRoot.Parent then mobRoot:SetAttribute("Tweening", false) end
                        BringTweens[mobRoot] = nil
                    end)
                    tw:Play()
                end
            end
        end
    end
end

