StatusTab:AddSection("HORÁRIO")
StatusRow(function()
    return "UTC: " .. os.date("!%H:%M:%S") .. "   ·   Brasília: " .. os.date("!%H:%M:%S", os.time() - 3 * 3600)
end)
StatusRow(function()
    local on, secs = EventClock()
    if on then return "Evento: ATIVO · termina em " .. FormatDur(secs) end
    return "Evento: fora · começa em " .. FormatDur(secs)
end)
StatusRow(function()
    return string.format("Janela do evento: xx:00 até xx:%02d (UTC)", CFG.EventMinutes)
end)
StatusRow(function()
    return "Sessão no script: " .. FormatDur(os.time() - HS.startedAt)
end)

StatusTab:AddSection("SERVIDOR")
StatusRow(function()
    local sea = SEA_OF_PLACE[game.PlaceId]
    return "Sea: " .. (sea and tostring(sea) or "desconhecido") .. "   ·   Place: " .. tostring(game.PlaceId)
end)
StatusRow(function()
    return "Ping: " .. PingMs() .. " ms   ·   FPS: " .. FPSNow
end)
StatusRow(function()
    local root, hum = GetParts()
    if not root then return "Personagem: morto ou carregando" end
    local p = root.Position
    return string.format("Vida: %d%%   ·   Posição: %d, %d, %d", math.floor(HealthPct() * 100), math.floor(p.X), math.floor(p.Y), math.floor(p.Z))
end)
StatusRow(function()
    return "Modo: " .. HS.mode
end)
StatusRow(function()
    return "Alvo atual: " .. (HS.target and HS.target.Name or "nenhum")
end)
StatusRow(function()
    return "Nota: " .. HS.note
end)

StatusTab:AddSection("ALVOS E PORTAS")
StatusRow(function()
    return "Snowman / Jack / Hellfire Gas / Dapper Jack vivos: " .. CountFocus()
end)
StatusRow(function()
    return "Abóboras em PumpkinHunt: " .. #ListPumpkins()
end)
StatusRow(function()
    return "Portas prontas para bater: " .. CountDoorsReady()
end)
StatusRow(function()
    return "Portal Hellfire: " .. (PortalPos() and "aberto" or "não") .. "   ·   Domínio do boss: " .. (HS.domain and "sim" or "não")
end)
StatusRow(function()
    return "Kills: " .. HS.tally.kills .. "   ·   Bosses: " .. HS.tally.bosses .. "   ·   Portas batidas: " .. HS.tally.doors
end)
StatusRow(function()
    return "Abóboras quebradas: " .. HS.tally.pumpkins .. "   ·   Raras: " .. HS.tally.rare
end)
StatusRow(function()
    local n = 0
    for _, d in ipairs(DoorList()) do
        if BossActive(d.inst) then n += 1 end
    end
    return "Portas com boss ativo: " .. n .. "   ·   Boss Hellfire mortos: " .. HS.tally.bossKills
end)
StatusRow(function()
    local folder = Workspace:FindFirstChild("Enemies")
    local n, enr = 0, 0
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m.Name == "Dapper Jack" and IsAliveModel(m) then
                n += 1
                if m:GetAttribute("DapperJackEnraged") then enr += 1 end
            end
        end
    end
    return "Dapper Jack vivo: " .. n .. "   ·   enraged: " .. enr
end)
StatusRow(function()
    return "Flag do jogo (HalloweenEventActive): " .. tostring(Workspace:GetAttribute("HalloweenEventActive"))
end)

StatusTab:AddSection("FRUTAS")
StatusRow(function()
    return "Spawnadas agora: " .. #FruitScan .. "   ·   Coletadas nesta sessão: " .. HS.tally.fruits
end)
for i = 1, 8 do
    local idx = i
    StatusRow(function()
        local f = FruitScan[idx]
        if f then return idx .. ". " .. f.name .. "  ·  " .. f.dist .. " studs" end
        return idx .. ". -"
    end)
end

StatusTab:AddSection("SCRIPT")
StatusRow(function()
