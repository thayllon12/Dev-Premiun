local function ToolMatches(t)
    if not t or not t:IsA("Tool") then return false end
    return t.ToolTip == SelectedToolType
        or t.Name:lower():find(SelectedToolType:lower(), 1, true) ~= nil
end

local LastEquip = 0
local function EnsureTool()
    if os.clock() - LastEquip < 1 then return end
    LastEquip = os.clock()

    UpdateCharacter()
    if not Character or not Humanoid or Humanoid.Health <= 0 then return end
    if ToolMatches(Character:FindFirstChildOfClass("Tool")) then return end

    local bp = Player:FindFirstChild("Backpack")
    if not bp then return end
    for _, item in ipairs(bp:GetChildren()) do
        if ToolMatches(item) then
            Humanoid:EquipTool(item)
            return
        end
    end
end

-- =========================================================
-- VOO (único controlador; só liga quando há destino)
-- =========================================================

local Flight = {
    body = nil,
    gyro = nil,
    noclip = nil,
    origCollide = {},
    origAutoRotate = nil,
    origPlatform = nil,
}
local Nav = nil
local FlightVelocity = Vector3.zero
local FlightConnection

local function StartFlight()
    UpdateCharacter()
    if not Root or not Humanoid or not Character or Humanoid.Health <= 0 then return false end
    if Flight.body and Flight.body.Parent then return true end

    Flight.origAutoRotate = Humanoid.AutoRotate
    Flight.origPlatform = Humanoid.PlatformStand
    Humanoid.AutoRotate = false
    Humanoid.PlatformStand = true

    FlightVelocity = Vector3.zero

    local bv = Instance.new("BodyVelocity")
    bv.Name = "PumpkinStableVelocity"
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.P = 18000
    bv.Velocity = Vector3.zero
    bv.Parent = Root
    Flight.body = bv

    local bg = Instance.new("BodyGyro")
    bg.Name = "PumpkinStableGyro"
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 18000
    bg.D = 1200
    bg.CFrame = Root.CFrame
    bg.Parent = Root
    Flight.gyro = bg

    Flight.origCollide = {}
    for _, p in ipairs(Character:GetDescendants()) do
        if p:IsA("BasePart") then Flight.origCollide[p] = p.CanCollide end
    end

    if Flight.noclip then Flight.noclip:Disconnect() end
    Flight.noclip = RunService.Stepped:Connect(function()
        if not Character then return end
        for _, p in ipairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)

    return true
end

local function StopFlight()
    Nav = nil

    if Flight.noclip then
        Flight.noclip:Disconnect()
        Flight.noclip = nil
    end
    if Flight.body then Flight.body:Destroy() Flight.body = nil end
    if Flight.gyro then Flight.gyro:Destroy() Flight.gyro = nil end

    for part, old in pairs(Flight.origCollide) do
        if part and part.Parent then part.CanCollide = old end
    end
    Flight.origCollide = {}
    FlightVelocity = Vector3.zero

    UpdateCharacter()
    if Humanoid and Humanoid.Health > 0 then
        Humanoid.PlatformStand = Flight.origPlatform or false
        Humanoid.AutoRotate = Flight.origAutoRotate ~= false
        Humanoid.Sit = false
        pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function MoveFlight(dest, stopDist, dt)
    if not Flight.body or not Flight.gyro or not Root then return end

    local diff = dest - Root.Position
    local dist = diff.Magnitude
    local desired = Vector3.zero

    if dist > stopDist then
        local dir = diff.Unit
        local braking = math.max(Config.Speed * 0.15, 10)
        local mult = math.clamp((dist - stopDist) / braking, 0, 1)
        desired = dir * (Config.Speed * mult)

        local look = CFrame.lookAt(Root.Position, Root.Position + dir)
        Flight.gyro.CFrame = Flight.gyro.CFrame:Lerp(look, math.clamp(dt * 8, 0, 1))
    end

    FlightVelocity = FlightVelocity:Lerp(desired, math.clamp(dt * 12, 0, 1))
    Flight.body.Velocity = FlightVelocity
end

FlightConnection = RunService.Heartbeat:Connect(function(dt)
    if Destroyed or not (Flight.body and Flight.body.Parent) then return end
    UpdateCharacter()
    if not Root or not Humanoid or Humanoid.Health <= 0 then return end

    if Nav then
        MoveFlight(Nav.pos, Nav.stop, dt)
    else
        FlightVelocity = FlightVelocity:Lerp(Vector3.zero, math.clamp(dt * 12, 0, 1))
        Flight.body.Velocity = FlightVelocity
    end
end)

-- Voa até uma posição e espera chegar. Retorna true se chegou.
local function GoTo(pos, stop, timeout, abort)
    stop = stop or 3
    timeout = timeout or 15

    if not StartFlight() then return false end
    Nav = { pos = pos, stop = stop }

    local t0 = os.clock()
    while not Destroyed do
        UpdateCharacter()
        if not Root or not Humanoid or Humanoid.Health <= 0 then break end
        if (Root.Position - pos).Magnitude <= stop + 2 then break end
        if os.clock() - t0 > timeout then break end
        if abort and abort() then break end
        task.wait(0.05)
    end

    Nav = nil
    return Root ~= nil and (Root.Position - pos).Magnitude <= stop + 5
end

-- =========================================================
-- ALVOS (inimigos e abóboras)
-- =========================================================

local Ignored = setmetatable({}, { __mode = "k" })

local function PartOf(m)
    if not m then return nil end
    if m:IsA("BasePart") then return m end
    if m:IsA("Model") then
        return m:FindFirstChild("HumanoidRootPart")
            or m.PrimaryPart
            or m:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function IsAlive(m)
    local h = m and m:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

local function IsJackEnemy(m)
    local n = string.lower(m.Name):gsub("[%s%p_]+", "")
    return n:find("jack") ~= nil or n:find("lantern") ~= nil
end

local function IsRaidMob(m)
    local n = string.lower(m.Name)
    return n:find("raid") ~= nil or n:find("boss") ~= nil
end

-- Qualquer inimigo vivo na pasta Enemies (Hellfire, Jack, etc.)
local function NearestEnemy(maxDist)
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder or not Root then return nil end

    local best, bd = nil, maxDist
    local now = os.clock()

    for _, m in ipairs(folder:GetDescendants()) do
        if m:IsA("Model") and m.Parent and IsAlive(m) and (Ignored[m] or 0) < now then
            local p = PartOf(m)
            if p then
                local d = (p.Position - Root.Position).Magnitude
                if d < bd then best, bd = m, d end
            end
        end
    end

    return best
end

local function IsVisible(obj)
    if not obj or not obj.Parent then return false end
    if obj:IsA("BasePart") then
        return obj.Transparency < 0.98 and obj.LocalTransparencyModifier < 0.98
    end
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("BasePart") and v.Transparency < 0.98 and v.LocalTransparencyModifier < 0.98 then
            return true
        end
    end
    return false
end

local LastAttack = 0
local function AttackTarget(target, part)
    local ra = Remote("RegisterAttack")
    local rh = Remote("RegisterHit")
    if not ra or not rh then return false end
    if not target or not target.Parent or not part or not part.Parent then return false end

    local now = os.clock()
    if now - LastAttack < Config.AttackDelay then return false end
    LastAttack = now

    return (pcall(function()
        ra:FireServer(0)
        rh:FireServer(part, { { target, part } })
    end))
end

-- Luta contra um inimigo até morrer, sair de alcance ou estourar o tempo
local function FightEnemy(m)
    local t0 = os.clock()

    while not Destroyed and m.Parent and IsAlive(m) do
        if not Engaged() then break end

        if os.clock() - t0 > Config.EnemyTimeout then
            Ignored[m] = os.clock() + Config.EnemyIgnoreTime
            break
        end

        UpdateCharacter()
        if not Root or not Humanoid or Humanoid.Health <= 0 then break end

        local part = PartOf(m)
        if not part then break end

        local head = m:FindFirstChild("Head") or part
        local dist = (part.Position - Root.Position).Magnitude

        if FlyMode() then
            if StartFlight() then
                Nav = { pos = part.Position + Vector3.new(0, Config.HoverHeight, 0), stop = 3 }
            end
        elseif dist > Config.AttackRadius then
            break
        end

        if dist <= Config.AttackRadius then
            EnsureTool()
            AttackTarget(m, head)
        end

        task.wait(Config.AttackDelay)
    end

    Nav = nil
end

-- Bring Jack (só God Farm)
local TweenInfoBring = TweenInfo.new(0.35, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
local BringTweens = {}

local function BringEnemy()
    if not GodFarm or not AutoBring then return end
    local Enemies = Workspace:FindFirstChild("Enemies")
    if not Enemies or not Root then return end

    pcall(function()
        if sethiddenproperty then sethiddenproperty(Player, "SimulationRadius", math.huge) end
    end)

    local target = Root.Position
    local range = math.clamp(tonumber(_G.BringRange) or 300, 1, 300)
    local maxMobs = math.clamp(tonumber(_G.MaxBringMobs) or 10, 1, 50)
    local count = 0

    for _, mob in ipairs(Enemies:GetChildren()) do
        if Destroyed or not AutoBring or count >= maxMobs then break end

        if mob:IsA("Model") and IsJackEnemy(mob) and not IsRaidMob(mob) and IsAlive(mob) then
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
            if mobRoot and not mobRoot:GetAttribute("Tweening") then
                local d = (mobRoot.Position - target).Magnitude
                if d <= range then
                    count += 1
                    mobRoot:SetAttribute("Tweening", true)

                    if BringTweens[mobRoot] then pcall(function() BringTweens[mobRoot]:Cancel() end) end

                    local tw = TweenService:Create(mobRoot, TweenInfoBring, { CFrame = CFrame.new(target) })
                    BringTweens[mobRoot] = tw
                    tw.Completed:Once(function()
                        if mobRoot and mobRoot.Parent then mobRoot:SetAttribute("Tweening", false) end
                        BringTweens[mobRoot] = nil
                    end)
                    tw:Play()
                end
            end
        end
    end
end

task.spawn(function()
    while not Destroyed do
        if GodFarm and AutoBring then pcall(BringEnemy) end
        task.wait(Config.BringInterval)
    end
end)

