        pcall(function() data.gui:Destroy() end)
    end
    ESPBillboards = {}
end

function ShowLabel(key, part, text, color)
    ESPActive[key] = true
    local data = ESPBillboards[key]
    if not data or not data.gui.Parent then
        data = CreateBillboard(part)
        ESPBillboards[key] = data
    end
    data.gui.Adornee = part
    data.adornee = part
    data.label.TextColor3 = color
    data.label.Text = text
end

function UpdateESP()
    local root = GetParts()
    if not ShowESP or not root then
        ClearESP()
        return
    end
    ESPActive = {}

    local pf = Workspace:FindFirstChild("PumpkinHunt")
    if pf then
        for _, obj in ipairs(pf:GetChildren()) do
            local p = PartOf(obj)
            if p and AnyVisible(obj) then
                local dist = math.floor((p.Position - root.Position).Magnitude)
                ShowLabel(obj, p, "Pumpkin [" .. dist .. "]", Color3.fromRGB(255, 170, 0))
            end
        end
    end

    local ef = Workspace:FindFirstChild("Enemies")
    if ef then
        for _, m in ipairs(ef:GetChildren()) do
            if m:IsA("Model") and IsFocus(m) and IsAliveModel(m) then
                local p = PartOf(m)
                local h = m:FindFirstChildOfClass("Humanoid")
                if p and h then
                    local dist = math.floor((p.Position - root.Position).Magnitude)
                    ShowLabel(m, p, m.Name .. " [" .. dist .. "] HP " .. math.floor(h.Health), Color3.fromRGB(255, 60, 60))
                end
            end
        end
    end

    for key, data in pairs(ESPBillboards) do
        if not ESPActive[key] or not data.gui.Parent or not data.adornee.Parent then
            pcall(function() data.gui:Destroy() end)
            ESPBillboards[key] = nil
        end
    end
end

