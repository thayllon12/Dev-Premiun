    corner(fill,4)

    local label = new("TextLabel", {
        Position = UDim2.new(1,-108,.5,-9),
        Size = UDim2.fromOffset(27,18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = C.Cream,
        Text = tostring(value),
        Parent = row
    })

    local hit = new("TextButton", {
        Position = UDim2.new(1,-80,.5,-12),
        Size = UDim2.fromOffset(75,24),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row
    })

    local element = {Value=value}

    function element:SetValue(v)
        value = math.clamp(
            math.floor(v*(10^(options.Rounding or 0))+.5)/(10^(options.Rounding or 0)),
            min,max
        )
        self.Value = value
        local p = (value-min)/(max-min)
        fill.Size = UDim2.new(p,0,1,0)
        label.Text = tostring(value)
        if options.Callback then options.Callback(value) end
    end

    local dragging = false

    local function update(x)
        local p = math.clamp(
            (x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1
        )
        element:SetValue(min+(max-min)*p)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    table.insert(self.Connections,UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end))

    table.insert(self.Connections,UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    self.Elements[id] = element
    return element
end

function Library:_addDropdown(section,id,options)
