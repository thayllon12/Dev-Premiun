        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        ZIndex = 20,
        Parent = window
    })

    self.Particles = {}

    local particleConnection = RunService.Heartbeat:Connect(function(dt)
        if self.Destroyed then return end

        for i = #self.Particles,1,-1 do
            local p = self.Particles[i]
            p.age = p.age + dt
            local t = p.age/p.life

            if t >= 1 then
                p.frame:Destroy()
                table.remove(self.Particles,i)
            else
                p.frame.Position = UDim2.fromOffset(
                    p.x + math.sin(p.age*5+p.phase)*3*t,
                    p.y-p.rise*(1-(1-t)^2)
                )
                p.frame.BackgroundColor3 = colorAt(t)
                p.frame.BackgroundTransparency = t
            end
        end
    end)

    table.insert(self.Connections,particleConnection)

    task.spawn(function()
        while not self.Destroyed do
            if self.Window.Visible and #self.Particles < 100 then
                for _=1,2 do
                    local p = new("Frame", {
                        Position = UDim2.fromOffset(math.random(35,150),25),
                        Size = UDim2.fromOffset(math.random(2,5),math.random(5,10)),
                        BackgroundColor3 = C.Yellow,
                        ZIndex = 20,
                        Parent = self.ParticleLayer
                    })
                    corner(p,5)
                    table.insert(self.Particles,{
                        frame=p,
                        x=p.Position.X.Offset,
                        y=25,
                        age=0,
                        life=math.random(50,100)/100,
                        rise=math.random(15,30),
                        phase=math.random()*6
                    })
                end
            end
            task.wait(.05)
        end
    end)

