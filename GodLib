	task.defer(function() TweenService:Create(card, FAST, { BackgroundTransparency = 0.05 }):Play() end)
	task.delay(hold, function()
		if card.Parent then
			TweenService:Create(card, TweenInfo.new(0.25), { BackgroundTransparency = 1, Size = UDim2.fromOffset(280, 0) }):Play()
			task.delay(0.25, function() if card.Parent then card:Destroy() end end)
		end
	end)
end

