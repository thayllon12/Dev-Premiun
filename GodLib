function GodLib:Notify(config)
	config = config or {}
	local title = config.Title or "Notification"
	local content = config.Content or ""
	local duration = config.Duration or 4
	local notifType = config.Type or "Info"
	local color = Theme.Gold
	if notifType == "Success" then color = Theme.Success
	elseif notifType == "Warning" then color = Theme.Warning
	elseif notifType == "Error" then color = Theme.Error end
	if not NotificationContainer then return end
	local card = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Theme.Dark,
		ClipsDescendants = true,
		Parent = NotificationContainer
	})
	Corner(card, 10)
	Stroke(card, color, 1.4, 0.25)
	MakeGlowBorder(card, 10, 1.4, 5)
	local accent = Create("Frame", {
		Size = UDim2.new(0, 5, 1, 0),
		BackgroundColor3 = color,
		Parent = card
	})
	Corner(accent, 3)
	Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 18),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = Theme.Cream,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
		Parent = card
	})
	local contentLbl = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 30),
		Size = UDim2.new(1, -32, 0, 0),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Text = content,
		Parent = card
	})
	local textHeight = contentLbl.TextBounds.Y
	local totalH = 48 + textHeight
	card.Size = UDim2.new(1, 0, 0, totalH)
	contentLbl.Size = UDim2.new(1, -32, 0, textHeight)
	card.BackgroundTransparency = 1
	for _, c in ipairs(card:GetDescendants()) do
		if c:IsA("TextLabel") then c.TextTransparency = 1 end
	end
	Tween(card, {BackgroundTransparency = 0.05}, TweenInfo.new(0.28))
	for _, c in ipairs(card:GetDescendants()) do
		if c:IsA("TextLabel") then Tween(c, {TextTransparency = 0}, TweenInfo.new(0.28)) end
	end
	task.delay(duration, function()
		if not card.Parent then return end
		Tween(card, {BackgroundTransparency = 1}, TweenInfo.new(0.32))
		for _, c in ipairs(card:GetDescendants()) do
			if c:IsA("TextLabel") then Tween(c, {TextTransparency = 1}, TweenInfo.new(0.32)) end
		end
		task.wait(0.35)
		card:Destroy()
	end)
end

