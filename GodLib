function Window:SelectTab(index)
	if self._closePopup then
		local fn = self._closePopup
		self._closePopup = nil
		fn()
	end
	for i, nb in ipairs(self._navButtons) do
		local on = (i == index)
		nb.button.BackgroundTransparency = on and 0.8 or 1
		nb.accent.Visible = on
		nb.icon.ImageColor3 = on and GOLD or MUTED
		nb.label.TextColor3 = on and CREAM or MUTED
		self._pages[i].Visible = on
	end
end

function Window:SetVisible(visible)
	if not visible and self._closePopup then
		local fn = self._closePopup
		self._closePopup = nil
		fn()
	end
	self._window.Visible = visible
end

function Window:GetVisible() return self._window.Visible end

function Window:Minimize() self:SetVisible(false) end

function Window:Maximize() self:SetVisible(true) end

function Window:Toggle() self:SetVisible(not self._window.Visible) end

function Window:SetBackground(index)
	if type(index) ~= "number" or index < 1 or index > #BACKGROUNDS then
		log("SetBackground: índice inválido")
		return
	end
	self._bgIndex = index
	if self._bgButtonText then
		self._bgButtonText.Text = ("%d / %d"):format(index, #BACKGROUNDS)
	end
	for img in pairs(self._bgTargets) do
		TweenService:Create(img, FADE, { ImageTransparency = 1 }):Play()
	end
	task.delay(FADE.Time, function()
		for img, alpha in pairs(self._bgTargets) do
			if img.Parent then
				img.Image = BACKGROUNDS[index]
				TweenService:Create(img, FADE, { ImageTransparency = alpha }):Play()
			end
		end
	end)
end

function Window:NextBackground()
	self:SetBackground(self._bgIndex % #BACKGROUNDS + 1)
end

function Window:GetTab(name)
	for _, t in ipairs(self._tabs) do
		if t._name == name then return t end
	end
	log("aba não encontrada: " .. tostring(name))
	return nil
end

function Window:Destroy()
	if self._closePopup then
		local fn = self._closePopup
		self._closePopup = nil
		pcall(fn)
	end
	if self._gui then pcall(function() self._gui:Destroy() end) end
	if self._notifConn then pcall(function() self._notifConn:Disconnect() end) end
	if GodLib._currentWindow == self then GodLib._currentWindow = nil end
end

