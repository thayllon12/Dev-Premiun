			p.age = p.age + dt
			local t = p.age / p.life
			if t >= 1 or not p.frame.Parent then
				if p.frame and p.frame.Parent then p.frame:Destroy() end
				table.remove(particles, i)
			else
				local ease = 1 - (1 - t) ^ 1.6
				local sway = math.sin(p.age * p.freq + p.phase) * p.amp * (0.4 + t * 0.8)
				local flick = 1 + 0.18 * math.sin(p.age * 22 + p.phase)
				local shrink = (p.kind == "spark") and (1 - t * 0.9) or (1 - 0.55 * t)

				p.frame.Position = UDim2.fromOffset(p.x + sway, p.y - p.rise * ease)
