    self.Title = title

    local buttons = {
        {name="Minimize",x=-76,callback=function()
            self:SetVisible(false)
        end},
        {name="Expand",x=-52,callback=function()
            self:SetExpanded(not self.Expanded)
        end},
        {name="Close",x=-28,callback=function()
            self:Destroy()
        end}
    }

    for _,item in ipairs(buttons) do
        local b = new("ImageButton", {
            Position = UDim2.new(1,item.x,0,10),
            Size = UDim2.fromOffset(14,14),
            BackgroundTransparency = 1,
            Image = Icons[item.name == "Close" and "close"
                or item.name == "Minimize" and "minus"
                or "maximize"],
            ImageColor3 = C.Gold,
            Parent = titleBar
        })
        b.MouseButton1Click:Connect(item.callback)
    end

    local underline = new("Frame", {
        Position = UDim2.fromOffset(0,33),
        Size = UDim2.new(1,0,0,2),
        BackgroundColor3 = C.Gold,
        Parent = window
