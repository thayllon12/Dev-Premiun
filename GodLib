local function serializeValue(val)
	if typeof(val) == "Color3" then return { __type = "Color3", r = val.R, g = val.G, b = val.B }
	elseif typeof(val) == "EnumItem" then return { __type = "EnumItem", enum = tostring(val.EnumType), name = val.Name }
	elseif typeof(val) == "table" then return val
	elseif typeof(val) == "boolean" or typeof(val) == "number" or typeof(val) == "string" then return val end
	return nil
end

local function deserializeValue(val)
	if type(val) == "table" then
		if val.__type == "Color3" then return Color3.new(val.r, val.g, val.b)
		elseif val.__type == "EnumItem" then return Enum[val.enum][val.name] end
	end
	return val
end

function GodLib:SaveConfig(filename)
	if not writefile then return log("writefile indisponível.") end
	local data = {}
	for name, opt in pairs(self.Options) do
		data[name] = serializeValue(opt.Value)
	end
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
	if ok then
		if makefolder and not (isfolder and isfolder("GodLib")) then pcall(makefolder, "GodLib") end
		pcall(writefile, "GodLib/" .. filename .. ".json", encoded)
		self:Notify({ Title = "Config", Content = "Salvo com sucesso!", Duration = 3 })
	end
end

function GodLib:LoadConfig(filename)
	if not readfile or not isfile then return log("readfile indisponível.") end
	if isfile("GodLib/" .. filename .. ".json") then
		local ok, content = pcall(readfile, "GodLib/" .. filename .. ".json")
		if ok and content then
			local success, decoded = pcall(HttpService.JSONDecode, HttpService, content)
			if success and type(decoded) == "table" then
				for name, val in pairs(decoded) do
					local opt = self.Options[name]
					if opt then opt:Set(deserializeValue(val)) end
				end
				self:Notify({ Title = "Config", Content = "Carregado com sucesso!", Duration = 3 })
			end
		end
	end
end

local Option = {}
Option.__index = Option

function Option.new(name, defaultValue)
	local self = setmetatable({}, Option)
	self.Name = name
	self.Value = defaultValue
	self._listeners = {}
	return self
end

function Option:Set(value)
	if self.Value == value then return end
	self.Value = value
	for _, cb in ipairs(self._listeners) do
		task.spawn(function()
			local ok, err = pcall(cb, value)
			if not ok then log("Callback " .. self.Name .. ": " .. tostring(err)) end
		end)
	end
end

function Option:Get() return self.Value end

function Option:OnChanged(cb)
	table.insert(self._listeners, cb)
	return { Disconnect = function()
		for i, v in ipairs(self._listeners) do if v == cb then table.remove(self._listeners, i) return end end
	end }
end

local function registerOption(name, default)
	if GodLib.Options[name] then return GodLib.Options[name] end
	local opt = Option.new(name, default)
	GodLib.Options[name] = opt
	return opt
end

