			amp = math.random(4, 9)
		elseif kind == "spark" then
			w = math.random(1, 2)
			h = math.random(3, 6)
			life = math.random(40, 70) / 100
			rise = math.random(50, 90)
			amp = math.random(6, 14)
		else -- flame
			w = math.random(4, 7)
			h = math.random(8, 14)
			life = math.random(55, 100) / 100
			rise = math.random(16, 28)
			amp = math.random(1, 4)
		end

