	config = config or {}
	local opt = registerOption(name, config.Default or Color3.fromRGB(255, 200, 0))
	local row = makeRow(self._list, self:_nextOrder(), config.Icon or "palette", config.Title or name, config.Description or "")
	local swatch = new("TextButton", { Position = UDim2.new(1, -46, 0.5, -9), Size = UDim2.fromOffset(40, 18), BackgroundColor3 = opt.Value, AutoButtonColor = false, Text = "", Parent = row })
