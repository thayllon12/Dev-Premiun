			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = DARK,
			BackgroundTransparency = 0.3,
			Parent = toggleButton,
		})
		addCorner(toggleShade, 10)

		new("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(30, 30),
			BackgroundTransparency = 1,
			Image = LOGO,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 2,
			Parent = toggleButton,
		})

		makeGlowBorder(toggleButton, 10, 1.5, 5)
		makeDraggable(toggleButton, toggleButton, nil, function() self:Toggle() end, GodLib.Connections)
	end

	local key = config.MinimizeKey or Enum.KeyCode.RightShift
	track(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not gui.Parent then return end
		if input.KeyCode == key then self:Toggle() end
	end))

	if config.AutoBackground ~= false then
		task.spawn(function()
			while gui.Parent do
				task.wait(10)
				if not gui.Parent then break end
				self:NextBackground()
			end
		end)
	end

	self._bgButtonText = nil

	GodLib._currentWindow = self
	GodLib._gui = gui
	genv.GodLib = GodLib

	return self
end

function GodLib:AddWindow() log("AddWindow múltiplas janelas: use CreateWindow") end

function GodLib:Unload()
	if self._currentWindow then pcall(function() self._currentWindow:Destroy() end) end
	self:Cleanup()
	if self._gui then pcall(function() self._gui:Destroy() end) end
	genv.GodLib = nil
end

