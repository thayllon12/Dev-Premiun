function Library:_addToggle(section,id,options)
    options = options or {}
    local state = options.Default or false

    local row = self:_row(section,options)

    local track = new("TextButton", {
        Position = UDim2.new(1,-43,.5,-9),
        Size = UDim2.fromOffset(35,18),
        BackgroundColor3 = state and C.Gold or C.Off,
        Text = "",
        AutoButtonColor = false,
        Parent = row
    })
    corner(track,9)

    local knob = new("Frame", {
        Position = state and UDim2.new(1,-10,.5,0) or UDim2.new(0,10,.5,0),
        AnchorPoint = Vector2.new(.5,.5),
        Size = UDim2.fromOffset(14,14),
        BackgroundColor3 = C.Cream,
        Parent = track
    })
    corner(knob,7)

    local element = {Value=state}

    function element:SetValue(value)
        state = not not value
        self.Value = state
        tween(track,.15,{BackgroundColor3=state and C.Gold or C.Off})
        tween(knob,.15,{
            Position=state and UDim2.new(1,-10,.5,0) or UDim2.new(0,10,.5,0)
        })
        if options.Callback then
            options.Callback(state)
        end
    end

    track.MouseButton1Click:Connect(function()
        element:SetValue(not state)
    end)

    self.Elements[id] = element
    return element
end

