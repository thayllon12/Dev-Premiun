local function safe(fn, ...)
	local args = { ... }
	local ok, result = pcall(function() return fn(table.unpack(args)) end)
	if not ok then
		log("erro: " .. tostring(result))
		return nil
	end
	return result
end

-- ========== PROTEÇÃO AVANÇADA (multi-executor) ==========
local function randomName(len)
	len = len or 12
	local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local s = ""
	for i = 1, len do
		local idx = math.random(1, #chars)
		s = s .. chars:sub(idx, idx)
	end
	return s
end

local function getHiddenParent()
	-- 1. gethui (mais seguro na maioria dos executors modernos)
	if gethui then
		local ok, res = pcall(gethui)
		if ok and res then
			log("usando gethui()")
			return res
		end
	end

	-- 2. syn.protect_gui / protect_gui → CoreGui
	if (syn and syn.protect_gui) or protect_gui then
		local ok, res = pcall(function() return game:GetService("CoreGui") end)
		if ok and res then
			log("usando CoreGui + protect")
			return res
		end
	end

	-- 3. cloneref CoreGui (Script-Ware / alguns)
	if cloneref then
		local ok, res = pcall(function()
			return cloneref(game:GetService("CoreGui"))
		end)
		if ok and res then
			log("usando cloneref(CoreGui)")
			return res
		end
	end

	-- 4. Fallback PlayerGui
	log("fallback → PlayerGui (proteção limitada)")
	return playerGui
end

local function protectGui(gui)
	if not gui then return end

	-- Nome aleatório para dificultar scanners
	pcall(function()
		gui.Name = randomName(16)
	end)

	-- syn.protect_gui
	if syn and syn.protect_gui then
		local ok, err = pcall(syn.protect_gui, gui)
		if ok then log("syn.protect_gui OK") return end
		log("syn.protect_gui falhou: " .. tostring(err))
	end

	-- protect_gui genérico
	if protect_gui then
		local ok, err = pcall(protect_gui, gui)
		if ok then log("protect_gui OK") return end
		log("protect_gui falhou: " .. tostring(err))
	end

	-- hidestatus / hidesgui (alguns executors)
	if hidesgui then
		pcall(hidesgui, gui)
	elseif hide_gui then
		pcall(hide_gui, gui)
	end

	-- isnetworkowner style tricks (apenas log)
	if not ((syn and syn.protect_gui) or protect_gui or hidesgui or hide_gui) then
		log("nenhuma função de proteção nativa encontrada – GUI pode ser detectada por anti-cheats avançados")
	end
end

