								AnchorPoint = Vector2.new(1, 0.5),
								Position = UDim2.new(1, -10, 0.5, 0),
								Size = UDim2.fromOffset(13, 13),
								BackgroundTransparency = 1,
								Image = GetIcon("check"),
								ImageColor3 = Theme.Gold,
								Parent = item
							})
						end
						item.MouseEnter:Connect(function() Tween(item, {BackgroundTransparency = selected and 0.55 or 0.82}) end)
						item.MouseLeave:Connect(function() Tween(item, {BackgroundTransparency = selected and 0.72 or 1}) end)
						item.MouseButton1Click:Connect(function()
							current = opt
							selectedLabel.Text = opt
							Close()
							SafeCall(callback, opt)
						end)
					end
					menu.Size = UDim2.fromOffset(math.max(absSize.X, 150), #values * (itemH + 3) + 14)
					Tween(menu, {GroupTransparency = 0}, TweenInfo.new(0.15))
				end)
				return {
