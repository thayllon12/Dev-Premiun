local function GetIcon(name)
	if typeof(name) ~= "string" then return "" end
	return GodLib.Icons[name] or ""
end

function GodLib:RegisterIcon(name, assetId)
	if typeof(name) == "string" and typeof(assetId) == "string" then
		GodLib.Icons[name] = assetId
	end
end

function GodLib:GetIcon(name)
	return GetIcon(name)
end

local function Create(class, props)
	local obj = Instance.new(class)
	if obj:IsA("GuiObject") then
		obj.BorderSizePixel = 0
	end
	if props then
		local parent = props.Parent
		props.Parent = nil
		for k, v in pairs(props) do
			pcall(function()
				obj[k] = v
			end)
		end
		if parent then
			obj.Parent = parent
		end
	end
	return obj
end

local function Corner(obj, radius)
	return Create("UICorner", {
		CornerRadius = UDim.new(0, radius or 8),
		Parent = obj
	})
end

local function Stroke(obj, color, thickness, transparency)
	return Create("UIStroke", {
		Color = color or Theme.Border,
		Thickness = thickness or 1.2,
		Transparency = transparency or 0,
		Parent = obj
	})
end

local function Gradient(parent, colors, rotation)
	local seq = {}
	for i, c in ipairs(colors) do
		table.insert(seq, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), c))
	end
	return Create("UIGradient", {
		Color = ColorSequence.new(seq),
		Rotation = rotation or 0,
		Parent = parent
	})
end

local function Tween(obj, props, info)
	info = info or TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function SafeCall(fn, ...)
	if typeof(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[GodLib]", err)
	end
end

local function GetGuiParent()
	local success, result = pcall(function()
		if typeof(gethui) == "function" then
			local ok, g = pcall(gethui)
			if ok and g then return g end
		end
		return CoreGui
	end)
	if success and result then return result end
	return PlayerGui
end

local function MakeGlowBorder(parent, radius, thickness, zIndex)
	local frame = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = zIndex or 1,
		Parent = parent
	})
	Corner(frame, radius)
	local stroke = Stroke(frame, Theme.Gold, thickness or 1.8, 0)
	Gradient(stroke, {Theme.Gold, Theme.Cream, Theme.Orange, Theme.Cream, Theme.Gold})
	local grad = stroke:FindFirstChildOfClass("UIGradient")
	if grad then
		TweenService:Create(grad, TweenInfo.new(2.8, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), {
			Rotation = 360
		}):Play()
	end
	TweenService:Create(stroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.4,
		Thickness = (thickness or 1.8) + 0.9
	}):Play()
	return frame
end

local function MakeFireParticles(parent, titleLabel)
	local layer = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 15,
		Parent = parent
	})
	local particles = {}
	local MAX = 120

	local function colorAt(t)
		if t < 0.5 then
			return Theme.FireYellow:Lerp(Theme.FireOrange, t * 2)
		end
		return Theme.FireOrange:Lerp(Theme.FireRed, (t - 0.5) * 2)
	end

	local function spawn(x, y, ember)
		local w = ember and math.random(2, 4) or math.random(4, 7)
		local h = ember and w or math.random(8, 13)
		local f = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = Theme.FireYellow,
			ZIndex = 15,
			Parent = layer
		})
		Corner(f, 99)
		table.insert(particles, {
			frame = f,
			x = x,
			y = y,
			w = w,
			h = h,
			age = 0,
			life = ember and math.random(80, 140) / 100 or math.random(50, 100) / 100,
			rise = ember and math.random(36, 58) or math.random(16, 28),
			amp = ember and math.random(3, 7) or math.random(1, 3),
			freq = math.random(28, 60) / 10,
			phase = math.random() * math.pi * 2
		})
	end

	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not parent or not parent.Parent then
			if conn then conn:Disconnect() end
			for _, p in ipairs(particles) do
				if p.frame then p.frame:Destroy() end
			end
			table.clear(particles)
			return
		end
		for i = #particles, 1, -1 do
			local p = particles[i]
			p.age = p.age + dt
			local t = p.age / p.life
			if t >= 1 then
				p.frame:Destroy()
				table.remove(particles, i)
			else
				local ease = 1 - (1 - t) ^ 2
				local sway = math.sin(p.age * p.freq + p.phase) * p.amp * t
				local flick = 1 + 0.12 * math.sin(p.age * 22 + p.phase)
				p.frame.Position = UDim2.fromOffset(p.x + sway, p.y - p.rise * ease)
				p.frame.Size = UDim2.fromOffset(
					math.max(1, math.floor(p.w * (1 - 0.5 * t) * flick + 0.5)),
					math.max(1, math.floor(p.h * (1 - 0.3 * t) + 0.5))
				)
				p.frame.BackgroundColor3 = colorAt(t)
				p.frame.BackgroundTransparency = math.clamp(t * t, 0, 1)
			end
		end
	end)

	task.spawn(function()
		while parent and parent.Parent do
			if #particles < MAX and titleLabel and titleLabel.Parent then
				local textW = math.max(60, titleLabel.TextBounds.X)
				for _ = 1, 3 do
					spawn(42 + math.random() * textW, 28 + math.random(-2, 2), false)
				end
				if math.random() < 0.4 then
					spawn(42 + math.random() * textW, 24, true)
				end
			end
			task.wait(0.035)
		end
	end)

	return layer
end

local function MakeDraggable(handle, target, scaleObj)
	local dragging = false
	local startPos, dragStart
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - dragStart
		local s = (scaleObj and scaleObj.Scale) or 1
		delta = delta / s
		target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

