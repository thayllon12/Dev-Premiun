    local row = self:_row(section,options)
    local button = new("TextButton", {
        Position = UDim2.new(1,-120,.5,-13),
        Size = UDim2.fromOffset(112,26),
        BackgroundColor3 = C.Inner,
        Text = "",
        AutoButtonColor = false,
        Parent = row
    })
    corner(button,6)
    stroke(button,C.Gold,.4)

    local label = new("TextLabel", {
        Position = UDim2.fromOffset(8,0),
        Size = UDim2.new(1,-28,1,0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextColor3 = C.Cream,
        Text = tostring(value),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = button
    })

    new("ImageLabel", {
        Position = UDim2.new(1,-18,.5,-5),
        Size = UDim2.fromOffset(10,10),
        BackgroundTransparency = 1,
        Image = Icons.down,
        ImageColor3 = C.Gold,
        Parent = button
    })

    local element = {Value=value}

    function element:SetValue(v)
        if not table.find(values,v) then return end
        value = v
        self.Value = v
        label.Text = tostring(v)
        if options.Callback then options.Callback(v) end
    end

    button.MouseButton1Click:Connect(function()
        self:ClosePopup()

        local menu = new("Frame", {
            Position = UDim2.fromOffset(
                button.AbsolutePosition.X,
                button.AbsolutePosition.Y+button.AbsoluteSize.Y+4
            ),
            Size = UDim2.fromOffset(145,math.min(#values*28+8,170)),
            BackgroundColor3 = C.Dark,
            ZIndex = 100,
            Parent = self.Overlay
        })
        corner(menu,6)
        stroke(menu,C.Gold,0)

        local list = new("ScrollingFrame", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            ScrollBarThickness = 2,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 101,
            Parent = menu
        })

        new("UIListLayout", {
            Padding = UDim.new(0,2),
            Parent = list
        })

        for i,v in ipairs(values) do
            local item = new("TextButton", {
                Size = UDim2.new(1,-5,0,26),
                LayoutOrder = i,
                BackgroundColor3 = v==value and C.Hover or C.Inner,
                Text = tostring(v),
                TextColor3 = C.Cream,
                TextSize = 11,
                Font = Enum.Font.GothamMedium,
                ZIndex = 102,
                Parent = list
            })
            item.MouseButton1Click:Connect(function()
                element:SetValue(v)
                self:ClosePopup()
            end)
        end

        self.Popup = menu
    end)

    self.Elements[id] = element
    return element
end

function Library:_addInput(section,id,options)
    options = options or {}
    local row = self:_row(section,options)

    local input = new("TextBox", {
        Position = UDim2.new(1,-120,.5,-13),
        Size = UDim2.fromOffset(112,26),
        BackgroundColor3 = C.Inner,
        Text = options.Default or "",
        PlaceholderText = options.Placeholder or "Digite...",
        TextColor3 = C.Cream,
        PlaceholderColor3 = C.Muted,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        ClearTextOnFocus = false,
        Parent = row
    })
    corner(input,5)
    stroke(input,C.Gold,.5)

    local element = {Value=input.Text}

    input.FocusLost:Connect(function()
        element.Value = input.Text
        if options.Callback then options.Callback(input.Text) end
    end)

    function element:SetValue(v)
        input.Text = tostring(v)
        self.Value = input.Text
    end

    self.Elements[id] = element
    return element
end

function Library:_addKeybind(section,id,options)
    options = options or {}
    local key = options.Default or Enum.KeyCode.RightShift

    local row = self:_row(section,options)

    local button = new("TextButton", {
        Position = UDim2.new(1,-120,.5,-13),
        Size = UDim2.fromOffset(112,26),
        BackgroundColor3 = C.Inner,
        Text = key.Name,
        TextColor3 = C.Gold,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        Parent = row
    })
    corner(button,5)
    stroke(button,C.Gold,.4)

    local element = {Value=key}
    local listening = false

    button.MouseButton1Click:Connect(function()
        listening = true
        button.Text = "Pressione..."
    end)

    local connection = UIS.InputBegan:Connect(function(input,processed)
        if not listening or input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end
        listening = false
        key = input.KeyCode
        element.Value = key
        button.Text = key.Name
        if options.Callback then options.Callback(key) end
    end)

    table.insert(self.Connections,connection)

    self.Elements[id] = element
    return element
end

