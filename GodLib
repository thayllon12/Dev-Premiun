	if not gui then return end
	local container = ensureNotifContainer(gui)
	local hold = config.Duration or 5
	local card = new("Frame", { Size = UDim2.fromOffset(280, 64), BackgroundColor3 = MENU_BG, BackgroundTransparency = 1, Parent = container })
	addCorner(card, 8)
	makeGlowBorder(card, 8, 1.2, 2)
