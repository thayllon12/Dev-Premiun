				local function Close()
					if not menu then return end
					open = false
					Tween(chevron, {Rotation = 0})
					Tween(btnStroke, {Transparency = 0.45})
					local m = menu
					menu = nil
					Tween(m, {GroupTransparency = 1}, TweenInfo.new(0.15))
					task.delay(0.16, function() if m then m:Destroy() end end)
				end
				btn.MouseButton1Click:Connect(function()
					if open then Close() return end
					open = true
					Tween(chevron, {Rotation = 180})
					Tween(btnStroke, {Transparency = 0})
					local abs = btn.AbsolutePosition
					local absSize = btn.AbsoluteSize
					menu = Create("CanvasGroup", {
						Position = UDim2.fromOffset(abs.X, abs.Y + absSize.Y + 5),
						Size = UDim2.fromOffset(math.max(absSize.X, 150), 0),
