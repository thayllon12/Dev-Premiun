	local winRef = self._window
	swatch.MouseButton1Click:Connect(function()
		if winRef._closePopup then local fn = winRef._closePopup winRef._closePopup = nil fn() end
		local overlay, uiScale = winRef._overlay, winRef._uiScale
		local k = uiScale.Scale
		local function px(n) return math.max(1, math.floor(n * k + 0.5)) end
		local origin, bp, bs = overlay.AbsolutePosition, swatch.AbsolutePosition, swatch.AbsoluteSize
		local menuW, menuH = px(200), px(170)
		local x, y = bp.X - origin.X + bs.X - menuW, bp.Y - origin.Y + bs.Y + px(6)
		if bp.Y + bs.Y + px(6) + menuH > origin.Y + overlay.AbsoluteSize.Y - px(8) then y = bp.Y - origin.Y - menuH - px(6) end
		
		local catcher = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Parent = overlay })
		local menu = new("CanvasGroup", { Position = UDim2.fromOffset(x, y - px(6)), Size = UDim2.fromOffset(menuW, menuH), BackgroundColor3 = MENU_BG, GroupTransparency = 1, Parent = overlay })
		addCorner(menu, px(7))
		local preview = new("Frame", { Position = UDim2.fromOffset(px(10), px(10)), Size = UDim2.new(1, -px(20), 0, px(28)), BackgroundColor3 = opt.Value, Parent = menu })
		addCorner(preview, px(5))
		addStroke(preview, GOLD, 1, 0.4)
		local h, s, v = opt.Value:ToHSV()
		
		local function updateColor()
			local col = Color3.fromHSV(h, s, v)
			preview.BackgroundColor3 = col
			opt:Set(col)
			if config.Callback then pcall(config.Callback, col) end
		end
		
		local function makeColorSlider(label, order, value, onChange, gradient)
			local rowFrame = new("Frame", { Position = UDim2.fromOffset(px(10), px(46) + (order - 1) * px(34)), Size = UDim2.new(1, -px(20), 0, px(28)), BackgroundTransparency = 1, Parent = menu })
			new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, px(12)), Font = Enum.Font.GothamBold, TextSize = px(10), TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Text = label, Parent = rowFrame })
			local trk = new("Frame", { Position = UDim2.fromOffset(0, px(16)), Size = UDim2.new(1, 0, 0, px(8)), BackgroundColor3 = Color3.fromRGB(50, 50, 50), Parent = rowFrame })
			addCorner(trk, px(4))
			if gradient then
				local img = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = trk })
				addCorner(img, px(4))
				new("UIGradient", { Color = ColorSequence.new(gradient), Parent = img })
			end
			local kn = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(value, 0, 0.5, 0), Size = UDim2.fromOffset(px(10), px(10)), BackgroundColor3 = CREAM, Parent = trk })
			addCorner(kn, px(5))
			local hit = new("TextButton", { BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.fromScale(1, 1), Text = "", Parent = trk })
			local dragging = false
			local function set(x)
				local p = math.clamp((x - trk.AbsolutePosition.X) / trk.AbsoluteSize.X, 0, 1)
				kn.Position = UDim2.new(p, 0, 0.5, 0)
				onChange(p)
			end
			hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true set(input.Position.X) end end)
			UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then set(input.Position.X) end end)
			UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
		end
		
		makeColorSlider("HUE", 1, h, function(p) h = p updateColor() end, {
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
			ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)), ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
			ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)), ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
		})
		makeColorSlider("SATURAÇÃO", 2, s, function(p) s = p updateColor() end, { ColorSequenceKeypoint.new(0, Color3.fromHSV(h, 0, v)), ColorSequenceKeypoint.new(1, Color3.fromHSV(h, 1, v)) })
		makeColorSlider("VALOR", 3, v, function(p) v = p updateColor() end, { ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)), ColorSequenceKeypoint.new(1, Color3.fromHSV(h, s, 1)) })
		
		makeGlowBorder(menu, px(7), 1.5, 5)
		TweenService:Create(menu, FAST, { GroupTransparency = 0 }):Play()
		TweenService:Create(menu, FAST, { Position = UDim2.fromOffset(x, y) }):Play()
		winRef._closePopup = function()
			catcher:Destroy()
			TweenService:Create(menu, FAST, { GroupTransparency = 1 }):Play()
			task.delay(FAST.Time, function() menu:Destroy() end)
		end
		catcher.MouseButton1Click:Connect(function() if winRef._closePopup then local fn = winRef._closePopup winRef._closePopup = nil fn() end end)
	end)
	return opt
end

local Window = {}
Window.__index = Window

function Window:AddTab(config)
	config = config or {}
	local index = #self._tabs + 1
	local name, tabIcon = config.Title or ("Tab" .. index), config.Icon or "sun"
	
	local button = new("TextButton", { Position = UDim2.fromOffset(6, 44 + (index - 1) * 40), Size = UDim2.fromOffset(88, 36), BackgroundColor3 = GOLD, BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Parent = self._window })
	addCorner(button, 5)
	local accent = new("Frame", { Position = UDim2.fromOffset(0, 8), Size = UDim2.fromOffset(3, 20), BackgroundColor3 = GOLD, Visible = false, Parent = button })
	addCorner(accent, 2)
	local iconLabel = new("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(18, 18), Size = UDim2.fromOffset(16, 16), Image = icon(tabIcon), ImageColor3 = MUTED, Parent = button })
	local label = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(32, 0), Size = UDim2.fromOffset(54, 36), Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left, Text = name, Parent = button })
	
	local page = new("Frame", { Position = UDim2.fromOffset(101, 34), Size = UDim2.new(1, -101, 1, -34), BackgroundTransparency = 1, Visible = false, Parent = self._window })
	new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 0, 20), Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = CREAM, TextXAlignment = Enum.TextXAlignment.Left, Text = name, Parent = page })
	new("Frame", { Position = UDim2.fromOffset(8, 27), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = BORDER, Parent = page })
	new("Frame", { Position = UDim2.fromOffset(8, 26), Size = UDim2.fromOffset(48, 3), BackgroundColor3 = GOLD, Parent = page })
	
	local list = new("ScrollingFrame", { Position = UDim2.fromOffset(4, 34), Size = UDim2.new(1, -8, 1, -38), BackgroundTransparency = 1, ScrollBarThickness = 2, ScrollBarImageColor3 = GOLD, ScrollingDirection = Enum.ScrollingDirection.Y, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), Parent = page })
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	new("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), Parent = list })
	
	local tab = setmetatable({ _window = self, _index = index, _name = name, _page = page, _list = list, _order = 0, _button = button, _accent = accent, _icon = iconLabel, _label = label }, Tab)
	table.insert(self._tabs, tab)
	table.insert(self._navButtons, { button = button, accent = accent, icon = iconLabel, label = label })
	table.insert(self._pages, page)
	button.MouseButton1Click:Connect(function() self:SelectTab(index) end)
	if #self._tabs == 1 then self:SelectTab(1) end
	return tab
end

function Window:SelectTab(index)
	if self._closePopup then local fn = self._closePopup self._closePopup = nil fn() end
	for i, nb in ipairs(self._navButtons) do
		local on = (i == index)
		nb.button.BackgroundTransparency = on and 0.8 or 1
		nb.accent.Visible = on
		nb.icon.ImageColor3 = on and GOLD or MUTED
		nb.label.TextColor3 = on and CREAM or MUTED
		self._pages[i].Visible = on
	end
end

function Window:SetVisible(visible) if not visible and self._closePopup then local fn = self._closePopup self._closePopup = nil fn() end self._window.Visible = visible end
function Window:GetVisible() return self._window.Visible end
function Window:Minimize() self:SetVisible(false) end
function Window:Maximize() self:SetVisible(true) end
function Window:Toggle() self:SetVisible(not self._window.Visible) end
function Window:Center() self._window.Position = UDim2.fromScale(0.5, 0.5) end

function Window:SetTitle(title, subtitle)
	self._titleLabel.Text = ('<font color="#FFC400">%s</font> %s'):format(title or "God", subtitle or "Lib")
end

function Window:SetSize(w, h)
	self._winW, self._winH = w, h
	TweenService:Create(self._window, SIZE_INFO, { Size = UDim2.fromOffset(w, h) }):Play()
	local vp = camera.ViewportSize
	local s = math.max(0.5, math.min(1, (vp.X - 16) / w, (vp.Y - 16) / h))
	TweenService:Create(self._uiScale, SIZE_INFO, { Scale = s }):Play()
end

function Window:SetBackground(index)
	if type(index) ~= "number" or index < 1 or index > #BACKGROUNDS then return end
	self._bgIndex = index
	for img in pairs(self._bgTargets) do TweenService:Create(img, FADE, { ImageTransparency = 1 }):Play() end
	task.delay(FADE.Time, function()
		for img, alpha in pairs(self._bgTargets) do
			if img.Parent then
				img.Image = BACKGROUNDS[index]
				TweenService:Create(img, FADE, { ImageTransparency = alpha }):Play()
			end
		end
	end)
end

function Window:NextBackground() self:SetBackground(self._bgIndex % #BACKGROUNDS + 1) end

function Window:GetTab(name)
	for _, t in ipairs(self._tabs) do if t._name == name then return t end end
	return nil
end

function Window:Destroy()
	if self._closePopup then pcall(self._closePopup) end
	if self._gui then pcall(function() self._gui:Destroy() end) end
	if GodLib._currentWindow == self then GodLib._currentWindow = nil end
end

function GodLib:CreateWindow(config)
	config = config or {}
	if self._currentWindow then pcall(function() self._currentWindow:Destroy() end) end
	
	local gui = Instance.new("ScreenGui")
	gui.Name = "GodLib"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	protectGui(gui)
	
	local ok = pcall(function() gui.Parent = guiParent end)
	if not ok or not gui.Parent then
		log("Falha ao parentear em guiParent, usando PlayerGui")
		gui.Parent = playerGui
	end
	
	local winW = (config.Size and config.Size.X.Offset) or 500
	local winH = (config.Size and config.Size.Y.Offset) or 340
	
	local window = new("Frame", { Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(winW, winH), BackgroundColor3 = DARK, Parent = gui })
	addCorner(window, 8)
	local uiScale = new("UIScale", { Parent = window })
	
	local function fitScale()
		local vp = camera.ViewportSize
		uiScale.Scale = math.max(0.5, math.min(1, (vp.X - 16) / winW, (vp.Y - 16) / winH))
	end
	fitScale()
	track(camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitScale))
	
	local bgIndex = 1
	local bgTargets = {}
	local bgImage = new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = BACKGROUNDS[bgIndex], ScaleType = Enum.ScaleType.Crop, ImageTransparency = BG_TRANSPARENCY, Parent = window })
	addCorner(bgImage, 8)
	bgTargets[bgImage] = BG_TRANSPARENCY
	local shade = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = DARK, BackgroundTransparency = 0.3, Parent = window })
	addCorner(shade, 8)
	makeGlowBorder(window, 8, 1.5, 15)
	
	local overlay = new("Frame", { Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local titleBar = new("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Parent = window })
	makeDraggable(titleBar, window, uiScale)
	
	local titleLogo = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 17), Size = UDim2.fromOffset(20, 20), Image = LOGO, ScaleType = Enum.ScaleType.Fit, Parent = titleBar })
	local logoScale = new("UIScale", { Parent = titleLogo })
	
	local titleLabel = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(36, 0), Size = UDim2.fromOffset(200, 34), Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = CREAM, TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Text = ('<font color="#FFC400">%s</font> %s'):format(config.Title or "God", config.SubTitle or "Lib"), Parent = titleBar })
	
	local divider = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -86, 0, 17), Size = UDim2.fromOffset(38, 2), BackgroundColor3 = Color3.new(1, 1, 1), Rotation = -65, Parent = titleBar })
	new("UIGradient", { Color = ColorSequence.new(ORANGE, GOLD), Transparency = NumberSequence.new(0.3, 0), Parent = divider })
	
	local escanorLayer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 10, Parent = window })
	local sunGlow = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(36 + 60, 20), Size = UDim2.fromOffset(150, 150), BackgroundTransparency = 1, Image = GLOW_IMG, ImageColor3 = ESCANOR_ORANGE, ImageTransparency = 0.4, ZIndex = 9, Parent = escanorLayer })
	addCorner(sunGlow, 75)
	
	local particles = {}
	local MAX_PARTICLES = 200
	
	local function spawnParticle(isEmber, spread)
		local originX = 36 + math.random(0, 120)
		local originY = 20 + math.random(-5, 5)
		local size = isEmber and math.random(2, 4) or math.random(6, 12)
		local frame = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(originX, originY), Size = UDim2.fromOffset(size, size), BackgroundColor3 = ESCANOR_WHITE, ZIndex = 11, Parent = escanorLayer })
		addCorner(frame, size / 2)
		
		table.insert(particles, {
			frame = frame, x = originX, y = originY, w = size, h = size, age = 0,
			life = isEmber and math.random(60, 120) / 100 or math.random(40, 80) / 100,
			rise = isEmber and math.random(40, 80) or math.random(20, 40),
			amp = isEmber and math.random(5, 15) or math.random(2, 8),
			freq = math.random(40, 100) / 10,
			phase = math.random() * math.pi * 2,
			isEmber = isEmber,
			spread = spread or 1
		})
	end
	
	track(RunService.RenderStepped:Connect(function(dt)
		if not gui.Parent then return end
		
		local pulse = 1 + math.sin(tick() * 4) * 0.15
		sunGlow.Size = UDim2.fromOffset(180 * pulse, 180 * pulse)
		sunGlow.ImageColor3 = ESCANOR_YELLOW:Lerp(ESCANOR_RED, (math.sin(tick() * 2) + 1) / 2)
		sunGlow.ImageTransparency = 0.3 + math.sin(tick() * 5) * 0.1
		
		for i = #particles, 1, -1 do
			local p = particles[i]
			p.age = p.age + dt
			local t = p.age / p.life
			if t >= 1 then
				p.frame:Destroy()
				table.remove(particles, i)
			else
				local ease = 1 - (1 - t) ^ 2
				local sway = math.sin(p.age * p.freq + p.phase) * p.amp * t
				local flick = 1 + 0.2 * math.sin(p.age * 30 + p.phase)
				local riseY = p.y - p.rise * ease
				local spreadX = p.x + sway * p.spread
				
				p.frame.Position = UDim2.fromOffset(spreadX, riseY)
				p.frame.Size = UDim2.fromOffset(
					math.max(1, math.floor(p.w * (1 - 0.7 * t) * flick + 0.5)),
					math.max(1, math.floor(p.h * (1 - 0.5 * t) + 0.5))
				)
				
				if t < 0.2 then
					p.frame.BackgroundColor3 = ESCANOR_WHITE
				elseif t < 0.5 then
					p.frame.BackgroundColor3 = ESCANOR_YELLOW
				elseif t < 0.8 then
					p.frame.BackgroundColor3 = ESCANOR_ORANGE
				else
					p.frame.BackgroundColor3 = ESCANOR_RED
				end
				p.frame.BackgroundTransparency = math.clamp(t * t, 0, 1)
			end
		end
	end))
	
	task.spawn(function()
		while gui.Parent do
			if window.Visible and #particles < MAX_PARTICLES then
				for _ = 1, 3 do spawnParticle(false, 1) end
				if math.random() < 0.5 then spawnParticle(true, 1.5) end
			end
			task.wait(0.02)
		end
	end)
	
	task.spawn(function()
		local bump = TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true)
		local spin = TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		while gui.Parent do
			task.wait(math.random(35, 60) / 10)
			if not gui.Parent then break end
			local turn = TweenService:Create(titleLogo, spin, { Rotation = 360 })
			turn:Play()
			TweenService:Create(logoScale, bump, { Scale = 1.2 }):Play()
			turn.Completed:Wait()
			titleLogo.Rotation = 0
		end
	end)
	
	local underline = new("Frame", { Position = UDim2.fromOffset(0, 33), Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(1, 1, 1), Parent = window })
	new("UIGradient", { Color = ColorSequence.new(GOLD, ORANGE), Transparency = NumberSequence.new(0, 0.85), Parent = underline })
	
	local function windowButton(iconName, rightOffset, onClick)
		local b = new("ImageButton", { BackgroundTransparency = 1, AutoButtonColor = false, Image = icon(iconName), ImageColor3 = GOLD, Position = UDim2.new(1, rightOffset, 0, 10), Size = UDim2.fromOffset(14, 14), Parent = titleBar })
		b.MouseEnter:Connect(function() TweenService:Create(b, FAST, { ImageColor3 = CREAM }):Play() end)
		b.MouseLeave:Connect(function() TweenService:Create(b, FAST, { ImageColor3 = GOLD }):Play() end)
		b.MouseButton1Click:Connect(function() pcall(onClick) end)
		return b
	end
	
	local self = setmetatable({ _gui = gui, _window = window, _uiScale = uiScale, _overlay = overlay, _tabs = {}, _navButtons = {}, _pages = {}, _bgIndex = bgIndex, _bgTargets = bgTargets, _bgImage = bgImage, _closePopup = nil, _expanded = false, _winW = winW, _winH = winH, _titleLabel = titleLabel }, Window)
	
	windowButton("minus", -76, function() self:SetVisible(false) end)
	local expandButton
	expandButton = windowButton("maximize", -52, function()
		self._expanded = not self._expanded
		local nw = self._expanded and math.floor(winW * 1.25) or winW
		local nh = self._expanded and math.floor(winH * 1.15) or winH
		expandButton.Image = icon(self._expanded and "minimize" or "maximize")
		self:SetSize(nw, nh)
	end)
	windowButton("x", -28, function() self:Destroy() end)
	
	new("Frame", { Position = UDim2.fromOffset(100, 34), Size = UDim2.new(0, 1, 1, -34), BackgroundColor3 = BORDER, Parent = window })
	
	if config.ShowToggle ~= false then
		local toggleButton = new("TextButton", { Name = "OpenButton", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = DARK, AutoButtonColor = false, Text = "", Parent = gui })
		addCorner(toggleButton, 10)
		local toggleBg = new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = BACKGROUNDS[bgIndex], ScaleType = Enum.ScaleType.Crop, ImageTransparency = BG_TRANSPARENCY, Parent = toggleButton })
		addCorner(toggleBg, 10)
		bgTargets[toggleBg] = BG_TRANSPARENCY
		local toggleShade = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = DARK, BackgroundTransparency = 0.3, Parent = toggleButton })
		addCorner(toggleShade, 10)
		new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(30, 30), BackgroundTransparency = 1, Image = LOGO, ScaleType = Enum.ScaleType.Fit, ZIndex = 2, Parent = toggleButton })
		makeGlowBorder(toggleButton, 10, 1.5, 5)
		makeDraggable(toggleButton, toggleButton, nil, function() self:Toggle() end)
	end
	
	local key = config.MinimizeKey or Enum.KeyCode.RightShift
	track(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not gui.Parent then return end
		if input.KeyCode == key then self:Toggle() end
	end))
	
	if config.AutoBackground ~= false then
		task.spawn(function()
			while gui.Parent do
				task.wait(10)
				if not gui.Parent then break end
				self:NextBackground()
			end
		end)
	end
	
	GodLib._currentWindow = self
	GodLib._gui = gui
	genv.GodLib = GodLib
	return self
end

function GodLib:Unload()
	if self._currentWindow then pcall(function() self._currentWindow:Destroy() end) end
	self:Cleanup()
	if self._gui then pcall(function() self._gui:Destroy() end) end
	genv.GodLib = nil
end

genv.GodLib = GodLib
return GodLib
