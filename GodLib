        PaddingLeft = UDim.new(0,6),
        Parent = self.Sidebar
    })

    self.OpenButton = new("TextButton", {
        Name = "OpenButton",
        Position = UDim2.new(0,12,.5,0),
        AnchorPoint = Vector2.new(0,.5),
        Size = UDim2.fromOffset(48,48),
        BackgroundColor3 = C.Dark,
        Text = "",
        AutoButtonColor = false,
        Parent = gui
    })
    corner(self.OpenButton,10)

    local openBg = new("ImageLabel", {
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        Image = self.Backgrounds[1] or "",
        ImageTransparency = .2,
        Parent = self.OpenButton
    })
    corner(openBg,10)
    self.OpenBackground = openBg

    new("ImageLabel", {
        AnchorPoint = Vector2.new(.5,.5),
        Position = UDim2.fromScale(.5,.5),
        Size = UDim2.fromOffset(30,30),
        BackgroundTransparency = 1,
        Image = options.Logo or LOGO,
        Parent = self.OpenButton
    })

    makeGlow(self.OpenButton,10,1.5)
    makeDraggable(self.OpenButton,self.OpenButton)

    self.OpenButton.MouseButton1Click:Connect(function()
        self:SetVisible(not self.Window.Visible)
    end)

    self.OpenKey = options.ToggleKey or Enum.KeyCode.RightShift

    table.insert(self.Connections,UIS.InputBegan:Connect(function(input,processed)
        if processed or self.Destroyed then return end
        if input.KeyCode == self.OpenKey then
            self:SetVisible(not self.Window.Visible)
        end
    end))

    self:_startBackgroundLoop()

    return self
end

function Library:_startBackgroundLoop()
    task.spawn(function()
        while not self.Destroyed do
            task.wait(10)
            if not self.Destroyed then
                self:SetBackground(self.BackgroundIndex % #self.Backgrounds + 1)
            end
        end
    end)
end

function Library:SetBackground(index)
    if #self.Backgrounds == 0 then return end

    self.BackgroundIndex = ((index-1)%#self.Backgrounds)+1
    local image = self.Backgrounds[self.BackgroundIndex]

    tween(self.Background,.5,{ImageTransparency=1})
    tween(self.OpenBackground,.5,{ImageTransparency=1})

    task.wait(.5)

    if self.Destroyed then return end

    self.Background.Image = image
    self.OpenBackground.Image = image

    tween(self.Background,.5,{ImageTransparency=.2})
    tween(self.OpenBackground,.5,{ImageTransparency=.2})
end

function Library:SetVisible(value)
    self.Window.Visible = value
    self.OpenButton.Visible = not value
    if self.Overlay then
        self.Overlay.Visible = value
    end
    self.Visible = value
end

function Library:SetExpanded(value)
    self.Expanded = value
    local size = value and UDim2.fromOffset(500,340) or self.Size
    tween(self.Window,.35,{Size=size})
end

function Library:SelectTab(tab)
    if type(tab) == "number" then
        tab = self.Tabs[tab]
    end
    if not tab then return end

    self.SelectedTab = tab

    for _,t in ipairs(self.Tabs) do
        local selected = t == tab
        t.Page.Visible = selected
        t.Button.BackgroundTransparency = selected and .8 or 1
        t.Accent.Visible = selected
        t.Icon.ImageColor3 = selected and C.Gold or C.Muted
        t.Label.TextColor3 = selected and C.Cream or C.Muted
    end
end

