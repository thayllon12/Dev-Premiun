function Tab:AddToggle(name, config)
	config = config or {}
	local row = makeRow(self._list, self:_nextOrder(), config.Icon or "user", config.Title or name, config.Description or "")
	local opt = registerOption(name, config.Default == true)
	
	local trackBtn = new("TextButton", { Position = UDim2.new(1, -42, 0.5, -9), Size = UDim2.fromOffset(36, 18), BackgroundColor3 = OFF, AutoButtonColor = false, Text = "", Parent = row })
	addCorner(trackBtn, 9)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = CREAM, Parent = trackBtn })
	addCorner(knob, 7)
	
	local function render(instant)
		local info = TweenInfo.new(instant and 0 or 0.15)
		local on = opt.Value
		TweenService:Create(trackBtn, info, { BackgroundColor3 = on and GOLD or OFF }):Play()
		TweenService:Create(knob, info, { Position = on and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0) }):Play()
	end
	render(true)
	
	trackBtn.MouseButton1Click:Connect(function()
		opt:Set(not opt.Value)
		render(false)
		if config.Callback then pcall(config.Callback, opt.Value) end
	end)
	opt:OnChanged(function() render(false) end)
	
	if config.Keybind then
		track(UserInputService.InputBegan:Connect(function(input, processed)
			if processed then return end
			if input.KeyCode == config.Keybind then
				opt:Set(not opt.Value)
				render(false)
				if config.Callback then pcall(config.Callback, opt.Value) end
			end
		end))
	end
	return opt
end

function Tab:AddSlider(name, config)
	config = config or {}
	local minV, maxV, defV = config.Min or 0, config.Max or 100, config.Default or (config.Min or 0)
	local rounding, prefix, suffix = config.Rounding or 0, config.Prefix or "", config.Suffix or ""
	if minV >= maxV then maxV = minV + 1 end
	local row = makeRow(self._list, self:_nextOrder(), config.Icon or "charge", config.Title or name, config.Description or "")
	local opt = registerOption(name, defV)
	
	local trackBg = new("Frame", { Position = UDim2.new(1, -72, 0.5, -3), Size = UDim2.fromOffset(66, 6), BackgroundColor3 = OFF, Parent = row })
	addCorner(trackBg, 3)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = trackBg })
	addCorner(fill, 3)
	new("UIGradient", { Color = ColorSequence.new(GOLD, ORANGE), Parent = fill })
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = CREAM, Parent = trackBg })
	addCorner(knob, 6)
	new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(1, -102, 0.5, -8), Size = UDim2.fromOffset(26, 16), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = CREAM, TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(defV), Parent = row })
	local valueLabel = row:FindFirstChildOfClass("TextLabel")
	local hit = new("TextButton", { BackgroundTransparency = 1, AutoButtonColor = false, Position = UDim2.new(1, -74, 0.5, -10), Size = UDim2.fromOffset(70, 20), Text = "", Parent = row })
	
	local function applyValue(v, silent)
		local p = (v - minV) / (maxV - minV)
		fill.Size = UDim2.new(p, 0, 1, 0)
		knob.Position = UDim2.new(p, 0, 0.5, 0)
		valueLabel.Text = prefix .. tostring(v) .. suffix
		if not silent then
			opt:Set(v)
			if config.Callback then pcall(config.Callback, v) end
		end
	end
	local function setFromX(x)
		local p = math.clamp((x - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
		local raw = minV + p * (maxV - minV)
		local mult = 10 ^ rounding
		local v = math.floor(raw * mult + 0.5) / mult
		applyValue(math.clamp(v, minV, maxV))
	end
	local dragging = false
	hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true setFromX(input.Position.X) end end)
	track(UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromX(input.Position.X) end end))
	track(UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end))
	applyValue(defV, true)
	return opt
end

function Tab:AddDropdown(name, config)
	config = config or {}
	local options, isMulti = config.Values or {}, config.Multi == true
	if #options == 0 then return registerOption(name, nil) end
	local default = config.Default
	if isMulti then default = default or {} elseif default == nil then default = options[1] end
	local opt = registerOption(name, default)
	local row = makeRow(self._list, self:_nextOrder(), config.Icon or "list", config.Title or name, config.Description or "")
	
	local btn = new("TextButton", { Position = UDim2.new(1, -120, 0.5, -13), Size = UDim2.fromOffset(114, 26), BackgroundColor3 = INNER, AutoButtonColor = false, Text = "", Parent = row })
	addCorner(btn, 6)
	local btnStroke = addStroke(btn, GOLD, 1, 0.45)
	local function displayText()
		local v = opt.Value
		if isMulti then local t = {} for k in pairs(v) do table.insert(t, k) end return #t > 0 and table.concat(t, ", ") or "Nenhum" end
		return tostring(v or "Nenhum")
	end
	local label = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -34, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = CREAM, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = displayText(), Parent = btn })
	local chevron = new("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(10, 10), Image = icon("chevron-down"), ImageColor3 = GOLD, Parent = btn })
	btn.MouseEnter:Connect(function() TweenService:Create(btn, FAST, { BackgroundColor3 = HOVER }):Play() end)
	btn.MouseLeave:Connect(function() TweenService:Create(btn, FAST, { BackgroundColor3 = INNER }):Play() end)
	
	local winRef = self._window
	local function closePopup() if winRef._closePopup then local fn = winRef._closePopup winRef._closePopup = nil fn() end end
	
	btn.MouseButton1Click:Connect(function()
		closePopup()
		local overlay, uiScale = winRef._overlay, winRef._uiScale
		local k = uiScale.Scale
		local function px(n) return math.max(1, math.floor(n * k + 0.5)) end
		local origin, bp, bs = overlay.AbsolutePosition, btn.AbsolutePosition, btn.AbsoluteSize
		local itemH, pad, menuW = px(26), px(5), px(140)
		local menuH = #options * itemH + pad * 2 + (#options - 1) * px(2)
		local x, y = bp.X - origin.X + bs.X - menuW, bp.Y - origin.Y + bs.Y + px(6)
		if bp.Y + bs.Y + px(6) + menuH > origin.Y + overlay.AbsoluteSize.Y - px(8) then y = bp.Y - origin.Y - menuH - px(6) end
		
		local catcher = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Parent = overlay })
		local menu = new("CanvasGroup", { Position = UDim2.fromOffset(x, y - px(6)), Size = UDim2.fromOffset(menuW, menuH), BackgroundColor3 = MENU_BG, GroupTransparency = 1, Parent = overlay })
		addCorner(menu, px(7))
		local menuBg = new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = BACKGROUNDS[winRef._bgIndex], ScaleType = Enum.ScaleType.Crop, ImageTransparency = BG_TRANSPARENCY, Parent = menu })
		addCorner(menuBg, px(7))
		local menuShade = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = DARK, BackgroundTransparency = 0.4, Parent = menu })
		addCorner(menuShade, px(7))
		local list = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = menu })
		new("UIListLayout", { Padding = UDim.new(0, px(2)), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
		new("UIPadding", { PaddingTop = UDim.new(0, pad), PaddingBottom = UDim.new(0, pad), PaddingLeft = UDim.new(0, pad), PaddingRight = UDim.new(0, pad), Parent = list })
		
		local function isSelected(o) if isMulti then return opt.Value[o] == true end return opt.Value == o end
		for i, o in ipairs(options) do
			local selected = isSelected(o)
			local item = new("TextButton", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, itemH), BackgroundColor3 = GOLD, BackgroundTransparency = selected and 0.8 or 1, AutoButtonColor = false, Font = Enum.Font.GothamMedium, TextSize = px(12), TextColor3 = selected and GOLD or CREAM, TextXAlignment = Enum.TextXAlignment.Left, Text = o, Parent = list })
			addCorner(item, px(5))
			new("UIPadding", { PaddingLeft = UDim.new(0, px(9)), Parent = item })
			if selected then new("ImageLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -px(8), 0.5, 0), Size = UDim2.fromOffset(px(11), px(11)), BackgroundTransparency = 1, Image = icon("check"), ImageColor3 = GOLD, Parent = item }) end
			item.MouseEnter:Connect(function() TweenService:Create(item, FAST, { BackgroundTransparency = selected and 0.65 or 0.8 }):Play() end)
			item.MouseLeave:Connect(function() TweenService:Create(item, FAST, { BackgroundTransparency = selected and 0.8 or 1 }):Play() end)
			item.MouseButton1Click:Connect(function()
				if isMulti then
					local newVal = {} for k2, v2 in pairs(opt.Value) do newVal[k2] = v2 end
					if newVal[o] then newVal[o] = nil else newVal[o] = true end
					opt:Set(newVal)
					if config.Callback then pcall(config.Callback, newVal) end
				else
					opt:Set(o)
					if config.Callback then pcall(config.Callback, o) end
					closePopup()
				end
			end)
		end
		makeGlowBorder(menu, px(7), 1.5, 5)
		TweenService:Create(menu, FAST, { GroupTransparency = 0 }):Play()
		TweenService:Create(menu, FAST, { Position = UDim2.fromOffset(x, y) }):Play()
		TweenService:Create(chevron, FAST, { Rotation = 180 }):Play()
		TweenService:Create(btnStroke, FAST, { Transparency = 0 }):Play()
		winRef._closePopup = function()
			catcher:Destroy()
			TweenService:Create(menu, FAST, { GroupTransparency = 1 }):Play()
			TweenService:Create(chevron, FAST, { Rotation = 0 }):Play()
			TweenService:Create(btnStroke, FAST, { Transparency = 0.45 }):Play()
			task.delay(FAST.Time, function() menu:Destroy() end)
		end
		catcher.MouseButton1Click:Connect(closePopup)
	end)
	opt:OnChanged(function() label.Text = displayText() end)
	return opt
end

function Tab:AddKeybind(name, config)
	config = config or {}
	local opt = registerOption(name, config.Default or Enum.KeyCode.RightShift)
	local row = makeRow(self._list, self:_nextOrder(), config.Icon or "keyboard", config.Title or name, config.Description or "")
	local btn = new("TextButton", { Position = UDim2.new(1, -120, 0.5, -13), Size = UDim2.fromOffset(114, 26), BackgroundColor3 = INNER, AutoButtonColor = false, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = GOLD, Text = typeof(opt.Value) == "EnumItem" and opt.Value.Name or tostring(opt.Value), Parent = row })
	addCorner(btn, 6)
	addStroke(btn, GOLD, 1, 0.45)
	
	local listening = false
	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		btn.Text = "Pressione..."
		local conn
		conn = UserInputService.InputBegan:Connect(function(input, processed)
			if processed then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				opt:Set(input.KeyCode)
				btn.Text = input.KeyCode.Name
				if config.Callback then pcall(config.Callback, input.KeyCode) end
				listening = false
				conn:Disconnect()
			end
		end)
	end)
	opt:OnChanged(function(v) btn.Text = typeof(v) == "EnumItem" and v.Name or tostring(v) end)
	if config.Callback then
		track(UserInputService.InputBegan:Connect(function(input, processed)
			if processed then return end
			if input.KeyCode == opt.Value then pcall(config.Callback, opt.Value) end
		end))
	end
	return opt
end

