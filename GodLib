-- ========== API EXTRA (v2) ==========

function GodLib:GetVersion()
	return self.Version
end

function GodLib:IsVisible()
	return self._currentWindow and self._currentWindow.Visible or false
end

function GodLib:SetVisible(v)
	if self._currentWindow then
		self._currentWindow.Visible = v and true or false
	end
end

function GodLib:Toggle()
	if self._currentWindow then
		self._currentWindow.Visible = not self._currentWindow.Visible
	end
end

function GodLib:Center()
	if self._currentWindow then
		self._currentWindow.Position = UDim2.fromScale(0.5, 0.5)
	end
end

function GodLib:SetTitle(title)
	if self._titleLabel then
		self._titleLabel.Text = tostring(title or "")
	end
end

function GodLib:NotifySuccess(title, content, duration)
	self:Notify({ Title = title or "Sucesso", Content = content or "", Duration = duration or 4 })
end

function GodLib:NotifyError(title, content, duration)
	self:Notify({ Title = title or "Erro", Content = content or "", Duration = duration or 5 })
end

function GodLib:NotifyWarn(title, content, duration)
	self:Notify({ Title = title or "Aviso", Content = content or "", Duration = duration or 4 })
end

function GodLib:Destroy()
	self:Cleanup()
	if self._gui then
		pcall(function() self._gui:Destroy() end)
		self._gui = nil
	end
	self._currentWindow = nil
end

function GodLib:GetAllOptions()
	local t = {}
	for k, opt in pairs(self.Options) do
		t[k] = opt:Get()
	end
	return t
end

function GodLib:LoadOptions(tbl)
	if type(tbl) ~= "table" then return end
	for k, v in pairs(tbl) do
		local opt = self.Options[k]
		if opt then opt:Set(v) end
	end
end

-- Flag system simples
GodLib.Flags = GodLib.Flags or {}
function GodLib:SetFlag(name, value)
	self.Flags[name] = value
end
function GodLib:GetFlag(name)
	return self.Flags[name]
end


return GodLib
