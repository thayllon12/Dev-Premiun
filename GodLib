local function new(className, props)
	local obj = Instance.new(className)
	if obj:IsA("GuiObject") then obj.BorderSizePixel = 0 end
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		local ok, err = pcall(function() obj[k] = v end)
		if not ok then log("propriedade " .. k .. " falhou: " .. tostring(err)) end
	end
	obj.Parent = parent
	return obj
end

local function addCorner(obj, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = obj })
end

local function addStroke(obj, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		Parent = obj,
	})
end

-- Escanor Sunshine color ramp (branco quente → amarelo → laranja → vermelho profundo)
local function colorAt(t)
	if t < 0.25 then
		return Color3.fromRGB(255, 255, 220):Lerp(FIRE_YELLOW, t * 4)
	elseif t < 0.55 then
		return FIRE_YELLOW:Lerp(FIRE_ORANGE, (t - 0.25) / 0.3)
	else
		return FIRE_ORANGE:Lerp(FIRE_RED, (t - 0.55) / 0.45)
	end
end

local function makeGlowBorder(parent, radius, thickness, zIndex)
	local frame = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = zIndex or 1,
		Parent = parent,
	})
	addCorner(frame, radius)

	-- Outer soft glow (simula luz do sol)
	local outer = addStroke(frame, FIRE_ORANGE, (thickness or 1.5) + 2.5, 0.55)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, FIRE_YELLOW),
			ColorSequenceKeypoint.new(0.3, GOLD),
			ColorSequenceKeypoint.new(0.5, FIRE_ORANGE),
			ColorSequenceKeypoint.new(0.7, GOLD),
			ColorSequenceKeypoint.new(1, FIRE_YELLOW),
		}),
		Parent = outer,
	})

	local stroke = addStroke(frame, GOLD, thickness or 1.5, 0)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, GOLD),
			ColorSequenceKeypoint.new(0.2, CREAM),
			ColorSequenceKeypoint.new(0.4, FIRE_YELLOW),
			ColorSequenceKeypoint.new(0.6, ORANGE),
			ColorSequenceKeypoint.new(0.8, CREAM),
			ColorSequenceKeypoint.new(1, GOLD),
		}),
		Parent = stroke,
	})

	local gradient = stroke:FindFirstChildOfClass("UIGradient")
	if gradient then
		TweenService:Create(gradient, TweenInfo.new(2.2, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), {
			Rotation = 360,
		}):Play()
	end
	local outerGrad = outer:FindFirstChildOfClass("UIGradient")
	if outerGrad then
		TweenService:Create(outerGrad, TweenInfo.new(3.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), {
			Rotation = -360,
		}):Play()
	end

	-- Pulsação forte estilo Sunshine
	TweenService:Create(stroke, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.35,
		Thickness = (thickness or 1.5) + 1.2,
	}):Play()
	TweenService:Create(outer, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.75,
		Thickness = (thickness or 1.5) + 3.5,
	}):Play()

	return frame
end

local function makeDraggable(handle, target, scaleObj, onTap, connStore)
	local dragging, moved = false, false
	local dragStart, startPos
	local function track(conn)
		if connStore then table.insert(connStore, conn) end
		return conn
	end
	track(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = target.Position
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 4 then moved = true end
			local s = scaleObj and scaleObj.Scale or 1
			delta = delta / s
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			if not moved and onTap then onTap() end
		end
	end))
end

