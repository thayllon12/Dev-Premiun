function GetSavePath()
    if writefile and isfolder then
        local folder = "PumpkinHunt"
        if not isfolder(folder) then pcall(makefolder, folder) end
        return folder .. "/" .. CFG.SaveFileName
    end
end
function SaveStates()
    local path = GetSavePath(); if not path or not writefile then return end
    local data = {
        GodFarm=GodFarm, ShowESP=ShowESP, GodFPS=GodFPS,
        AutoRollStore=AutoRollStore, AutoBringFruits=AutoBringFruits,
        SelectedToolType=SelectedToolType, FastAttack=FastAttack, OrbitMode=OrbitMode,
        HalloweenDoors=HalloweenDoors, AcceptRewards=AcceptRewards, AcceptTeleport=AcceptTeleport,
        HellfirePortal=HellfirePortal, DapperJackAuto=DapperJackAuto, CollectCards=CollectCards,
        CandyCollect=CandyCollect, HalloweenRareFirst=HalloweenRareFirst, SkipOthersPumpkins=SkipOthersPumpkins,
        Tune = { EnemyTimeout=CFG.EnemyTimeout, EventMinutes=CFG.EventMinutes },
        GamePlaceId = game.PlaceId,
    }
    local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then pcall(writefile, path, enc) end
end
function LoadStates()
    local path = GetSavePath()
    if not path or not readfile or not isfile then return nil end
    local ok, e = pcall(isfile, path); if not ok or not e then return nil end
    local ok2, c = pcall(readfile, path); if not ok2 or not c then return nil end
    local ok3, d = pcall(function() return HttpService:JSONDecode(c) end)
    if not ok3 or type(d) ~= "table" then return nil end
    if d.GamePlaceId and d.GamePlaceId ~= game.PlaceId then return nil end
    return d
end
