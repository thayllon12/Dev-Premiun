            or o:IsA("Sparkles") or o:IsA("Beam") or o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
            GodFPSOriginals[o] = { Enabled = o.Enabled }; o.Enabled = false
        end
    end
    GodFPSOriginalLighting = {
        GlobalShadows = Lighting.GlobalShadows, Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, FogEnd = Lighting.FogEnd,
    }
