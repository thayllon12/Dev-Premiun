-- 10. GATE / requestEntrance
--=====================================================================
function IsGateLocked(g) local u = LockedGates[g.Id]; return u ~= nil and os.clock() < u end
function LockGate(g) LockedGates[g.Id] = os.clock() + CFG.GateLockTime end
function BestGate(dest)
    local root = GetRoot(); if not root then return nil end
    local direct = (dest - root.Position).Magnitude
    if direct <= CFG.GateMinimumGain then return nil end
    local best, bc = nil, math.huge
    for _, g in ipairs(ActiveEntrances()) do
        if g.RequestPosition and not IsGateLocked(g) then
            local route = (g.GatePosition.Position - root.Position).Magnitude + (g.DestinationPosition.Position - dest).Magnitude
            local gain = direct - route
            if gain >= CFG.GateMinimumGain and gain / math.max(direct,1) >= CFG.GateMinimumRatio and route < bc then
                best, bc = g, route
            end
        end
    end
    return best
end
function RequestGate(g)
    local c = CommFRemote(); if not c then return false end
    return pcall(function() c:InvokeServer(g.RequestName or "requestEntrance", g.RequestPosition) end)
end
function RouteGate(g, dest)
    HS.mode = "GATE " .. g.Name
    local t0 = os.clock()
    while not Destroyed and os.clock() - t0 < 12 do
        local r = GetRoot(); if not r then return false end
        if (g.GatePosition.Position - r.Position).Magnitude <= CFG.GateExactDistance then break end
        FlyTo(g.GatePosition.Position); RunService.Heartbeat:Wait()
    end
    Halt(); task.wait(CFG.GateStableTime)
    local r = GetRoot(); if not r then return false end
    local start, lastReq, t1 = r.Position, -math.huge, os.clock()
    while not Destroyed and os.clock() - t1 < CFG.GateTeleportTimeout + 2 do
        if os.clock() - lastReq >= CFG.GateRetryDelay then lastReq = os.clock(); RequestGate(g) end
        r = GetRoot(); if not r then return false end
        if (r.Position - start).Magnitude >= CFG.GateTeleportDistance then LockGate(g); return true end
        task.wait(0.05)
    end
    LockGate(g); return false
end
function TravelFar(dest)
    local root = GetRoot(); if not root then return false end
    if (dest - root.Position).Magnitude < CFG.GateFarDist then return false end
    if IsInDimensionPos(root.Position) then return false end
    local g = BestGate(dest); if not g then return false end
    local ok = RouteGate(g, dest)
    if ok then task.wait(CFG.GateWait) end
    return ok
end
function Go(dest, stop, timeout, abort)
    stop = stop or 3; timeout = timeout or 25
    local t0 = os.clock(); TravelFar(dest)
    if not EnsurePhysics() then return false end
    while not Destroyed do
        local r = GetRoot(); if not r then Halt(); return false end
        if (dest - r.Position).Magnitude <= stop then Halt(); return true end
        if os.clock() - t0 > timeout then Halt(); return false end
        if abort and abort() then Halt(); return false end
        FlyTo(dest); RunService.Heartbeat:Wait()
    end
    Halt(); return false
end
function GoAuto(pos, stop, abort) return Go(pos, stop, nil, abort) end

