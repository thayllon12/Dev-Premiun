function DestroyPhysics()
    if LV and LV.Parent then LV.VectorVelocity = Vector3.zero end
    if PhysFolder then pcall(function() PhysFolder:Destroy() end) end
    if PhysAttach then pcall(function() PhysAttach:Destroy() end) end
    PhysFolder, PhysAttach, LV, AO = nil, nil, nil, nil
end
function EnsurePhysics()
    local root = GetRoot(); if not root then return false end
    NoclipOn = true
    if PhysFolder and PhysFolder.Parent == root and LV and LV.Parent then return true end
    DestroyPhysics()
    PhysFolder = Instance.new("Folder"); PhysFolder.Name = "DFPhysics"; PhysFolder.Parent = root
    PhysAttach = Instance.new("Attachment"); PhysAttach.Name = "DFAttach"; PhysAttach.Parent = root
    LV = Instance.new("LinearVelocity")
    LV.Attachment0 = PhysAttach
    LV.RelativeTo = Enum.ActuatorRelativeTo.World
    LV.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    LV.ForceLimitsEnabled = false
    LV.MaxForce = math.huge
    LV.VectorVelocity = Vector3.zero
    LV.Parent = PhysFolder
    AO = Instance.new("AlignOrientation")
    AO.Attachment0 = PhysAttach
    AO.Mode = Enum.OrientationAlignmentMode.OneAttachment
    AO.RigidityEnabled = true
    AO.MaxTorque = math.huge
    AO.MaxAngularVelocity = math.huge
    AO.Responsiveness = 200
    AO.CFrame = root.CFrame
    AO.Parent = PhysFolder
    local _, h = GetParts()
    if h then h.AutoRotate = false end
    return true
end
function SetVelocity(v) if LV and LV.Parent then LV.VectorVelocity = v end end
function Halt() SetVelocity(Vector3.zero) end
function SetOrientation(pos, look)
    if not AO or not AO.Parent then return end
    local d = look - pos
    if d.Magnitude > 0.001 then AO.CFrame = CFrame.lookAt(pos, pos + d.Unit) end
end
function FlyTo(dest)
    if not EnsurePhysics() then return math.huge end
    local root = GetRoot(); if not root then return math.huge end
    dest = SafePos(dest)
    local off = dest - root.Position; local d = off.Magnitude
    if d <= CFG.ArrivalDistance then Halt(); return d end
    local sp = d > CFG.FarmNearDist and CFG.FarmSpeedFar or CFG.FarmSpeedNear
    SetVelocity(off.Unit * sp)
    SetOrientation(root.Position, dest)
    return d
end
function Release()
    NoclipOn = false; Halt(); DestroyPhysics()
    for part, was in pairs(SavedCollide) do
        if part.Parent then pcall(function() part.CanCollide = was end) end
    end
    SavedCollide = {}
    local c = Player.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then pcall(function() h.AutoRotate = true end) end
end

