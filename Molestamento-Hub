function KnockDoor(d)
    HS.halloweenAt = os.clock()
    local root = GetRoot()
    if not root then return end

    local inst = d.inst
    local _, halloweenFunction = HalloweenRemotes()
    if not inst or not inst.Parent or not halloweenFunction then
        if inst then HS.doorSkip[inst] = os.clock() + CFG.DoorSkip end
        return
    end

    if inst:GetAttribute("DoorOpen") == true then
        HS.doorSkip[inst] = os.clock() + 1
        return
    end
    local cooldown = tonumber(inst:GetAttribute("CooldownUntil")) or 0
    if cooldown > ServerNow() then
        HS.doorSkip[inst] = os.clock() + 1
        return
    end

    local part = d.part
    if not part or not part.Parent then
        HS.doorSkip[inst] = os.clock() + CFG.DoorSkip
        return
    end

    local stand = (part.CFrame * CFrame.new(0, 0, CFG.KnockStand)).Position
    HS.mode = "INDO PARA PORTA"
    if (root.Position - stand).Magnitude > 4 then
        if not GoAuto(stand, 1.5, function()
            return not HalloweenDoors or not EventOn() or not inst.Parent
        end) then
            HS.doorSkip[inst] = os.clock() + CFG.DoorSkip
            return
        end
    end

    root = GetRoot()
    if root then
        root.CFrame = CFrame.lookAt(root.Position,
            Vector3.new(part.Position.X, root.Position.Y, part.Position.Z))
    end

    HS.door = nil
    HS.mode = "BATENDO"

    -- Usa o fluxo confirmado no dump: HalloweenFunction:InvokeServer(door).
    -- Não aciona o ProximityPrompt em paralelo para evitar abertura duplicada.
    local ok, result = pcall(function()
        return halloweenFunction:InvokeServer(inst)
    end)

    local t0 = os.clock()
    while os.clock() - t0 < 3 and not HS.door and HalloweenDoors and EventOn() do
        CloseDialogue()
        task.wait(0.05)
    end

    CloseDialogue()
    if HS.door then
        HS.tally.doors += 1
    else
        HS.doorSkip[inst] = os.clock() + CFG.DoorSkip
        HS.note = ok and "porta sem confirmação" or ("falha ao abrir: " .. tostring(result))
    end
end

