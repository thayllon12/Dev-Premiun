function cardCall(req)
    local rf = NetFunction("ConcentrationGame"); if not rf then return nil end
    local ok, res = pcall(function() return rf:InvokeServer(req) end)
    return ok and res or nil
end
function cardGame()
    for _ = 1, 3 do
        local res = cardCall({ Type = "Start" })
        if res and res.Type == "Started" then
            local gameId, board = res.GameId, res.Board
            local known, pending, wait = {}, nil, 0
            local limit = os.clock() + 600
            while board and os.clock() < limit do
                for i, c in pairs(board.Cells) do if c.Id and c.State ~= "Hidden" then known[i] = c.Id end end
                if os.clock() < wait then task.wait(0.1) else
                    local hidden = {}
                    for i, c in pairs(board.Cells) do if c.State == "Hidden" then table.insert(hidden, i) end end
                    if #hidden == 0 then task.wait(0.2) else
                        local pick
                        if pending and known[pending] then
                            for _, i in ipairs(hidden) do
                                if i ~= pending and known[i] == known[pending] then pick = i; break end
                            end
                        end
                        if not pick then pick = hidden[math.random(#hidden)] end
                        local r = cardCall({ Type = "Flip", GameId = gameId, CellIndex = pick })
                        if not r then task.wait(0.5)
                        elseif r.Type == "Flipped" then
                            board = r.Board or board
                            if r.Result == "Matched" then pending = nil
                            elseif r.Result == "Mismatched" then pending, wait = nil, os.clock() + 2.3
                            else pending = pick end
                        elseif r.Type == "Completed" then HS.tally.cards += 1; return true
                        elseif r.Type == "Failed" then break end
                    end
                end
            end
            cardCall({ Type = "Quit", GameId = gameId })
        end
        task.wait(0.5)
    end
    return false
end
