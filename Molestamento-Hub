local label = Instance.new("TextLabel")
label.Name = "CandyAmount"
label.Size = UDim2.fromOffset(100, 30)
label.Position = UDim2.new(0.5, -8, 0, 12)
label.BackgroundTransparency = 1
label.Text = "..."
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.TextSize = 18
label.Font = Enum.Font.GothamBold
label.TextXAlignment = Enum.TextXAlignment.Left
label.Parent = gui

local function getCandyCorn()
    local net = RS:WaitForChild("Modules"):WaitForChild("Net")
    local remote = net:FindFirstChild("RF/GetAllItemValues")

    if not remote then return nil end

    local success, items = pcall(function()
        return remote:InvokeServer()
    end)

    if not success or type(items) ~= "table" then
        return nil
    end

    local total = 0

    for _, item in pairs(items) do
        if type(item) == "table"
            and item.Key == "Quantity"
            and tonumber(item.ItemId) == 832 then

            total += tonumber(item.Value) or 0
        end
    end

    return total
end

task.spawn(function()
    while gui.Parent do
        local amount = getCandyCorn()

        label.Text = amount ~= nil
            and tostring(amount)
            or "--"

        task.wait(1)
    end
end)

