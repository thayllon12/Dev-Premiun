-- 23. MAIN LOOP
--=====================================================================
function MainStep()
    CloseDialogue()
    local root = GetRoot(); if not root then HS.mode = "SEM PERSONAGEM"; return end
    EnforceWater(root)
    if EscapeStep() then return end

    local now = os.clock()
    if HS.domain and now - math.max(HS.domain.at, HS.lastFight) > CFG.DomainTimeout then
        HS.domain = nil
    end

    local focus = NearestFocusTarget()
    if focus then FightOrbit(focus); return end

    local d = HS.door
    if d then
        if not (d.inst and d.inst.Parent) then
            HS.door = nil
        elseif d.boss then
            if d.closed then
                HS.door = nil
            else
                local pt = (HalloweenDoors and HellfirePortal) and PortalPos() or nil
                if pt then EnterPortal(pt); return end
                if not (HalloweenDoors and HellfirePortal) or now - d.at > 15 then
                    d.flowDone = true
                else
                    HS.mode = "ESPERANDO PORTAL"
                    Halt()
                    return
                end
                HS.mode = "AGUARDANDO FECHAMENTO"
                Halt()
                return
            end
        else
            if not d.flowDone and not d.accepted and now - d.at > 1 then
                d.accepted = true
                FireEvent(AcceptRewards and "AcceptReward" or "DeclineReward")
            end
            CloseDialogue()

            -- Libera a próxima porta somente após o fluxo e o DoorShut.
            if d.flowDone and d.closed then
                HS.door = nil
            elseif d.closeTimedOut then
                HS.doorSkip[d.inst] = os.clock() + CFG.DoorSkip
                HS.note = "evento expirou sem DoorShut"
                HS.door = nil
            else
                HS.mode = "EVENTO " .. (d.event or "?")
                task.wait(0.2)
                return
            end
        end
    end

    if HS.domain then HS.mode = "DOMÍNIO"; Halt(); return end

    local boss = nil
    local folder = Workspace:FindFirstChild("Enemies")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") and IsDapperJack(m) and IsAliveModel(m) then boss = m; break end
        end
    end
    if boss then
        HS.bossSeen = true
        if DapperJackAuto and DapperJackRun(boss) then return end
    elseif HS.bossSeen then
        HS.bossSeen = false
        HS.candyUntil = now + CFG.CandyWindow
    end

    if CandyCollect and now < HS.candyUntil and CollectCandy() then return end
    if CollectCards and CollectCard() then return end

    if HalloweenDoors and EventOn() then
        local spot = SeaSpot()
        if spot and (root.Position - spot).Magnitude > 80 then
            HS.mode = "INDO PARA AS PORTAS"
            if GoAuto(spot, 10, function() return not HalloweenDoors or not EventOn() end) then return end
        end
        local list = DoorList()
        local door = PickDoor(list, spot or root.Position)
        if door then KnockDoor(door); return end
        if #list == 0 and AcceptTeleport then
            local hour = os.date("!%Y%m%d%H")
            if HS.tpHour ~= hour then
                HS.tpHour = hour
                HS.mode = "TELETRANSPORTE"; Halt()
                FireEvent("AcceptEventTeleport"); task.wait(6); return
            end
        end
    end

    if GodFarm then
        FarmTick()
        if FarmNPC or FarmPumpkin then return end
    end
    if AutoBringFruits and BringFruits() then return end

    HS.mode = "ESPERANDO"
    Halt()
end

