function ListenHalloween()
    if HS.listening then return end
    local ev = HalloweenRemotes(); if not ev then return end
    HS.listening = true
    local id = RUN_ID
    local conn = ev.OnClientEvent:Connect(function(kind, inst, who, data)
        if RUN_ID ~= id or Destroyed then return end
        HS.halloweenAt = os.clock()
        if kind == "DoorOpened" then
            local evName = type(data) == "table" and data.Event or nil
            local isBoss = (type(data) == "table" and data.Boss == true) or EventKind(evName) == "boss"
            if who == Player then
                local door = { inst = inst, event = evName, boss = isBoss, at = os.clock(), accepted = false, done = false, closed = false }
                HS.door = door
                TrackDoorClose(door)
                if isBoss then HS.tally.bosses += 1
                else StartEventFlow(evName, inst) end
            end
            if isBoss then HS.portalDoor, HS.portalAt = inst, os.clock() end
        elseif kind == "HellfireBossDeath" then
            HS.tally.bossKills += 1
        elseif kind == "HellfireBossExit" then
            HS.domain = nil
            if HS.door then HS.door.flowDone = true end
        elseif kind == "BossTeleportSound" then
            if os.clock() - HS.portalAt < 90 then
                HS.domain, HS.lastFight = { at = os.clock() }, os.clock()
                if HS.door and HS.door.boss then
                    HS.door.done = true
                    HS.door.flowDone = true
                end
            end
        elseif kind == "PromptEventTeleport" then
            if AcceptTeleport then task.delay(1, function() FireEvent("AcceptEventTeleport") end) end
        elseif kind == "PromptEventReturn" then
            task.delay(1, function() FireEvent("AcceptTeleportReturn") end)
        elseif kind == "DapperJackCard" then
            if CollectCards and typeof(inst) == "Vector3" then
                table.insert(HS.cardList, { pos = inst, at = os.clock() })
            end
        elseif kind == "EventFinished" then
            if HS.door and HS.door.inst == inst then
                HS.door.done = true
                HS.door.flowDone = true
            end
        end
    end)
    table.insert(CONNS, conn)
end

