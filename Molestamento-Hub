function FightOrbit(m)
    local hum = m:FindFirstChildOfClass("Humanoid"); if not hum then return end
    HS.target = m; HS.lastFight = os.clock()
    local t0 = os.clock()
    while not Destroyed and m.Parent and hum.Health > 0 and AnyVisible(m) do
        if os.clock() - t0 > CFG.EnemyTimeout then
            HS.ignored[m] = os.clock() + CFG.EnemyIgnoreTime; break
        end
        local root, tp = GetRoot(), GetPart(m)
        if not root or not tp then break end
        EnsurePhysics()
        HS.lastFight = os.clock(); HS.mode = "COMBATE"; HS.note = m.Name
        local pred = tp.Position + tp.AssemblyLinearVelocity * CFG.PredictionTime
        FlyTo(SafePos(pred + OrbitOffset()))
        local r2 = GetRoot()
        if r2 and (pred - r2.Position).Magnitude <= CFG.AttackRadius then
            FarmAttack(m, m:FindFirstChild("HumanoidRootPart") or tp)
        end
        RunService.Heartbeat:Wait()
    end
    HS.target = nil; Halt()
end

