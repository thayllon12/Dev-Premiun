function RestoreGodFPS()
    if GodFPSGui then
        local f = GodFPSGui:FindFirstChildOfClass("Frame")
        if f then f.BackgroundTransparency = 1 end
    end
    for o, d in pairs(GodFPSOriginals) do
        if o and o.Parent then
            pcall(function()
                if d.Transparency ~= nil then o.Transparency = d.Transparency end
                if d.LocalTransparencyModifier ~= nil then o.LocalTransparencyModifier = d.LocalTransparencyModifier end
                if d.Enabled ~= nil then o.Enabled = d.Enabled end
            end)
        end
    end
    GodFPSOriginals = {}
    if GodFPSOriginalLighting.GlobalShadows ~= nil then
        Lighting.GlobalShadows = GodFPSOriginalLighting.GlobalShadows
        Lighting.Brightness = GodFPSOriginalLighting.Brightness
        Lighting.Ambient = GodFPSOriginalLighting.Ambient
        Lighting.OutdoorAmbient = GodFPSOriginalLighting.OutdoorAmbient
        Lighting.FogEnd = GodFPSOriginalLighting.FogEnd
    end
    GodFPSOriginalLighting = {}
end

