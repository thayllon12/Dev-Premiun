function GetPortalEye()
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local dim = wo and wo:FindFirstChild("VArenaDimension")
    local p = dim and dim:FindFirstChild("PortalEye")
    if not p then return nil end
    if p:IsA("BasePart") then return p end
    if p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
end
function BuildDimensionBounds()
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local dim = wo and wo:FindFirstChild("VArenaDimension")
    if not dim then return nil end
    local portal = dim:FindFirstChild("PortalEye")
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
    local found = false
    for _, o in ipairs(dim:GetDescendants()) do
        if o:IsA("BasePart") and not (portal and o:IsDescendantOf(portal)) then
            local cf, half = o.CFrame, o.Size * 0.5
            for _, sx in ipairs({-1,1}) do for _, sy in ipairs({-1,1}) do for _, sz in ipairs({-1,1}) do
                local p = cf:PointToWorldSpace(Vector3.new(half.X*sx, half.Y*sy, half.Z*sz))
                mn = Vector3.new(math.min(mn.X,p.X), math.min(mn.Y,p.Y), math.min(mn.Z,p.Z))
                mx = Vector3.new(math.max(mx.X,p.X), math.max(mx.Y,p.Y), math.max(mx.Z,p.Z))
                found = true
            end end end
        end
    end
    if not found then return nil end
    local m = CFG.DimensionMargin
    return { Min = mn - Vector3.new(m,m,m), Max = mx + Vector3.new(m,m,m) }
end
function IsInDimensionPos(pos)
    local now = os.clock()
    if DimBounds == nil or now - DimBoundsAt > CFG.DimensionRefresh then
        DimBounds = BuildDimensionBounds(); DimBoundsAt = now
    end
    local b = DimBounds; if not b then return false end
    return pos.X >= b.Min.X and pos.X <= b.Max.X
       and pos.Y >= b.Min.Y and pos.Y <= b.Max.Y
       and pos.Z >= b.Min.Z and pos.Z <= b.Max.Z
end
function EscapeStep()
    if HS.domain then return false end
    local root = GetRoot(); if not root or not IsInDimensionPos(root.Position) then return false end
    local portal = GetPortalEye(); if not portal then return false end
    HS.mode = "ESCAPE V"
    local d = FlyTo(portal.Position)
    if d <= 5 then Halt(); root.CFrame = CFrame.new(portal.Position) end
    return true
end

