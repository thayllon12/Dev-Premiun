function FarmNpcStep(root, npc)
    local head = GetHead(npc); if not head then return end
    local dest = head.Position + Vector3.new(0, CFG.NPCHeight, 0)
    TravelFar(dest)
    root = GetRoot(); if not root then return end
    FlyTo(dest)
    HS.mode = "NPC " .. npc.Name
    if (head.Position - root.Position).Magnitude <= CFG.AttackRadius then
        FarmAttack(npc, head)
    end
end

function FarmPumpkinStep(root, p)
    local obj, part = p.root, p.part

    if not obj or not obj.Parent or not part or not part.Parent then
        if obj then HiddenPumpkins[obj] = true end
        FarmPumpkin = nil
        FarmScanAt = 0
        return
    end

    local cracked = obj:GetAttribute("PumpkinCrackedBy")
    if cracked ~= nil and cracked ~= Player.UserId then
        HiddenPumpkins[obj] = true
        FarmPumpkin = nil
        FarmScanAt = 0
        return
    end

    if not PumpkinAlive(obj) then
        HS.tally.pumpkins += 1
        if obj:GetAttribute("PumpkinRare") == true then
            HS.tally.rare += 1
        end

        HiddenPumpkins[obj] = true
        FarmPumpkin = nil
        FarmScanAt = 0
        return
    end

    -- TROCA IMEDIATA AO ATINGIR 3 HITS
    local hits = PumpkinHitsOf(obj)

    if hits >= 3 then
        HiddenPumpkins[obj] = true
        FarmPumpkin = nil
        FarmScanAt = 0
        return
    end

    local dest = part.Position
    TravelFar(dest)

    root = GetRoot()
    if not root then return end

    local dist = (dest - root.Position).Magnitude

    if dist > CFG.PumpkinDistance then
        FlyTo(dest)
    else
        Halt()
    end

    HS.mode = "ABÓBORA"

    if dist <= CFG.AttackRadius then
        FarmAttack(obj, part)
    end
end

function FarmTick()
    local root = GetRoot()
    if not root then return end

    local now = os.clock()

    if FarmNPC and not NPCValid(FarmNPC) then
        DeadNPCs[FarmNPC] = true
        FarmNPC = nil
    end

    if FarmPumpkin then
        local obj = FarmPumpkin.root

        if not obj or not obj.Parent or not PumpkinAlive(obj) then
            if obj then HiddenPumpkins[obj] = true end
            FarmPumpkin = nil
            FarmScanAt = 0

        elseif PumpkinHitsOf(obj) >= 3 then
            HiddenPumpkins[obj] = true
            FarmPumpkin = nil
            FarmScanAt = 0
        end
    end

    if now - FarmScanAt >= CFG.ScanInterval
        or (not FarmNPC and not FarmPumpkin) then

        FarmScanAt = now

        local npc = GetNearestFarmNPC()

        if npc then
            FarmNPC = npc
            FarmPumpkin = nil
        else
            FarmNPC = nil
            FarmPumpkin = GetNearestFarmPumpkin()
        end
    end

    if FarmNPC then
        FarmNpcStep(root, FarmNPC)
    elseif FarmPumpkin then
        FarmPumpkinStep(root, FarmPumpkin)
    else
        Halt()
    end
end

