function BringEnemy()
    local root, enemies = GetRoot(), Workspace:FindFirstChild("Enemies")
    if not root or not enemies then return end
    pcall(function() if sethiddenproperty then sethiddenproperty(Player, "SimulationRadius", math.huge) end end)
    local target = root.Position - Vector3.new(0, CFG.NPCHeight, 0)
    local range, count = math.clamp(CFG.BringRange, 1, 300), 0
    for _, mob in ipairs(enemies:GetChildren()) do
        if Destroyed or count >= CFG.MaxBringMobs then break end
        if mob:IsA("Model") and (IsSnowman(mob) or IsJack(mob)) and IsAliveModel(mob) and AnyVisible(mob) then
            local mr = mob:FindFirstChild("HumanoidRootPart")
            if mr and not mr:GetAttribute("Tweening") then
                local d = (mr.Position - target).Magnitude
                if d <= range then
                    count += 1
                    mr:SetAttribute("Tweening", true)
                    if BringTweens[mr] then pcall(function() BringTweens[mr]:Cancel() end) end
                    local tw = TweenService:Create(mr, TweenInfoBring, { CFrame = CFrame.new(target) })
                    BringTweens[mr] = tw
                    tw.Completed:Once(function()
                        if mr and mr.Parent then mr:SetAttribute("Tweening", false) end
                        BringTweens[mr] = nil
                    end)
                    tw:Play()
                end
            end
        end
    end
end

