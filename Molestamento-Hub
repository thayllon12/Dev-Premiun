-- NPCs interativos guardam seus remotes na pasta identificada pelo EventId.
function EventRemote(inst, remoteName)
    if not inst or not remoteName then return nil end
    local eventId = inst:GetAttribute("EventId")
    if eventId == nil then return nil end
    local folder = ReplicatedStorage:FindFirstChild(tostring(eventId))
    local remote = folder and folder:FindFirstChild(remoteName)
    if remote and remote:IsA("RemoteEvent") then return remote end
    return nil
end

