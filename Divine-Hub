-- Função limpar JobId
local function cleanJobInput(s)
if not s then return "" end
s = tostring(s):gsub("%s+","")
local rbxMatch = s:match("(RBX%-[%w%-]+)")
if rbxMatch then return rbxMatch end
local lastSeg = s:match(".*/([^/?#]+)")
if lastSeg and #lastSeg > 4 then return lastSeg end
return s
end

