miniMenu.Parent = gui
miniMenu.Active = true
miniMenu.Draggable = true
Instance.new("UICorner", miniMenu).CornerRadius = UDim.new(0,12)

-- Velocidade label  
speedLabel = Instance.new("TextLabel")  
speedLabel.Size = UDim2.new(1,0,0,35)  
speedLabel.Position = UDim2.new(0,0,0,5)  
speedLabel.BackgroundTransparency = 1  
speedLabel.TextColor3 = Color3.fromRGB(255,255,255)  
speedLabel.Font = Enum.Font.GothamBold  
speedLabel.TextScaled = true  
speedLabel.Text = "Speed: "..FLY_SPEED  
speedLabel.Parent = miniMenu  

local function createButton(text,color,x)  
	local b = Instance.new("TextButton")  
	b.Size = UDim2.new(0,55,0,40)  
	b.Position = UDim2.new(x,0,0.55,0)  
	b.BackgroundColor3 = color  
	b.TextColor3 = Color3.new(1,1,1)  
	b.Font = Enum.Font.GothamBold  
	b.TextScaled = true  
	b.Text = text  
	b.AutoButtonColor = false  
	b.Parent = miniMenu  
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,10)  

	b.MouseEnter:Connect(function() b.BackgroundColor3 = color:Lerp(Color3.new(1,1,1),0.2) end)  
	b.MouseLeave:Connect(function() b.BackgroundColor3 = color end)  
	return b  
end  

plusBtn = createButton("+", Color3.fromRGB(0,200,0), 0.05)  
minusBtn = createButton("-", Color3.fromRGB(200,0,0), 0.30)  
upBtn = createButton("⬆", Color3.fromRGB(80,160,255), 0.55)  
downBtn = createButton("⬇", Color3.fromRGB(255,180,0), 0.80)  

upBtn.MouseButton1Down:Connect(function() jumpPressed = true end)  
upBtn.MouseButton1Up:Connect(function() jumpPressed = false end)  
downBtn.MouseButton1Down:Connect(function() descendPressed = true end)  
downBtn.MouseButton1Up:Connect(function() descendPressed = false end)  
plusBtn.MouseButton1Click:Connect(function()  
	FLY_SPEED = math.min(FLY_SPEED + SPEED_STEP, MAX_SPEED)  
	speedLabel.Text = "Speed: "..FLY_SPEED  
end)  
minusBtn.MouseButton1Click:Connect(function()  
	FLY_SPEED = math.max(FLY_SPEED - SPEED_STEP, MIN_SPEED)  
	speedLabel.Text = "Speed: "..FLY_SPEED  
end)

end

local function destroyMiniMenu()
if miniMenu then miniMenu:Destroy() miniMenu=nil end
end

local function EnableFly()
if flying then return end
flying = true
humanoid.PlatformStand = true
if UIS.TouchEnabled then createMiniMenu() end
end

local function DisableFly()
if not flying then return end
flying = false
humanoid.PlatformStand = false
velocity = Vector3.zero
jumpPressed = false
descendPressed = false
destroyMiniMenu()
end

-- BOTÃO FLY no Divine Hub
local flyBtn = makeBtn("Fly: OFF", 10, 140)
flyBtn.MouseButton1Click:Connect(function()
if flying then
DisableFly()
flyBtn.Text = "Fly: OFF"
flyBtn.BackgroundColor3 = Color3.fromRGB(59,113,237)
else
EnableFly()
flyBtn.Text = "Fly: ON"
flyBtn.BackgroundColor3 = Color3.fromRGB(0,200,0)
end
end)

-- Controles PC
UIS.InputBegan:Connect(function(input,gp)
if gp then return end
if keys[input.KeyCode.Name] ~= nil then keys[input.KeyCode.Name] = true end
if input.KeyCode == Enum.KeyCode.Space then jumpPressed = true end
if input.KeyCode == Enum.KeyCode.LeftShift then descendPressed = true end
end)
UIS.InputEnded:Connect(function(input)
if keys[input.KeyCode.Name] ~= nil then keys[input.KeyCode.Name] = false end
if input.KeyCode == Enum.KeyCode.Space then jumpPressed = false end
if input.KeyCode == Enum.KeyCode.LeftShift then descendPressed = false end
end)

RunService.RenderStepped:Connect(function()
if not flying or not hrp then return end
local cam = workspace.CurrentCamera
local dir = Vector3.new()
if UIS.KeyboardEnabled then
if keys.W then dir += cam.CFrame.LookVector end
if keys.S then dir -= cam.CFrame.LookVector end
if keys.A then dir -= cam.CFrame.RightVector end
if keys.D then dir += cam.CFrame.RightVector end
end
if UIS.TouchEnabled then dir += humanoid.MoveDirection end
if jumpPressed then dir += Vector3.new(0,1,0) end
if descendPressed then dir -= Vector3.new(0,1,0) end
if dir.Magnitude > 0 then velocity = dir.Unit * FLY_SPEED else velocity = Vector3.zero end
hrp.Velocity = velocity
end)

LocalPlayer.CharacterAdded:Connect(function(char)
character = char
hrp = character:WaitForChild("HumanoidRootPart")
humanoid = character:WaitForChild("Humanoid")
if flying then
humanoid.PlatformStand = true
if UIS.TouchEnabled then createMiniMenu() end
end
end)

