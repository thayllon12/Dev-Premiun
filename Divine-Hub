local miniMenu, speedLabel, plusBtn, minusBtn, upBtn, downBtn
local function createMiniMenu()
if not UIS.TouchEnabled then return end
miniMenu = Instance.new("Frame")
miniMenu.Size = UDim2.new(0,270,0,100)
miniMenu.Position = UDim2.new(0.35,0,0.05,0)
miniMenu.BackgroundColor3 = Color3.fromRGB(25,25,25)
