local function exploitPrompt(plant)
	local prompt = plant:FindFirstChild("HarvestPrompt", true) or plant:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt and fireproximityprompt then
		fireproximityprompt(prompt, 1)
		fireproximityprompt(prompt, 0)
	end
end

local function EsperarFimDaOrdenha(cowModel)
	local finalizado = false
	local conexaoMilking, conexaoNotify

	if MilkingControl then
		conexaoMilking = MilkingControl.OnClientEvent:Connect(function(status)
			if status == false then finalizado = true end
		end)
	end

	if NotifyEvent then
		conexaoNotify = NotifyEvent.OnClientEvent:Connect(function(title, message)
			if message and string.find(message, "has no milk yet") then
				finalizado = true
			end
		end)
	end

	local t = 0
	while not finalizado and isMilking and autoFarmActive do
		task.wait(0.2)
		t = t + 0.2
		
		local attrs = obterAtributosVaca(cowModel)
		if not attrs or attrs.StoredLiters <= 0 then
			finalizado = true
			break
		end

		if t > 25 then break end
	end

	if conexaoMilking then conexaoMilking:Disconnect() end
	if conexaoNotify then conexaoNotify:Disconnect() end
end

local function ProcessarAlimentacao(cowModel)
	local attrs = obterAtributosVaca(cowModel)
	if not attrs or attrs.Hunger >= 5 then return end

	local prompt = obterFeedPrompt(cowModel)
	local pos = obterPosicaoVaca(cowModel)
	if not prompt or not pos then return end

	if not verificarEEquiparTrigo() then
		atualizarStatusTexto("Aguardando Trigo...", Color3.fromRGB(255, 200, 0))
		return
	end

	while isMilking or isHarvesting do
		task.wait(0.1)
	end

	isFeeding = true
	atualizarHighlightRig("feed")
	atualizarStatusTexto("Alimentando...", Color3.fromRGB(255, 50, 50))

	teleportarPara(pos)
	task.wait(0.2)

	for i = 1, 2 do
		if verificarEEquiparTrigo() then
			if fireproximityprompt then
				fireproximityprompt(prompt)
			else
				prompt:InputHoldBegin()
				task.wait(prompt.HoldDuration)
				prompt:InputHoldEnd()
			end
			task.wait(0.3)
		else
			atualizarStatusTexto("Aguardando Trigo...", Color3.fromRGB(255, 200, 0))
			break
		end
	end

	countFed = countFed + 1
	atualizarStatusTexto("Alimentado com sucesso!", Color3.fromRGB(0, 255, 150))

	isFeeding = false
	atualizarHighlightRig("none")
end

local function ProcessarOrdenha(cowModel)
	local prompt = obterMilkPrompt(cowModel)
	local pos = obterPosicaoVaca(cowModel)
	if not prompt or not pos then return end

	while isFeeding or isHarvesting do
		task.wait(0.1)
	end

	isMilking = true
	atualizarHighlightRig("farm")
	atualizarStatusTexto("Ordenhando...", Color3.fromRGB(0, 150, 255))

	teleportarPara(pos)
	task.wait(0.2)

	if fireproximityprompt then
		fireproximityprompt(prompt)
	else
		prompt:InputHoldBegin()
		task.wait(prompt.HoldDuration)
		prompt:InputHoldEnd()
	end

	EsperarFimDaOrdenha(cowModel)
	
	countMilk = countMilk + 1
	isMilking = false
	atualizarStatusTexto("OK", Color3.fromRGB(0, 255, 150))
	atualizarHighlightRig("none")
end

task.spawn(function()
	while true do
		task.wait(0.2)
		if autoFeedActive and PlacedFolder then
			for _, cowModel in ipairs(PlacedFolder:GetChildren()) do
				if not autoFeedActive then break end
				while isMilking or isHarvesting do
					task.wait(0.2)
				end

				local attrs = obterAtributosVaca(cowModel)
				if attrs and attrs.IsOwner and attrs.Hunger < 5 then
					ProcessarAlimentacao(cowModel)
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.3)
		if autoFarmActive and not isMilking and PlacedFolder then
			while isFeeding or isHarvesting do
				task.wait(0.2)
			end

			local melhorVaca = nil
			local maiorLitros = -1

			for _, cowModel in ipairs(PlacedFolder:GetChildren()) do
				local attrs = obterAtributosVaca(cowModel)
				if attrs and attrs.IsOwner then
					local estaCheia = (attrs.StoredLiters >= 100) or (attrs.StoredLiters >= attrs.MaxMilkLiters)

					if estaCheia and attrs.StoredLiters > maiorLitros then
						if not (autoFeedActive and attrs.Hunger < 5 and verificarEEquiparTrigo()) then
							maiorLitros = attrs.StoredLiters
							melhorVaca = cowModel
						end
					end
				end
			end

			if melhorVaca and maiorLitros > 0 and autoFarmActive then
				ProcessarOrdenha(melhorVaca)
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.05)
		if autoHarvestActive then
			while isMilking or isFeeding do
				task.wait(0.05)
			end

			local myPlants = {}
			for _, plant in ipairs(CollectionService:GetTagged("Harvestable")) do
				if plant:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
					table.insert(myPlants, plant)
				end
			end

			for _, plant in ipairs(myPlants) do
				if not autoHarvestActive or isMilking or isFeeding then break end
				local prompt = plant:FindFirstChild("HarvestPrompt", true) or plant:FindFirstChildWhichIsA("ProximityPrompt", true)
				if prompt then
					isHarvesting = true
					atualizarHighlightRig("harvest")
					atualizarStatusTexto("Colhendo (TURBO)...", Color3.fromRGB(0, 255, 100))

					teleportarPara(plant:GetPivot().Position)
