		autoFeedBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
		autoFeedBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
		atualizarStatusTexto("OK", Color3.fromRGB(0, 255, 150))
		atualizarHighlightRig("none")
	end
end)

