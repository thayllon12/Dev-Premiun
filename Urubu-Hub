local function atualizarHighlightRig(tipo)
	local character = LocalPlayer.Character
	if not character then return end

	local existingHighlight = character:FindFirstChild("CowManagerHighlight")

	if tipo == "none" then
		if existingHighlight then existingHighlight:Destroy() end
		return
	end

	if not existingHighlight then
		existingHighlight = Instance.new("Highlight")
		existingHighlight.Name = "CowManagerHighlight"
		existingHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		existingHighlight.FillTransparency = 0.5
		existingHighlight.OutlineTransparency = 0
		existingHighlight.Parent = character
	end

	if tipo == "farm" then
		existingHighlight.FillColor = Color3.fromRGB(0, 150, 255)
	elseif tipo == "feed" then
		existingHighlight.FillColor = Color3.fromRGB(255, 50, 50)
	elseif tipo == "harvest" then
		existingHighlight.FillColor = Color3.fromRGB(0, 255, 100)
	end
end

