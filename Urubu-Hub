local function obterAtributosVaca(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	
	local function getAttr(name)
		local val = cowModel:GetAttribute(name)
		if val == nil and inner then val = inner:GetAttribute(name) end
		return val
	end

	local ownerId = getAttr("OwnerUserId")
	local storedLiters = getAttr("StoredLiters") or 0
	local maxMilkLiters = getAttr("MaxMilkLiters") or 100
	local hunger = getAttr("Hunger") or 100
	local isBeingMilked = getAttr("IsBeingMilked")

	if isBeingMilked == nil then isBeingMilked = false end

	return {
		IsOwner = (ownerId == LocalPlayer.UserId),
		StoredLiters = storedLiters,
		MaxMilkLiters = maxMilkLiters,
		Hunger = hunger,
		IsBeingMilked = isBeingMilked
	}
end

local function obterPosicaoVaca(cowModel)
	if not cowModel or not cowModel.Parent then return nil end
	if cowModel:IsA("Model") then
		if cowModel.PrimaryPart then return cowModel.PrimaryPart.Position end
		local ok, pivot = pcall(function() return cowModel:GetPivot() end)
		if ok and pivot then return pivot.Position end
	end
	return nil
end

local function obterMilkPrompt(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	return (inner and inner:FindFirstChild("MilkPrompt")) or cowModel:FindFirstChild("MilkPrompt", true)
end

local function obterFeedPrompt(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	return (inner and inner:FindFirstChild("FeedPrompt")) or cowModel:FindFirstChild("FeedPrompt", true)
end

local function verificarEEquiparTrigo()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local temTrigo = false

	if playerGui then
		local invB = playerGui:FindFirstChild("InvB")
		if invB then
			local slotWheat = invB:FindFirstChild("Slot_wheat", true)
			if slotWheat then
				local textLbl = slotWheat:FindFirstChildOfClass("TextLabel") or slotWheat:FindFirstChild("Amount") or slotWheat:FindFirstChild("Count")
				if textLbl then
					local qtd = tonumber(string.match(textLbl.Text, "%d+"))
					if qtd and qtd > 0 then temTrigo = true
					elseif not qtd and textLbl.Text ~= "" and textLbl.Text ~= "0" then temTrigo = true end
				else
					if slotWheat.Visible then temTrigo = true end
				end
			end
		end
	end

	local char = LocalPlayer.Character
	if not temTrigo and char then
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") and string.find(string.lower(child.Name), "wheat") then
				temTrigo = true
				break
			end
		end
	end

	if not temTrigo then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			for _, tool in ipairs(backpack:GetChildren()) do
				if tool:IsA("Tool") and string.find(string.lower(tool.Name), "wheat") then
					temTrigo = true
					if char then tool.Parent = char end
					break
				end
			end
		end
	end

	if temTrigo and HeldItemRequest then
		HeldItemRequest:FireServer("wheat")
		task.wait(0.03)
	end

	return temTrigo
end

local function teleportarPara(pos)
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		char.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
	end
end

local function ProcessarAlimentacao(cowModel)
	local prompt = obterFeedPrompt(cowModel)
	local pos = obterPosicaoVaca(cowModel)
	if not prompt or not pos then return false end

	if not verificarEEquiparTrigo() then
		atualizarStatusTexto("Aguardando Trigo...", Color3.fromRGB(255, 200, 0))
		return false
	end

	atualizarHighlightRig("feed")
	atualizarStatusTexto("Alimentando...", Color3.fromRGB(255, 50, 50))

	teleportarPara(pos)
	task.wait(0.5)
	
	for i = 1, 2 do
		if verificarEEquiparTrigo() then
			if fireproximityprompt then
				fireproximityprompt(prompt, 1)
				fireproximityprompt(prompt, 0)
			else
				prompt:InputHoldBegin()
				task.wait(prompt.HoldDuration)
				prompt:InputHoldEnd()
			end
		end
	end

	countFed = countFed + 1
	return true
end

local function ProcessarOrdenha(cowModel)
	local prompt = obterMilkPrompt(cowModel)
	local pos = obterPosicaoVaca(cowModel)
	if not prompt or not pos then return false end

	teleportarPara(pos)
	task.wait(0.5)

	if fireproximityprompt then
		fireproximityprompt(prompt, 1)
		fireproximityprompt(prompt, 0)
	else
		prompt:InputHoldBegin()
		task.wait(prompt.HoldDuration)
		prompt:InputHoldEnd()
	end
	
	task.wait(0.5) 
	countMilk = countMilk + 1
	return true
end

-- =========================================================================================
-- BUSCA QUALQUER VACA COM > 0 LITROS, DANDO PRIORIDADE À QUE TEM MAIS
-- =========================================================================================

local function CheckAndDoFarm()
	local melhorVaca = nil
	local maiorLitros = 0

	if not PlacedFolder then return false end

	for _, cowModel in ipairs(PlacedFolder:GetChildren()) do
		local attrs = obterAtributosVaca(cowModel)
		if attrs and attrs.IsOwner and not attrs.IsBeingMilked then
			if attrs.StoredLiters > 0 and attrs.StoredLiters > maiorLitros then
				maiorLitros = attrs.StoredLiters
				melhorVaca = cowModel
			end
		end
	end

	if melhorVaca and maiorLitros > 0 then
		ProcessarOrdenha(melhorVaca)
		return true
	end
	return false
end

local function CheckAndDoHarvest()
	local colheuAlgo = false

	for _, plant in ipairs(CollectionService:GetTagged("Harvestable")) do
		if plant:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
			local prompt = plant:FindFirstChild("HarvestPrompt", true) or plant:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt then
				colheuAlgo = true
				atualizarHighlightRig("harvest")
				atualizarStatusTexto("Colhendo Tudo...", Color3.fromRGB(0, 255, 100))

				teleportarPara(plant:GetPivot().Position)
				task.wait() 
				
				if fireproximityprompt then
					fireproximityprompt(prompt, 1)
					fireproximityprompt(prompt, 0)
				else
					prompt:InputHoldBegin()
					prompt:InputHoldEnd()
				end
				
				countPlants = countPlants + 1
			end
		end
	end
	
	return colheuAlgo
end

local function CheckAndDoFeed()
	if not PlacedFolder then return false end
	for _, cowModel in ipairs(PlacedFolder:GetChildren()) do
		local attrs = obterAtributosVaca(cowModel)
		if attrs and attrs.IsOwner and not attrs.IsBeingMilked and attrs.Hunger < 5 then
			ProcessarAlimentacao(cowModel)
			return true
		end
	end
	return false
end

-- Loop Principal de Execução
task.spawn(function()
	while true do
		task.wait(0.1)
		
		local isPlayerMilkingRightNow = false
		if PlacedFolder then
			for _, cowModel in ipairs(PlacedFolder:GetChildren()) do
				local attrs = obterAtributosVaca(cowModel)
				if attrs and attrs.IsOwner and attrs.IsBeingMilked then
					isPlayerMilkingRightNow = true
					break
				end
			end
		end

		if isPlayerMilkingRightNow then
			atualizarHighlightRig("farm")
			atualizarStatusTexto("Tirando Leite...", Color3.fromRGB(0, 150, 255))
			continue
		end

		local executouAcao = false

		if autoFarmActive and CheckAndDoFarm() then
			executouAcao = true
		elseif autoHarvestActive and CheckAndDoHarvest() then
			executouAcao = true
		elseif autoFeedActive and CheckAndDoFeed() then
			executouAcao = true
		end

		if not executouAcao then
			atualizarHighlightRig("none")
			atualizarStatusTexto("Aguardando...", Color3.fromRGB(0, 255, 150))
		end
	end
end)

