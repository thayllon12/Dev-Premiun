local function obterAtributosVaca(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	local ownerId = cowModel:GetAttribute("OwnerUserId") or (inner and inner:GetAttribute("OwnerUserId"))
	local storedLiters = cowModel:GetAttribute("StoredLiters") or (inner and inner:GetAttribute("StoredLiters")) or 0
	local maxMilkLiters = cowModel:GetAttribute("MaxMilkLiters") or (inner and inner:GetAttribute("MaxMilkLiters")) or 100
	local hunger = cowModel:GetAttribute("Hunger") or (inner and inner:GetAttribute("Hunger"))

	if hunger == nil then hunger = 100 end

	return {
		IsOwner = (ownerId == LocalPlayer.UserId),
		StoredLiters = storedLiters,
		MaxMilkLiters = maxMilkLiters,
		Hunger = hunger
	}
end

local function obterPosicaoVaca(cowModel)
	if not cowModel or not cowModel.Parent then return nil end
	if cowModel:IsA("Model") then
		if cowModel.PrimaryPart then return cowModel.PrimaryPart.Position end
		local ok, pivot = pcall(function() return cowModel:GetPivot() end)
		if ok and pivot then return pivot.Position end
	end
	return nil
end

local function obterMilkPrompt(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	return (inner and inner:FindFirstChild("MilkPrompt")) or cowModel:FindFirstChild("MilkPrompt", true)
end

local function obterFeedPrompt(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	return (inner and inner:FindFirstChild("FeedPrompt")) or cowModel:FindFirstChild("FeedPrompt", true)
end

local function verificarEEquiparTrigo()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local temTrigo = false

	if playerGui then
		local invB = playerGui:FindFirstChild("InvB")
		if invB then
			local slotWheat = invB:FindFirstChild("Slot_wheat", true)
			if slotWheat then
				local textLbl = slotWheat:FindFirstChildOfClass("TextLabel") or slotWheat:FindFirstChild("Amount") or slotWheat:FindFirstChild("Count")
				if textLbl then
					local qtd = tonumber(string.match(textLbl.Text, "%d+"))
					if qtd and qtd > 0 then temTrigo = true
					elseif not qtd and textLbl.Text ~= "" and textLbl.Text ~= "0" then temTrigo = true end
				else
					if slotWheat.Visible then temTrigo = true end
				end
			end
		end
	end

	local char = LocalPlayer.Character
	if not temTrigo and char then
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") and string.find(string.lower(child.Name), "wheat") then
				temTrigo = true
				break
			end
		end
	end

	if not temTrigo then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			for _, tool in ipairs(backpack:GetChildren()) do
				if tool:IsA("Tool") and string.find(string.lower(tool.Name), "wheat") then
					temTrigo = true
					if char then tool.Parent = char end
					break
				end
			end
		end
	end

	if temTrigo and HeldItemRequest then
		HeldItemRequest:FireServer("wheat")
		task.wait(0.1)
	end

	return temTrigo
end

