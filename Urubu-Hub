local function obterAtributosVaca(cowModel)
	if not cowModel then return nil end
	local ownerId = cowModel:GetAttribute("OwnerUserId") or (cowModel:FindFirstChild("Cow") and cowModel.Cow:GetAttribute("OwnerUserId"))
	local storedLiters = cowModel:GetAttribute("StoredLiters") or (cowModel:FindFirstChild("Cow") and cowModel.Cow:GetAttribute("StoredLiters")) or 0
	local hunger = cowModel:GetAttribute("Hunger") or (cowModel:FindFirstChild("Cow") and cowModel.Cow:GetAttribute("Hunger"))

	if hunger == nil then
		hunger = 0
	end

	return {
		IsOwner = (ownerId == LocalPlayer.UserId),
		StoredLiters = storedLiters,
		Hunger = hunger
	}
end

local function obterPosicaoVaca(cowModel)
	if not cowModel or not cowModel.Parent then return nil end
	if cowModel:IsA("Model") then
		if cowModel.PrimaryPart then return cowModel.PrimaryPart.Position end
		local ok, pivot = pcall(function() return cowModel:GetPivot() end)
		if ok and pivot then return pivot.Position end
	end
	return nil
end

local function obterMilkPrompt(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	return (inner and inner:FindFirstChild("MilkPrompt")) or cowModel:FindFirstChild("MilkPrompt", true)
end

local function obterFeedPrompt(cowModel)
	if not cowModel then return nil end
	local inner = cowModel:FindFirstChild("Cow")
	return (inner and inner:FindFirstChild("FeedPrompt")) or cowModel:FindFirstChild("FeedPrompt", true)
end

local function verificarEEquiparTrigo()
	local char = LocalPlayer.Character
	local temTrigo = false

	if char then
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") and string.find(string.lower(child.Name), "wheat") then
				temTrigo = true
				break
			end
		end
	end

	if not temTrigo then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			for _, tool in ipairs(backpack:GetChildren()) do
				if tool:IsA("Tool") and string.find(string.lower(tool.Name), "wheat") then
					temTrigo = true
					if char then
						tool.Parent = char
					end
					break
				end
			end
		end
	end

	if HeldItemRequest then
		HeldItemRequest:FireServer("wheat")
		task.wait(0.2)
		char = LocalPlayer.Character
		if char then
			for _, child in ipairs(char:GetChildren()) do
				if child:IsA("Tool") then
					temTrigo = true
					break
				end
			end
		end
	end

	return temTrigo
end

local function teleportarPara(pos)
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		char.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
	end
end

local function EsperarFimDaOrdenha()
	local finalizado = false
	local conexaoMilking, conexaoNotify

	if MilkingControl then
		conexaoMilking = MilkingControl.OnClientEvent:Connect(function(status)
			if status == false then finalizado = true end
		end)
	end

	if NotifyEvent then
		conexaoNotify = NotifyEvent.OnClientEvent:Connect(function(title, message)
			if message and string.find(message, "has no milk yet") then
				finalizado = true
			end
		end)
	end

	local t = 0
	while not finalizado and isMilking do
		task.wait(0.2)
		t = t + 0.2
		if t > 12 then break end
	end

	if conexaoMilking then conexaoMilking:Disconnect() end
	if conexaoNotify then conexaoNotify:Disconnect() end
end

local function ProcessarAlimentacao(cowModel)
	local prompt = obterFeedPrompt(cowModel)
	local pos = obterPosicaoVaca(cowModel)
	if not prompt or not pos then return end

	while isMilking do
		task.wait(0.2)
	end

	isFeeding = true

	if verificarEEquiparTrigo() then
		statusLabel.Text = "Status: Alimentando..."
		statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)

		teleportarPara(pos)
		task.wait(0.7)

		for i = 1, 2 do
			if fireproximityprompt then
				fireproximityprompt(prompt)
			else
				prompt:InputHoldBegin()
				task.wait(prompt.HoldDuration)
				prompt:InputHoldEnd()
			end
			task.wait(0.3)
		end
	else
		desativarAutoFeed("Sem Trigo no Inventário!")
	end

	isFeeding = false
end

local function ProcessarOrdenha(cowModel)
	local prompt = obterMilkPrompt(cowModel)
	local pos = obterPosicaoVaca(cowModel)
	if not prompt or not pos then return end

	while isMilking or isFeeding do
		task.wait(0.2)
	end

	isMilking = true
	statusLabel.Text = "Status: Ordenhando..."
	statusLabel.TextColor3 = Color3.fromRGB(0, 150, 255)

	teleportarPara(pos)
	task.wait(0.7)

	if fireproximityprompt then
		fireproximityprompt(prompt)
	else
		prompt:InputHoldBegin()
		task.wait(prompt.HoldDuration)
		prompt:InputHoldEnd()
	end

	EsperarFimDaOrdenha()
	isMilking = false

	if not isFeeding then
		statusLabel.Text = "Status: OK"
		statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
	end
end

task.spawn(function()
	while true do
		task.wait(0.5)
		if autoFeedActive and PlacedFolder then
			for _, cowModel in ipairs(PlacedFolder:GetChildren()) do
				if not autoFeedActive then break end

				local attrs = obterAtributosVaca(cowModel)
				if attrs and attrs.IsOwner and attrs.Hunger < 90 then
					ProcessarAlimentacao(cowModel)
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		if autoFarmActive and not isFeeding and PlacedFolder then
			for _, cowModel in ipairs(PlacedFolder:GetChildren()) do
				if not autoFarmActive or isFeeding then break end

				local attrs = obterAtributosVaca(cowModel)
				if attrs and attrs.IsOwner and attrs.StoredLiters > 0 then
					if not (autoFeedActive and attrs.Hunger < 90) then
						ProcessarOrdenha(cowModel)
					end
				end
			end
		end
	end
end)

