local function GetRarity(fName)
    if string.find(fName, "Kitsune") or string.find(fName, "Leopard") or string.find(fName, "Dragon") or string.find(fName, "Dough") then return "Mythical" end
    if string.find(fName, "Buddha") or string.find(fName, "Portal") or string.find(fName, "Rumble") or string.find(fName, "Blizzard") then return "Legendary" end
    if string.find(fName, "Light") or string.find(fName, "Magma") or string.find(fName, "Ghost") then return "Rare" end
    if string.find(fName, "Flame") or string.find(fName, "Ice") or string.find(fName, "Dark") then return "Uncommon" end
    return "Common"
end
