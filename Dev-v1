            end)
        end
        if g.BoneConfig.AutoTrade then
            pcall(function()
                if GetItemCount("Bones") >= 50 then
                    CommF_:InvokeServer("Bones", "Buy", 1, 1)
                end
            end)
        end
        if World3 and g.KatakuriConfig.AutoCraftChalice then
