g.BypassTeleport = function(targetPosition)
    if g.IsTeleporting then return true end
    local hrp = g.GetPart(g.LocalPlayer.Character)
    if not hrp then return false end
    local inRaid = false
    pcall(function()
        inRaid = LocalPlayer.PlayerGui.Main.TopHUDList.RaidTimer.Visible
    end)
    if inRaid then return false end
    local dist = (hrp.Position - targetPosition).Magnitude
    if dist < 275 then
        g.ClearMoversAndStop()
        hrp.CFrame = CFrame.new(targetPosition)
        return true
    end
    if dist > 2750 then
        local bestCf = nil
        local bestDist = math.huge
        for _, cf in ipairs(g.CurrentSeaCFrames) do
            local d = (cf.Position - targetPosition).Magnitude
            if d < bestDist then
                bestDist = d
                bestCf = cf
            end
        end
        if bestCf and (dist - bestDist > 2750) then
            g.IsTeleporting = true
            task.spawn(function()
                g.ClearMoversAndStop()
                for i = 1, 4 do
                    pcall(function() hrp.CFrame = bestCf end)
                    task.wait(0.5)
                    if hrp and (hrp.Position - bestCf.Position).Magnitude < 150 then
                        break
                    end
                end
                task.wait(0.1)
                g.IsTeleporting = false
            end)
            return true
        end
    end
    return false
end
g.ExecuteMovement = function(targetPlayerPos, flightSpeed, orbitSpeed, orbitMode)
	if not g.LocalPlayer.Character then return end
	local hrp = g.GetPart(g.LocalPlayer.Character)
	if not hrp then return end
    if g.BypassTeleport(targetPlayerPos) then return end
	local dist = (targetPlayerPos - hrp.Position).Magnitude
	if dist > 15 then
		local bv = hrp:FindFirstChild("DevAiMover")
		if not bv then
			bv = Instance.new("BodyVelocity")
			bv.Name = "DevAiMover"
			bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bv.Parent = hrp
		end
		local direction = (targetPlayerPos - hrp.Position).Unit
		bv.Velocity = direction * flightSpeed
		hrp.CFrame = CFrame.lookAt(hrp.Position, targetPlayerPos)
	else
		local bv = hrp:FindFirstChild("DevAiMover")
		if bv then bv.Velocity = Vector3.zero end
		hrp.Velocity = Vector3.zero
		local t = tick()
        if orbitMode == 3 then
			if t - g.LastStarTp >= 0.12 then
				g.LastStarTp = t
				local theta = math.random() * 2 * math.pi 
				local phi = math.random() * (math.pi / 2) 
				local offsetX = 15 * math.cos(theta) * math.cos(phi)
				local offsetY = 15 * math.sin(phi)
				local offsetZ = 15 * math.sin(theta) * math.cos(phi)
				local targetPos = targetPlayerPos + Vector3.new(offsetX, offsetY, offsetZ)
				hrp.CFrame = CFrame.lookAt(targetPos, targetPlayerPos)
			end
		else
            hrp.CFrame = CFrame.new(targetPlayerPos)
        end
	end
    pcall(function()
        for _, v in pairs(g.LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end)
end
