                for _, v in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if v.Name:find("Fruit") then
                        hasPhysicalFruit = true
                    end
                end
                for _, v in ipairs(LocalPlayer.Character:GetChildren()) do
                    if v.Name:find("Fruit") then
                        hasPhysicalFruit = true
                    end
                end
                if not hasPhysicalFruit then
                    local invFruits = CommF_:InvokeServer("getInventoryFruits")
                    if type(invFruits) == "table" then
                        for _, fruit in pairs(invFruits) do
                            if fruit.Price < g.RaidConfig.PriceFruit then
                                local properName = g.FruitDictionary[fruit.Name] or fruit.Name
                                CommF_:InvokeServer("LoadFruit", properName)
                                task.wait(1.5)
                                break
                            end
                        end
                    end
                end
            end)
        end
        if g.RaidConfig.AutoAwaken then
            pcall(function()
