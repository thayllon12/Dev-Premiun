                if GetItemCount("Conjured Cocoa") >= 10 and CheckItem("God's Chalice") and not CheckItem("Sweet Chalice") then
                    local hrp = g.GetPart(LocalPlayer.Character)
                    if hrp then
                        local sweetCrafter = CFrame.new(-2148, 70, -12165)
                        if (hrp.Position - sweetCrafter.Position).Magnitude > 20 then
                            topos(sweetCrafter)
                        else
                            CommF_:InvokeServer("SweetCrafter", "Craft")
                        end
                    end
                end
            end)
        end
        if g.FruitConfig.AutoRandom then
            pcall(function()
                CommF_:InvokeServer("Cousin", "Buy")
            end)
        end
        if g.FruitConfig.AutoStore then
            pcall(function()
                for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
                    if string.find(v.Name, "Fruit") then
                        local properName = g.FruitDictionary[v.Name] or v.Name
                        CommF_:InvokeServer("StoreFruit", properName, v)
                    end
                end
            end)
        end
        if g.MiscConfig.FPSBoost then
            pcall(function()
                for _,v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("BasePart") and not v.Parent:FindFirstChild("Humanoid") then
                        v.Material = Enum.Material.SmoothPlastic
                        v.Reflectance = 0
                    elseif v:IsA("Decal") or v:IsA("Texture") then
                        v:Destroy()
                    end
                end
                Lighting.GlobalShadows = false
            end)
        end
        if g.MiscConfig.RemoveFog then
            pcall(function()
                Lighting.FogEnd = 100000
                Lighting.Atmosphere.Density = 0
            end)
        end
        if g.MiscConfig.HideUI then
            pcall(function()
                LocalPlayer.PlayerGui.Main.Enabled = false
            end)
        else
            pcall(function()
                LocalPlayer.PlayerGui.Main.Enabled = true
            end)
        end
    end
