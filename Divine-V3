    local Fill = Instance.new("Frame")
    Fill.Name = "Fill"
    Fill.BackgroundColor3 = C.Green
    Fill.BorderSizePixel = 0
    Fill.Size = UDim2.new()
    Fill.ZIndex = 32
    Fill.Parent = Bar

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = Fill

    local Knob = Instance.new("Frame")
    Knob.Name = "Knob"
    Knob.Size = UDim2.fromOffset(12, 12)
    Knob.BackgroundColor3 = C.White
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 34
    Knob.Parent = Bar

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local Dragging = false

    local function SetValue(Value, Fire)
        Value = math.clamp(Value, Min, Max)
        local Percent = (Value - Min) / (Max - Min)

        Fill.Size = UDim2.new(Percent, 0, 1, 0)
        Knob.Position = UDim2.new(Percent, -6, 0.5, -6)
        Label.Text = Name .. " : " .. tostring(math.floor(Value))

        SavedSettings[SaveId] = Value
        SaveConfig()

        if Fire and Callback then
            Callback(Value)
        end
    end

    local function GetValue(Input)
        if Bar.AbsoluteSize.X <= 0 then return Default end
        local Percent = math.clamp((Input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        return Min + ((Max - Min) * Percent)
    end

    Bar.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            StartSliderSound()
            SetValue(GetValue(Input), true)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then return end
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            SetValue(GetValue(Input), true)
        end
    end)

    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            if Dragging then
                Dragging = false
                StopSliderSound()
            end
        end
    end)

    SetValue(Default, false)
    return Holder
end

