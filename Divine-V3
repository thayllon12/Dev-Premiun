        while IntroRotating and LoadingStrokeGrad and LoadingStrokeGrad.Parent do
            LoadingStrokeGrad.Rotation = (LoadingStrokeGrad.Rotation + 3) % 360
            task.wait(0.01)
        end
    end)

    -- Loop de piscar do cursor do terminal (piscada de 0.25s)
    local TerminalCursor = "_"
    local CursorActive = true
    task.spawn(function()
        while CursorActive do
            TerminalCursor = (TerminalCursor == "_") and " " or "_"
            task.wait(0.25)
        end
    end)

    -- O logo começa pequeno e surge suavemente no centro
    LoadingLogoBox.Size = UDim2.fromOffset(0, 0)
    LoadingIcon.Size = UDim2.fromOffset(0, 0)

    TweenService:Create(LoadingLogoBox, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(80, 80)
    }):Play()

    TweenService:Create(LoadingIcon, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(50, 50)
    }):Play()

    task.wait(0.8)

    -- [NOVO] - Efeito Typewriter com Som de Teclado & Cursor Piscante - Parte 1
    local FullTextPart1 = "Divine"
    for i = 1, #FullTextPart1 do
        PlayKeyboardSound()
        DivineText.Text = string.sub(FullTextPart1, 1, i) .. TerminalCursor
        task.wait(0.08)
    end

    -- Espera dramática de exatamente 0.5 segundos conforme solicitado!
    task.wait(0.5)

    -- [NOVO] - Efeito Typewriter com Som de Teclado & Cursor Piscante - Parte 2
    local FullTextPart2 = " " .. Config.Version
    for i = 1, #FullTextPart2 do
        PlayKeyboardSound()
        DivineText.Text = FullTextPart1 .. string.sub(FullTextPart2, 1, i) .. TerminalCursor
        task.wait(0.06)
    end

    -- Deixa o cursor piscar por mais um tempinho depois que tudo terminar de digitar
    task.wait(0.6)
    CursorActive = false
    DivineText.Text = FullTextPart1 .. FullTextPart2 -- Remove o cursor no final

    task.wait(0.2)

    -- FASE DE SAÍDA: O logo e o texto crescem gigantes ocupando a tela e somem
    IntroRotating = false

    local GrowBox = TweenService:Create(LoadingLogoBox, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Size = UDim2.fromScale(2.5, 2.5),
