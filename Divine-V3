--==================================================
local LastFrame = tick()
local FrameCounter = 0
local FPS = 0
local Accumulated = 0

RunService.RenderStepped:Connect(function(DeltaTime)
    -- Rotaciona o gradiente do contorno do menu principal
    if MainStrokeGradient then
        MainStrokeGradient.Rotation = (MainStrokeGradient.Rotation + Config.MainStrokeSpeed) % 360
    end

    -- Calcula e atualiza FPS/MS
    FrameCounter += 1
    Accumulated += DeltaTime

    if Accumulated >= 0.25 then
        FPS = math.floor(FrameCounter / Accumulated)
        FrameCounter = 0
        Accumulated = 0
        FPSLabel.Text = "FPS: " .. tostring(FPS)

        local Ping = 0
        pcall(function()
            local Stats = game:GetService("Stats")
            local Network = Stats.Network
            if Network then
                local ServerStatsItem = Network.ServerStatsItem
                if ServerStatsItem then
                    local DataPing = ServerStatsItem:FindFirstChild("Data Ping")
                    if DataPing then
                        Ping = DataPing:GetValue()
                    end
                end
            end
        end)

        if Ping > 0 then
            MSLabel.Text = "MS: " .. tostring(math.floor(Ping))
        else
            MSLabel.Text = "MS: --"
        end
    end
    LastFrame = tick()
end)

