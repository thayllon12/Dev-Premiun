    })

    TweenService:Create(LoadingIcon, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Size = UDim2.fromScale(2, 2),
        ImageTransparency = 1
    }):Play()

    -- O texto "Divine v3.1 True" cresce junto com o logo perfeitamente!
    TweenService:Create(DivineText, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
