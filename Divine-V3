-- Proteção de GUI integrada (Invisibilidade contra varreduras anti-cheat)
local function ProtectInterface(GuiInstance)
    local Success = pcall(function()
        if gethui then
            GuiInstance.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(GuiInstance)
            GuiInstance.Parent = CoreGui
        else
            GuiInstance.Parent = CoreGui
        end
    end)
    if not Success then
        pcall(function()
            GuiInstance.Parent = LocalPlayer:WaitForChild("PlayerGui")
        end)
    end
end

