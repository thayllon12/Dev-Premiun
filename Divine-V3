-- Sistema de salvamento dinâmico em arquivo JSON
local SavedSettings = {}
local FileName = "DivineHub_" .. game.GameId .. ".json"

-- Grava dados de configuração de forma segura
local function SaveConfig()
    local Success, Encoded = pcall(function()
        return HttpService:JSONEncode(SavedSettings)
    end)
    if Success and writefile then
        writefile(FileName, Encoded)
    end
end

-- Lê dados gravados em sessões anteriores do jogador
local function LoadConfig()
    if isfile and isfile(FileName) then
        local Success, Decoded = pcall(function()
            return HttpService:JSONDecode(readfile(FileName))
        end)
        if Success and type(Decoded) == "table" then
            SavedSettings = Decoded
        end
    end
end

