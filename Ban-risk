local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")

local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://124691327896440"
sound.Volume = 1000
sound.Parent = workspace
sound:Play()

sound.Ended:Connect(function()
	sound:Destroy()
end)

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "Loader"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1,1)
bg.BackgroundColor3 = Color3.fromRGB(18,18,18)
bg.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(0,400,0,50)
title.Position = UDim2.new(.5,-200,.3,0)
title.BackgroundTransparency = 1
title.Text = "Divine Hub"
title.TextScaled = true
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.Parent = bg

local status = Instance.new("TextLabel")
status.Size = UDim2.new(0,400,0,30)
status.Position = UDim2.new(.5,-200,.4,0)
status.BackgroundTransparency = 1
status.Text = "Loading..."
status.TextScaled = true
status.TextColor3 = Color3.fromRGB(180,180,180)
status.Font = Enum.Font.Gotham
status.Parent = bg

local bar = Instance.new("Frame")
bar.Size = UDim2.new(0,0,0,8)
bar.Position = UDim2.new(.5,-150,.48,0)
bar.BackgroundColor3 = Color3.fromRGB(0,170,255)
bar.BorderSizePixel = 0
bar.Parent = bg

for i = 1,100 do
	bar.Size = UDim2.new(0,i*3,0,8)
	task.wait(0.02)
end

status.Text = "Select Script"

local blox = Instance.new("TextButton")
blox.Size = UDim2.new(0,170,0,45)
blox.Position = UDim2.new(.5,-180,.6,0)
blox.Text = "Blox Fruits"
blox.Font = Enum.Font.GothamBold
blox.TextScaled = true
blox.Parent = bg

local uni = Instance.new("TextButton")
uni.Size = UDim2.new(0,170,0,45)
uni.Position = UDim2.new(.5,10,.6,0)
uni.Text = "Universal"
uni.Font = Enum.Font.GothamBold
uni.TextScaled = true
uni.Parent = bg

local function run()
	blox.Visible = false
	uni.Visible = false

	status.Text = "Loading Script..."
	task.wait(2)

	status.Text = "Injecting..."
	task.wait(2)

	status.Text = "Finalizing..."
	task.wait(1)

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://138118304933431"
	sound.Volume = 1000
	sound.Parent = SoundService
	sound:Play()

	task.wait(3)

	player:Kick([[
You have been permanently banned.

Reason:
Using exploits.

Duration:
999 Years
999 Months
999 Seconds

This action cannot be appealed.
]])
end

blox.MouseButton1Click:Connect(run)
uni.MouseButton1Click:Connect(run)
